-- legible-coder: an interactive CLI coding assistant for the Legible language
-- Default backend: NIM (NVIDIA_API_KEY), falls back to Gemini (GEMINI_API_KEY), OpenRouter (OPENROUTER_API_KEY), Groq (GROQ_API_KEY), then LM Studio
-- Override with LEGIBLE_CODER_MODEL and LEGIBLE_CODER_BASE_URL env vars
-- Default model: z-ai/glm-5.1 via NVIDIA NIM

-- ─── Tool schema helpers ──────────────────────────────────────────────────────

function make_param(pname: text, pdesc: text): a mapping from text to text
  intent: wrap pname and pdesc into a type and description mapping
  {"type": "string", "description": pdesc}
end

function make_tool(name: text, description: text, param_names: a list of text, param_descs: a list of text, required_params: a list of text): a mapping from text to text
  intent: put name, description, properties, and required into a function schema mapping
  mutable properties: a mapping from text to text = {}
  mutable i: integer = 0
  for pname in param_names do
    let pdesc: text = get(param_descs, i)
    set properties = put(properties, pname, make_param(pname, pdesc))
    set i = i + 1
  end
  {
    "type": "function",
    "function": {
      "name": name,
      "description": description,
      "parameters": {
        "type": "object",
        "properties": properties,
        "required": required_params
      }
    }
  }
end

function file_tools(include_dir_tools: boolean): a list of a mapping from text to text
  intent: build file read write schemas and optionally add directory listing tools
  let read_tool: a mapping from text to text = make_tool("read_file", "Read the contents of a file at the given path.", ["path"], ["The file path to read"], ["path"])
  let lines_tool: a mapping from text to text = make_tool("read_file_lines", "Read only part of a file using 1-based start_line and line_count.", ["path", "start_line", "line_count"], ["The file path to read", "The first 1-based line number to include", "The number of lines to include"], ["path", "start_line", "line_count"])
  let write_tool: a mapping from text to text = make_tool("write_file", "Write content to a file at the given path. Creates or overwrites.", ["path", "content"], ["The file path to write", "The content to write"], ["path", "content"])
  if include_dir_tools then
    let list_tool: a mapping from text to text = make_tool("list_dir", "List files and directories at a given path (one level only).", ["path"], ["The directory path to list"], ["path"])
    let recursive_tool: a mapping from text to text = make_tool("read_dir_recursive", "Recursively list all files under a directory. Use this instead of repeated list_dir calls to understand the project structure.", ["path"], ["The root directory to list recursively"], ["path"])
    [read_tool, lines_tool, write_tool, list_tool, recursive_tool]
  else
    [read_tool, lines_tool, write_tool]
  end
end

function search_tools(): a list of a mapping from text to text
  intent: build shell_exec and grep tool schemas
  let shell_tool: a mapping from text to text = make_tool("shell_exec", "Run a shell command and return stdout, stderr, and exit code.", ["command"], ["The shell command to execute"], ["command"])
  let grep_tool: a mapping from text to text = make_tool("grep", "Search for a pattern in files. Returns matching lines.", ["pattern", "path", "glob"], ["The regex pattern to search for", "Directory or file to search in", "Glob to filter files, e.g. *.lbl"], ["pattern"])
  [shell_tool, grep_tool]
end

function screenshot_tool(): a mapping from text to text
  intent: build the take_screenshot tool schema for visual evaluation of GUI output
  make_tool("take_screenshot", "Launch a GUI program and capture a screenshot for visual evaluation. Pass the program command in 'command' — it will be started in the background, the screen captured after 'delay' seconds, then the process killed. If the app exits before the delay elapses, the tool returns the captured stdout/stderr so you can diagnose the crash. Do NOT use shell_exec to launch GUI apps separately; use this tool instead so the capture happens while the window is open. Increase 'delay' (e.g. 5) if the window is slow to render.", ["command", "delay"], ["The shell command to launch the GUI app (will be run in background)", "Seconds to wait for the window to appear before capturing (default: 3)"], [])
end

function tool_definitions(include_dir_tools: boolean, include_vision: boolean): a list of a mapping from text to text
  intent: combine file, search, and optionally vision tools into one list
  let ft: a list of a mapping from text to text = file_tools(include_dir_tools)
  let st: a list of a mapping from text to text = search_tools()
  let combined: a list of a mapping from text to text = reduce(st, ft, fn(acc: a list of a mapping from text to text, t: a mapping from text to text): a list of a mapping from text to text => append(acc, t))
  if include_vision then append(combined, screenshot_tool()) else combined end
end

-- ─── Tool validation ──────────────────────────────────────────────────────────

-- Strip model special-token suffixes like "<|channel|>commentary" from a tool name
function clean_tool_name(name: text): text
  intent: strip everything from the first angle bracket onward in name
  let bracket: integer = unwrap_or(index_of(name, "<"), -1)
  if bracket > 0 then
    trim(substring(name, 0, bracket))
  else
    name
  end
end

function is_known_tool(name: text): boolean
  intent: compare the cleaned name to the supported tool names
  let n: text = clean_tool_name(name)
  n == "read_file" or n == "read_file_lines" or n == "write_file" or n == "shell_exec" or
  n == "list_dir" or n == "read_dir_recursive" or n == "grep" or n == "take_screenshot"
end

function is_local_known_tool(name: text): boolean
  intent: compare the cleaned name to the local manual-tool names that exclude full-file reads
  let n: text = clean_tool_name(name)
  n == "read_file_lines" or n == "write_file" or n == "shell_exec" or
  n == "list_dir" or n == "read_dir_recursive" or n == "grep" or n == "take_screenshot"
end

function describe_tool_call(name: text, arguments: text): text
  intent: format name with its path, command, or pattern argument as a short label
  let args: a mapping from text to text = json_parse(arguments)
  if name == "read_file" or name == "list_dir" or name == "read_dir_recursive" then
    name ++ "  " ++ unwrap_or(get(args, "path"), "")
  else if name == "read_file_lines" then
    name ++ "  " ++ unwrap_or(get(args, "path"), "") ++ ":" ++ unwrap_or(get(args, "start_line"), "") ++ "+" ++ unwrap_or(get(args, "line_count"), "")
  else if name == "write_file" then
    name ++ "  " ++ unwrap_or(get(args, "path"), "")
  else if name == "shell_exec" then
    let cmd: text = unwrap_or(get(args, "command"), "")
    let preview: text = if text_length(cmd) > 60 then substring(cmd, 0, 60) ++ "…" else cmd end
    name ++ "  $ " ++ preview
  else if name == "grep" then
    let pat: text = unwrap_or(get(args, "pattern"), "")
    let path: text = unwrap_or(get(args, "path"), ".")
    name ++ "  /" ++ pat ++ "/  " ++ path
  else if name == "take_screenshot" then
    name
  else
    name
  end
end

-- ─── Tool execution ───────────────────────────────────────────────────────────

function exec_write_file(args: a mapping from text to text): text
  intent: write content to path and print a diff if the file already existed
  let path: text = get(args, "path")
  let content: text = get(args, "content")
  if file_exists(path) then
    let old_content: text = read_file(path)
    write_file("/tmp/legible_coder_old", old_content)
    write_file(path, content)
    let diff_output: text = get(shell_exec("diff -u /tmp/legible_coder_old " ++ path ++ " 2>&1 | head -120"), "stdout")
    if text_length(diff_output) > 0 then
      print("")
      print(diff_output)
    end
  else
    write_file(path, content)
  end
  "File written successfully: " ++ path
end

function exec_shell(args: a mapping from text to text): text
  intent: run the command and return exit_code, stdout, and stderr as text
  let result: a mapping from text to text = shell_exec(get(args, "command"))
  let base: text = "exit_code: " ++ to_text(get(result, "exit_code"))
  let with_out: text = if text_length(get(result, "stdout")) > 0 then base ++ "\nstdout:\n" ++ get(result, "stdout") else base end
  if text_length(get(result, "stderr")) > 0 then with_out ++ "\nstderr:\n" ++ get(result, "stderr") else with_out end
end

function exec_grep(args: a mapping from text to text): text
  intent: run grep with pattern, path, and optional glob and return matching lines
  let pattern: text = get(args, "pattern")
  let path: text = unwrap_or(get(args, "path"), ".")
  let glob_pattern: text = unwrap_or(get(args, "glob"), "")
  let cmd: text = if text_length(glob_pattern) > 0 then
    "grep -rn --include='" ++ glob_pattern ++ "' '" ++ pattern ++ "' " ++ path ++ " 2>&1 | head -50"
  else
    "grep -rn '" ++ pattern ++ "' " ++ path ++ " 2>&1 | head -50"
  end
  let stdout: text = get(shell_exec(cmd), "stdout")
  if text_length(stdout) > 0 then stdout else "No matches found." end
end

function exec_read_file_lines(args: a mapping from text to text): text
  intent: read one file slice using a 1-based start line and line count
  let path: text = get(args, "path")
  if not file_exists(path) then
    "Error: file not found: " ++ path
  else
    let start_line: integer = max(to_integer(unwrap_or(get(args, "start_line"), "1")), 1)
    let line_count: integer = 40
    let lines: a list of text = split(read_file(path), "\n")
    let finish: integer = min(length(lines), start_line + line_count - 1)
    mutable out: a list of text = []
    mutable i: integer = start_line
    while i <= finish do
      set out = append(out, to_text(i) ++ ": " ++ unwrap_or(get(lines, i - 1), ""))
      set i = i + 1
    end
    if length(out) == 0 then "(no lines in requested range)" else join(out, "\n") end
  end
end

function screenshot_capture_cmd(path: text): text
  intent: shell chain that tries grim then X11 screenshot tools in order, overwriting prior files
  "(grim " ++ path ++ " 2>/dev/null || scrot -o " ++ path ++ " 2>/dev/null || import -window root " ++ path ++ " 2>/dev/null || gnome-screenshot -f " ++ path ++ " 2>/dev/null)"
end

function screenshot_launch_script(command: text, path: text, log_path: text, delay: text): text
  intent: launch GUI in background, verify it survived the delay, capture screen, then kill it
  "rm -f " ++ path ++ " " ++ log_path ++ "; " ++
  "(" ++ command ++ ") > " ++ log_path ++ " 2>&1 & APP_PID=$!; " ++
  "sleep " ++ delay ++ "; " ++
  "if kill -0 $APP_PID 2>/dev/null; then " ++ screenshot_capture_cmd(path) ++ "; " ++
  "kill $APP_PID 2>/dev/null; wait $APP_PID 2>/dev/null; " ++
  "else echo APP_EXITED_EARLY >&2; fi"
end

function screenshot_result(path: text, log_path: text, result: a mapping from text to text): text
  intent: classify screenshot outcome and return path or an error message including captured app log
  let stderr: text = unwrap_or(get(result, "stderr"), "")
  if contains_text(stderr, "APP_EXITED_EARLY") then
    let log: text = if file_exists(log_path) then read_file(log_path) else "(no log)" end
    "Error: GUI app exited before screenshot could be taken. App output:\n" ++ log
  else if file_exists(path) then
    path
  else
    "Error: screenshot failed (exit " ++ to_text(get(result, "exit_code")) ++ "). Install grim, scrot, imagemagick, or gnome-screenshot."
  end
end

function exec_take_screenshot(args: a mapping from text to text): text
  intent: launch optional GUI command in background then capture a screenshot and return the path
  let path: text = "/tmp/legible_coder_screenshot.png"
  let log_path: text = "/tmp/legible_coder_app.log"
  let delay: text = unwrap_or(get(args, "delay"), "3")
  let command: text = unwrap_or(get(args, "command"), "")
  let cmd: text = if text_length(command) > 0 then
    screenshot_launch_script(command, path, log_path, delay)
  else
    "rm -f " ++ path ++ "; sleep " ++ delay ++ " && " ++ screenshot_capture_cmd(path)
  end
  screenshot_result(path, log_path, shell_exec(cmd))
end

function build_vision_eval_message(screenshot_path: text): a mapping from text to text
  intent: read the screenshot as base64 and build a multimodal user message for visual evaluation
  let b64: text = trim(get(shell_exec("base64 -w 0 < " ++ screenshot_path), "stdout"))
  let data_url: text = "data:image/png;base64," ++ b64
  {
    "role": "user",
    "content": [
      {"type": "text", "text": "I ran the GUI code and took this screenshot. Evaluate: does it look correct visually? Note any layout issues, missing elements, or improvements needed."},
      {"type": "image_url", "image_url": {"url": data_url}}
    ]
  }
end

function execute_tool(name: text, arguments: text): text
  intent: parse arguments and dispatch to the supported tool implementations
  let args: a mapping from text to text = json_parse(arguments)
  if name == "read_file" then
    let path: text = get(args, "path")
    if file_exists(path) then read_file(path) else "Error: file not found: " ++ path end
  else if name == "read_file_lines" then
    exec_read_file_lines(args)
  else if name == "write_file" then
    exec_write_file(args)
  else if name == "shell_exec" then
    exec_shell(args)
  else if name == "list_dir" then
    let path: text = get(args, "path")
    if is_dir(path) then join(list_dir(path), "\n") else "Error: not a directory: " ++ path end
  else if name == "read_dir_recursive" then
    get(shell_exec("find " ++ get(args, "path") ++ " -type f | sort 2>&1 | head -200"), "stdout")
  else if name == "grep" then
    exec_grep(args)
  else if name == "take_screenshot" then
    exec_take_screenshot(args)
  else
    "Error: unknown tool: " ++ name
  end
end

-- ─── System prompt ────────────────────────────────────────────────────────────

function prompt_syntax_ref(): text
  intent: return the Legible syntax reference section covering bindings, types, functions, records, unions, control flow, and operators
  "════ LEGIBLE LANGUAGE REFERENCE ════\n\n" ++
  "BINDINGS:\n" ++
  "  let name: type = value          -- immutable\n" ++
  "  mutable name: type = value      -- mutable\n" ++
  "  set name = new_value            -- update a mutable binding\n\n" ++
  "TYPES:\n" ++
  "  integer  decimal  text  boolean  nothing\n" ++
  "  a list of T\n" ++
  "  a mapping from K to V\n" ++
  "  an optional T\n\n" ++
  "FUNCTIONS:\n" ++
  "  function name(param: type, param2: type): return_type\n" ++
  "    intent: what this function does\n" ++
  "    body\n" ++
  "  end\n\n" ++
  "RECORDS:\n" ++
  "  record Name\n" ++
  "    field: type\n" ++
  "  end\n" ++
  "  let x: Name = Name \{ field: value \}\n" ++
  "  let updated: Name = x with \{ field: new_value \}\n\n" ++
  "UNIONS:\n" ++
  "  union Shape\n" ++
  "    Circle \{ radius: decimal \}\n" ++
  "    Point\n" ++
  "  end\n" ++
  "  match s when Circle \{ radius \} then radius * 3.14 when Point then 0.0 end\n\n" ++
  "CONTROL FLOW:\n" ++
  "  if cond then ... else if cond then ... else ... end\n" ++
  "  for item in list do ... end\n" ++
  "  while cond do ... end\n\n" ++
  "OPERATORS:\n" ++
  "  ++ (text concat)   |> (pipeline)   and or not\n\n" ++
  "LAMBDAS:\n" ++
  "  fn(x: integer): boolean => x > 0\n\n" ++
  "MODULES:\n" ++
  "  use module_name           -- loads module_name.lbl\n" ++
  "  public function foo ...   -- export from a module\n" ++
  "  module_name.foo()         -- call an exported function\n\n"
end

function prompt_builtins(): text
  intent: return the built-ins list section
  "BUILT-INS:\n" ++
  "  print(v)  read_line()  to_text(v)  to_integer(v)  to_decimal(v)\n" ++
  "  length(list)  append(list, item)  filter(list, fn)  map(list, fn)  reduce(list, init, fn)\n" ++
  "  sort_by(list, fn)  find(list, fn)  take(list, n)  drop(list, n)  range(a, b)\n" ++
  "  split(text, delim)  join(list, sep)  trim(s)  replace(s, from, to)\n" ++
  "  substring(s, start, len)  text_length(s)  contains_text(s, sub)  index_of(s, sub)\n" ++
  "  uppercase(s)  lowercase(s)  starts_with(s, p)  ends_with(s, p)\n" ++
  "  keys(map)  values(map)  get(map, key)  put(map, key, val)  has_key(map, key)\n" ++
  "  unwrap(opt)  unwrap_or(opt, default)  is_some(opt)  is_none(opt)\n" ++
  "  abs(n)  max(a,b)  min(a,b)  floor(n)  ceil(n)  round(n)\n" ++
  "  random_int(max)  random_decimal()  skip()\n" ++
  "  read_file(path)  write_file(path, content)  file_exists(path)\n" ++
  "  shell_exec(cmd)  env_get(name)  get_cwd()  list_dir(path)  is_dir(path)\n" ++
  "  json_parse(text)  json_encode(value)  json_valid(text)\n" ++
  "  http_client_get(url, headers)  http_client_post(url, headers, body)\n" ++
  "  sdl_init(title,w,h)  sdl_clear(r,g,b)  sdl_fill_rect(x,y,w,h,r,g,b)  sdl_present()\n" ++
  "  sdl_draw_text(text,x,y,r,g,b)  sdl_load_font(path,size)  sdl_poll_events()\n" ++
  "  sdl_is_key_pressed(key)  sdl_delay(ms)  sdl_get_ticks()  sdl_quit()\n" ++
  "  sdl_screenshot(path)  -- saves canvas as PNG; call before sdl_quit for visual evaluation\n\n"
end

function prompt_example(): text
  intent: return a complete working Legible example program
  "COMPLETE EXAMPLE:\n" ++
  "  record Creature\n" ++
  "    name: text\n" ++
  "    hp: integer\n" ++
  "    level: integer\n" ++
  "  end\n\n" ++
  "  function describe(c: Creature): text\n" ++
  "    intent: format creature name, level, and hp as a status line\n" ++
  "    c.name ++ \" lv\" ++ to_text(c.level) ++ \" HP:\" ++ to_text(c.hp)\n" ++
  "  end\n\n" ++
  "  function level_up(c: Creature): Creature\n" ++
  "    intent: return c with level incremented and hp raised by ten\n" ++
  "    c with \{ level: c.level + 1, hp: c.hp + 10 \}\n" ++
  "  end\n\n" ++
  "  function main(): nothing\n" ++
  "    intent: create a creature, level it up, and print both states\n" ++
  "    let p: Creature = Creature \{ name: \"Flareon\", hp: 40, level: 1 \}\n" ++
  "    print(describe(p))\n" ++
  "    let p2: Creature = level_up(p)\n" ++
  "    print(describe(p2))\n" ++
  "  end\n\n" ++
  "Run programs with: legible run file.lbl\n\n"
end

function prompt_rules(): text
  intent: return the rules section listing common Legible mistakes to avoid
  "RULES:\n" ++
  "- Every function parameter needs a colon: fn(x: text) not fn(x text)\n" ++
  "- Every let/mutable binding needs a colon: let x: text = ... not let x text = ...\n" ++
  "- No semicolons, no curly braces for blocks — use end\n" ++
  "- Strings must be on one line; use ++ to concatenate across lines\n" ++
  "- In Legible source code, ALL arguments are positional — shell_exec(cmd) not shell_exec(command = cmd)\n" ++
  "- 'any' is NOT a valid type; use 'text' for unknown value types\n" ++
  "- shell_exec returns 'a mapping from text to text'; all values including exit_code are text\n" ++
  "- Use random_int(max) for random integers; do NOT use python or shell for RNG\n" ++
  "- No 'return' keyword; the last expression in a function body is returned\n" ++
  "- intent: values are unquoted plain text: intent: do something — NOT intent: \"do something\"\n" ++
  "- Dot access only works on records (record.field); for mappings use get(map, \"key\")\n" ++
  "- Types require the article: 'a list of T' and 'a mapping from K to V' — never 'list of T' or 'mapping from K to V'\n" ++
  "- No 'elseif' keyword — use 'else if' (two words)\n" ++
  "- No 'break' keyword — use a mutable boolean flag to exit loops\n" ++
  "- No array/list indexing with [] — use get(list, index) instead\n" ++
  "- Semicolons are not allowed anywhere, including inside intent descriptions\n" ++
  "- Comments use -- not #: write -- this is a comment, never # this is a comment\n" ++
  "- if-branches cannot be empty; use skip() as a no-op: if cond then skip() end\n" ++
  "- Avoid Unicode characters in code: use ASCII dash - not em-dash, straight quotes not curly quotes\n" ++
  "- Write code to files with write_file, then run with shell_exec\n" ++
  "- Keep responses concise; use tools to act rather than describing what you would do\n" ++
  "- Do NOT repeat the same tool call in one turn; if you already read a file or listed a directory, use what you have and answer\n" ++
  "- You have a limited tool budget per turn; gather what you need efficiently and then provide your answer"
end

function tool_names_text(include_tools: boolean, include_dir_tools: boolean, include_vision: boolean): text
  intent: return none or the available tool names based on include flags
  if not include_tools then
    "none"
  else if include_dir_tools and include_vision then
    "read_file, read_file_lines, write_file, shell_exec, list_dir, read_dir_recursive, grep, take_screenshot"
  else if include_dir_tools then
    "read_file, read_file_lines, write_file, shell_exec, list_dir, read_dir_recursive, grep"
  else if include_vision then
    "read_file, read_file_lines, write_file, shell_exec, grep, take_screenshot"
  else
    "read_file, read_file_lines, write_file, shell_exec, grep"
  end
end

function local_startup_instructions(): text
  intent: return the local startup workflow that uses the bootstrap as the starting project view
  "Startup workflow for every task:\n" ++
  "1. First read the LOCAL MODEL BOOTSTRAP already in context.\n" ++
  "2. Treat the bootstrap project tree as your starting view of the current working folder.\n" ++
  "3. Do not call list_dir on '.' unless the bootstrap is clearly insufficient.\n" ++
  "4. Then inspect only the files relevant to the current task.\n" ++
  "5. Always read files in 40-line intervals with read_file_lines to protect context.\n\n"
end

function local_examples(): text
  intent: return generic local tool examples without findings-file workflow
  "Examples:\n" ++
  "TOOL read_file_lines \{\"path\":\"main.lbl\",\"start_line\":\"1\",\"line_count\":\"40\"\}\n" ++
  "TOOL list_dir \{\"path\":\"../legible\"\}\n" ++
  "TOOL write_file \{\"path\":\"main.lbl\",\"content\":\"...updated content...\"\}\n" ++
  "TOOL shell_exec \{\"command\":\"legible check main.lbl\"\}\n" ++
  "TOOL grep \{\"pattern\":\"TODO\",\"path\":\".\",\"glob\":\"*.lbl\"\}\n\n"
end

function local_system_prompt(): text
  intent: return a compact local-model prompt with a manual TOOL protocol
  "You are legible-coder, a concise coding assistant for the Legible language.\n\n" ++
  "For this local-model session, native OpenAI tool calling is unavailable.\n" ++
  "If you need to use a tool, reply with exactly one line in this format:\n" ++
  "TOOL tool_name JSON_arguments\n" ++
  "Valid tools: read_file_lines, write_file, list_dir, read_dir_recursive, grep, shell_exec.\n" ++
  "After tool results are returned, either request one more tool the same way or reply with:\n" ++
  "FINAL: your answer\n\n" ++
  "Do not emit multiple TOOL lines in one response. Do not explain the tool choice before or after the TOOL line.\n" ++
  "Do not emit <tool_call>, <tool_response>, arguments:, or any XML-style wrappers.\n" ++
  local_startup_instructions() ++
  "The bootstrap already gives you the current project tree, so prefer using it instead of restarting with list_dir on '.'.\n" ++
  "Prefer list_dir or read_dir_recursive for directory exploration before using shell_exec.\n" ++
  "Do not use read_file in local mode. Always use read_file_lines with path, start_line, and line_count set to 40 unless you have a strong reason not to.\n" ++
  "If the user asks you to change code or files, do not stop at a description. Keep using tools until you write the file with write_file or you can clearly explain a blocker.\n" ++
  "If the user says 'continue', 'do that', or asks for a follow-up change, continue from the prior conversation state instead of restarting exploration unless you truly need new information.\n" ++
  local_examples() ++
  "Understand the task by reading the relevant files first. Do not guess file contents.\n" ++
  "Keep answers direct and avoid long chain-of-thought.\n\n" ++
  "Legible rules:\n" ++
  "- function params need colons: fn(x: text)\n" ++
  "- let/mutable bindings need colons\n" ++
  "- blocks end with end\n" ++
  "- no return keyword; last expression returns\n" ++
  "- mapping access uses get(map, \"key\")\n" ++
  "- list access uses get(list, index)\n" ++
  "- use else if, not elseif\n" ++
  "- comments use --\n" ++
  "- use ASCII in code\n"
end

function system_prompt(include_tools: boolean, include_dir_tools: boolean, include_vision: boolean): text
  intent: compose the header, syntax reference, builtins, example, and rules into the full system prompt
  let cwd: text = get_cwd()
  "You are legible-coder, an interactive CLI coding assistant. " ++
  "You write code in the Legible programming language and perform tasks by running Legible scripts.\n\n" ++
  "Current working directory: " ++ cwd ++ "\n\n" ++
  "TOOLS: " ++ tool_names_text(include_tools, include_dir_tools, include_vision) ++ ".\n" ++
  if not include_tools then "No runtime tools are available in this session. Rely on the preloaded workspace snapshot and answer in plain text.\n\n" else if include_dir_tools then "Use read_dir_recursive to understand project structure in ONE call instead of many list_dir calls.\nIMPORTANT: When the user asks you to take any action (run commands, check git status, read/write files, commit code, run tests), you MUST call a tool immediately. Do NOT describe what you would do, ask clarifying questions, or claim you cannot do something that a tool can accomplish. Use shell_exec for git and shell commands.\n\n" else "For local models, rely on the preloaded workspace snapshot before making tool calls.\n\n" end ++
  if include_vision then "VISUAL EVALUATION: For GUI tasks, use take_screenshot with the 'command' parameter set to the launch command (e.g. 'legible run gui.lbl'). The tool starts the app in the background, waits for 'delay' seconds (default 2), captures the screen, then kills the app. Do NOT run GUI programs via shell_exec — they block until closed, making a screenshot impossible.\n\n" else "" end ++
  prompt_syntax_ref() ++
  prompt_builtins() ++
  prompt_example() ++
  prompt_rules()
end

-- ─── API ──────────────────────────────────────────────────────────────────────

function extract_error_message(body: text): text
  intent: extract an API error message from a JSON body or fall back to the raw body text
  let trimmed: text = trim(body)
  if json_valid(body) and starts_with(trimmed, "\{") then
    let parsed: a mapping from text to text = json_parse(body)
    if has_key(parsed, "error") then
      to_text(get(parsed, "error"))
    else
      body
    end
  else
    body
  end
end

function local_model_context(): text
  intent: provide minimal local workspace orientation and the bootstrap project tree
  let project_tree: text = get(shell_exec("find . -maxdepth 2 -not -path './.git' -not -path './.git/*' | sort | head -80"), "stdout")
  "LOCAL MODEL BOOTSTRAP:\n" ++
  "Project tree:\n" ++ trim(project_tree) ++ "\n\n" ++
  "A neighboring repository named ../legible contains the interpreter implementation.\n" ++
  "Use this bootstrap as your initial view of the current working directory.\n" ++
  "Do not start with list_dir on '.' unless this bootstrap is missing something important.\n" ++
  "Read specific files with tools before proposing changes."
end

function build_request(model: text, messages: a list of a mapping from text to text, force_text: boolean, include_tools: boolean, include_dir_tools: boolean, max_output_tokens: integer, include_vision: boolean): a mapping from text to text
  intent: put model, messages, tools, tool_choice, and token limits into the chat completions request mapping
  let tc: text = if force_text or not include_tools then "none" else "auto" end
  let tools: a list of a mapping from text to text = if include_tools then tool_definitions(include_dir_tools, include_vision) else [] end
  {
    "model": model,
    "messages": messages,
    "tools": tools,
    "tool_choice": tc,
    "max_tokens": max_output_tokens,
    "stream": false
  }
end

function call_api(api_key: text, base_url: text, request_body: a mapping from text to text): a mapping from text to text
  intent: encode request_body as json and post it to base_url chat completions with auth headers
  let headers: a mapping from text to text = {
    "Authorization": "Bearer " ++ api_key,
    "Content-Type": "application/json"
  }
  http_client_post(base_url ++ "/chat/completions", headers, json_encode(request_body))
end

-- ─── Provider helpers ─────────────────────────────────────────────────────────

function gemini_base_url(): text
  intent: return the Google AI OpenAI-compatible base URL
  "https://generativelanguage.googleapis.com/v1beta/openai"
end

function openrouter_base_url(): text
  intent: return the OpenRouter OpenAI-compatible base URL
  "https://openrouter.ai/api/v1"
end

function nims_base_url(): text
  intent: return the NVIDIA NIM OpenAI-compatible base URL
  "https://integrate.api.nvidia.com/v1"
end

function is_gemini_url(url: text): boolean
  intent: return true when url points to the Google AI Gemini endpoint
  contains_text(url, "generativelanguage.googleapis.com")
end

function is_openrouter_url(url: text): boolean
  intent: return true when url points to the OpenRouter endpoint
  contains_text(url, "openrouter.ai")
end

function is_groq_url(url: text): boolean
  intent: return true when url points to the Groq cloud endpoint
  contains_text(url, "groq.com")
end

function is_nims_url(url: text): boolean
  intent: return true when url points to the NVIDIA NIM endpoint
  contains_text(url, "integrate.api.nvidia.com")
end

function backend_name(base_url: text): text
  intent: return a human-readable backend label for base_url
  if is_gemini_url(base_url) then "Gemini"
  else if is_nims_url(base_url) then "NIM"
  else if is_openrouter_url(base_url) then "OpenRouter"
  else if is_groq_url(base_url) then "Groq"
  else "LM Studio (" ++ base_url ++ ")"
  end
end

function provider_tier(base_url: text): text
  intent: return gemini nims openrouter groq or local based on the base URL for context-window tuning
  if is_gemini_url(base_url) then "gemini"
  else if is_nims_url(base_url) then "nims"
  else if is_openrouter_url(base_url) then "openrouter"
  else if is_groq_url(base_url) then "groq"
  else "local"
  end
end

-- ─── UI helpers ───────────────────────────────────────────────────────────────

function print_banner(model: text, base_url: text): nothing
  intent: print the legible-coder name, model, base_url, and cwd as the startup header
  let backend: text = backend_name(base_url)
  print("")
  print("  legible-coder")
  print("  Interactive Legible coding assistant")
  print("  Model: " ++ model ++ " via " ++ backend)
  print("  ────────────────────────────────────────────")
  let cwd: text = get_cwd()
  print("  cwd: " ++ cwd)
  print("  Type your request, or 'quit' to exit.")
  print("")
end

function print_separator(): nothing
  intent: emit a divider
  print("  ────────────────────────────────────────────")
end

-- ─── Tool call batch execution ────────────────────────────────────────────────

record BatchResult
  messages: a list of a mapping from text to text
  count: integer
  stop: boolean
end

record LoopStep
  messages: a list of a mapping from text to text
  count: integer
  last_batch: text
  waiting: boolean
  must_force_text: boolean
  explore_count: integer
  acted: boolean
end

record ManualToolRequest
  valid: boolean
  final: boolean
  name: text
  arguments: text
  final_text: text
end

function run_tool_batch(messages: a list of a mapping from text to text, valid_calls: a list of a mapping from text to text, tool_count: integer, max_tools: integer, include_vision: boolean): BatchResult
  intent: execute tool calls, inject vision evaluation message if screenshot was taken, return updated messages
  print("  batch: " ++ to_text(length(valid_calls)) ++ " calls")
  let asst_msg: a mapping from text to text = {"role": "assistant", "content": none, "tool_calls": valid_calls}
  mutable msgs: a list of a mapping from text to text = append(messages, asst_msg)
  mutable n: integer = tool_count
  mutable screenshot_path: text = ""
  for tc in valid_calls do
    let fn_info: a mapping from text to text = get(tc, "function")
    let tc_id: text = unwrap_or(get(tc, "id"), "")
    let fn_name: text = clean_tool_name(get(fn_info, "name"))
    let fn_args: text = get(fn_info, "arguments")
    set n = n + 1
    print("  [" ++ to_text(n) ++ "] " ++ describe_tool_call(fn_name, fn_args))
    let raw: text = execute_tool(fn_name, fn_args)
    if fn_name == "take_screenshot" and include_vision and file_exists(trim(raw)) then
      set screenshot_path = trim(raw)
    end
    let result: text = if text_length(raw) > 8000 then substring(raw, 0, 8000) ++ "\n... (truncated)" else raw end
    set msgs = append(msgs, {"role": "tool", "tool_call_id": tc_id, "content": result})
  end
  if include_vision and text_length(screenshot_path) > 0 then
    print("  [vision] attaching screenshot for model evaluation]")
    set msgs = append(msgs, build_vision_eval_message(screenshot_path))
  end
  let hit_cap: boolean = n >= max_tools
  if hit_cap then print("  [warn] reached " ++ to_text(max_tools) ++ " tool calls this turn, stopping") end
  BatchResult {messages: msgs, count: n, stop: hit_cap}
end

-- ─── Inner API loop ───────────────────────────────────────────────────────────

function filter_valid_calls(all_calls: a list of a mapping from text to text): a list of a mapping from text to text
  intent: keep only tool calls with known names and valid JSON object arguments
  filter(all_calls, fn(tc: a mapping from text to text): boolean => is_known_tool(get(get(tc, "function"), "name")) and json_valid(get(get(tc, "function"), "arguments")) and starts_with(trim(get(get(tc, "function"), "arguments")), "\{"))
end

function call_fingerprint(tc: a mapping from text to text): text
  intent: normalize a tool call into a stable text key using cleaned function name and raw arguments
  let fn_info: a mapping from text to text = get(tc, "function")
  clean_tool_name(get(fn_info, "name")) ++ "::" ++ trim(get(fn_info, "arguments"))
end

function dedupe_tool_calls(valid_calls: a list of a mapping from text to text): a list of a mapping from text to text
  intent: preserve only the first occurrence of each tool call fingerprint in a response
  mutable seen: a list of text = []
  mutable deduped: a list of a mapping from text to text = []
  for tc in valid_calls do
    let fingerprint: text = call_fingerprint(tc)
    if is_none(find(seen, fn(item: text): boolean => item == fingerprint)) then
      set seen = append(seen, fingerprint)
      set deduped = append(deduped, tc)
    end
  end
  deduped
end

function batch_fingerprint(valid_calls: a list of a mapping from text to text): text
  intent: join all call fingerprints into one batch fingerprint for repeat detection
  join(map(valid_calls, fn(tc: a mapping from text to text): text => call_fingerprint(tc)), "\n")
end

function manual_tool_fingerprint(name: text, arguments: text): text
  intent: join tool name and arguments into one fingerprint text
  name ++ "::" ++ trim(arguments)
end

function truncate_tool_output(raw: text, max_chars: integer): text
  intent: return raw tool output clipped to max_chars with a truncated marker
  if text_length(raw) > max_chars then
    substring(raw, 0, max_chars) ++ "\n... (truncated)"
  else
    raw
  end
end

function mask_old_tool_results(msgs: a list of a mapping from text to text, keep_recent: integer): a list of a mapping from text to text
  intent: replace tool message content with a short marker for older messages to reduce context tokens
  let total: integer = length(msgs)
  let mask_before: integer = max(total - keep_recent, 0)
  mutable result: a list of a mapping from text to text = []
  mutable i: integer = 0
  while i < total do
    let msg: a mapping from text to text = get(msgs, i)
    if i < mask_before and get(msg, "role") == "tool" then
      set result = append(result, put(msg, "content", "[tool result removed]"))
    else
      set result = append(result, msg)
    end
    set i = i + 1
  end
  result
end

function strip_old_vision_images(msgs: a list of a mapping from text to text, keep_recent: integer): a list of a mapping from text to text
  intent: replace base64 image data in old vision messages with a compact text marker to free context tokens
  let total: integer = length(msgs)
  let mask_before: integer = max(total - keep_recent, 0)
  mutable result: a list of a mapping from text to text = []
  mutable i: integer = 0
  while i < total do
    let msg: a mapping from text to text = get(msgs, i)
    let is_vision: boolean = get(msg, "role") == "user" and contains_text(msg_content_text(msg), "image_url")
    if i < mask_before and is_vision then
      set result = append(result, put(msg, "content", "[screenshot evaluated — image removed from context]"))
    else
      set result = append(result, msg)
    end
    set i = i + 1
  end
  result
end

function compact_summary_marker(): text
  intent: return compacted session summary marker
  "COMPACTED SESSION SUMMARY:"
end

function msg_content_text(msg: a mapping from text to text): text
  intent: safely extract msg content as text even when the content is a multimodal list
  to_text(unwrap_or(get(msg, "content"), ""))
end

function message_text(msg: a mapping from text to text): text
  intent: return content tool_calls text
  let content: text = msg_content_text(msg)
  let calls: text = if has_key(msg, "tool_calls") then to_text(get(msg, "tool_calls")) else "" end
  trim(content ++ "\n" ++ calls)
end

function estimate_message_tokens(msg: a mapping from text to text): integer
  intent: return max text_length message_text divided four
  max(text_length(message_text(msg)) / 4, 1)
end

function estimate_messages_tokens(msgs: a list of a mapping from text to text): integer
  intent: sum rough token estimates for every message in msgs
  mutable total: integer = 0
  for msg in msgs do
    set total = total + estimate_message_tokens(msg)
  end
  total
end

function is_compact_summary_message(msg: a mapping from text to text): boolean
  intent: return true when msg is a synthetic compacted context summary
  get(msg, "role") == "system" and starts_with(msg_content_text(msg), compact_summary_marker())
end

function leading_system_count(msgs: a list of a mapping from text to text): integer
  intent: count leading system role messages
  mutable i: integer = 0
  mutable scanning: boolean = true
  while i < length(msgs) and scanning do
    let msg: a mapping from text to text = get(msgs, i)
    if get(msg, "role") == "system" then
      set i = i + 1
    else
      set scanning = false
    end
  end
  i
end

function base_system_messages(msgs: a list of a mapping from text to text): a list of a mapping from text to text
  intent: append leading system role messages not compact summary
  mutable result: a list of a mapping from text to text = []
  mutable i: integer = 0
  mutable scanning: boolean = true
  while i < length(msgs) and scanning do
    let msg: a mapping from text to text = get(msgs, i)
    if get(msg, "role") == "system" then
      if not is_compact_summary_message(msg) then
        set result = append(result, msg)
      end
      set i = i + 1
    else
      set scanning = false
    end
  end
  result
end

function existing_compact_summary(msgs: a list of a mapping from text to text): text
  intent: return the existing compact summary text if present
  let found: an optional a mapping from text to text = find(msgs, fn(msg: a mapping from text to text): boolean => is_compact_summary_message(msg))
  if is_some(found) then
    unwrap_or(get(unwrap(found), "content"), "")
  else
    ""
  end
end

function one_line_snippet(text_value: text, max_chars: integer): text
  intent: replace newline tab trim substring text_value
  let cleaned: text = replace(replace(trim(text_value), "\n", " "), "\t", " ")
  if text_length(cleaned) > max_chars then
    substring(cleaned, 0, max_chars) ++ "..."
  else
    cleaned
  end
end

function summarize_message_for_context(msg: a mapping from text to text): text
  intent: format one chat message as a short role-prefixed summary line
  let role: text = unwrap_or(get(msg, "role"), "message")
  "- " ++ role ++ ": " ++ one_line_snippet(message_text(msg), 180)
end

function recent_user_request_summary(msgs: a list of a mapping from text to text): text
  intent: append user role snippets and drop older requests
  mutable requests: a list of text = []
  for msg in msgs do
    if get(msg, "role") == "user" then
      set requests = append(requests, "  - " ++ one_line_snippet(message_text(msg), 180))
      if length(requests) > 3 then
        set requests = drop(requests, 1)
      end
    end
  end
  if length(requests) > 0 then
    "- Recent user requests:\n" ++ join(requests, "\n") ++ "\n"
  else
    ""
  end
end

function recent_timeline_summary(msgs: a list of a mapping from text to text): text
  intent: summarize the last few compacted messages as a lightweight timeline
  let start: integer = max(length(msgs) - 8, 0)
  let recent: a list of a mapping from text to text = drop(msgs, start)
  let lines: a list of text = map(recent, fn(msg: a mapping from text to text): text => "  " ++ summarize_message_for_context(msg))
  if length(lines) > 0 then
    "- Recent compacted timeline:\n" ++ join(lines, "\n") ++ "\n"
  else
    ""
  end
end

function compact_transcript_summary(removed: a list of a mapping from text to text, prior_summary: text): text
  intent: build a synthetic summary for removed conversation messages while preserving actionable context
  let prior: text = if text_length(prior_summary) > 0 then "- Previously compacted context:\n  - " ++ one_line_snippet(prior_summary, 700) ++ "\n" else "" end
  compact_summary_marker() ++ "\n" ++
  "This synthetic message preserves older conversation context that was compacted to keep the model inside its context budget.\n" ++
  prior ++
  "- Scope: " ++ to_text(length(removed)) ++ " older messages compacted from the live transcript.\n" ++
  recent_user_request_summary(removed) ++
  recent_timeline_summary(removed) ++
  "Recent messages after this summary are preserved verbatim. Continue directly from the preserved context without asking the user to repeat it."
end

function safe_context_keep_from(msgs: a list of a mapping from text to text, raw_keep_from: integer, min_keep_from: integer): integer
  intent: decrement keep_from while first_preserved role is tool
  mutable keep_from: integer = max(raw_keep_from, min_keep_from)
  mutable scanning: boolean = true
  while keep_from > min_keep_from and scanning do
    let first_preserved: a mapping from text to text = get(msgs, keep_from)
    if get(first_preserved, "role") == "tool" then
      set keep_from = keep_from - 1
    else
      set scanning = false
    end
  end
  keep_from
end

function compact_context_if_needed(msgs: a list of a mapping from text to text, max_estimated_tokens: integer, preserve_recent_messages: integer): a list of a mapping from text to text
  intent: compact older transcript messages into one summary when estimated tokens exceed the configured budget
  let estimated: integer = estimate_messages_tokens(msgs)
  let prefix_count: integer = leading_system_count(msgs)
  if max_estimated_tokens <= 0 or estimated < max_estimated_tokens or length(msgs) <= prefix_count + preserve_recent_messages then
    msgs
  else
    let raw_keep_from: integer = max(length(msgs) - preserve_recent_messages, prefix_count)
    let keep_from: integer = safe_context_keep_from(msgs, raw_keep_from, prefix_count)
    if keep_from <= prefix_count then
      msgs
    else
      let removed: a list of a mapping from text to text = take(drop(msgs, prefix_count), keep_from - prefix_count)
      let preserved: a list of a mapping from text to text = drop(msgs, keep_from)
      let summary: text = compact_transcript_summary(removed, existing_compact_summary(msgs))
      let compact_msg: a mapping from text to text = {"role": "system", "content": summary}
      let with_summary: a list of a mapping from text to text = append(base_system_messages(msgs), compact_msg)
      reduce(preserved, with_summary, fn(acc: a list of a mapping from text to text, msg: a mapping from text to text): a list of a mapping from text to text => append(acc, msg))
    end
  end
end

function prune_local_messages(msgs: a list of a mapping from text to text): a list of a mapping from text to text
  intent: strip old vision images, mask old tool results, then compact context for local mode
  let keep: integer = resolve_context_keep_messages("local")
  let stripped: a list of a mapping from text to text = strip_old_vision_images(msgs, 2)
  let masked: a list of a mapping from text to text = mask_old_tool_results(stripped, keep * 2)
  compact_context_if_needed(masked, resolve_context_budget("local"), keep)
end

function seen_tool_for_path(msgs: a list of a mapping from text to text, tool_name: text, path: text): boolean
  intent: return true when prior local messages already contain a tool result line for tool_name and path
  is_some(find(msgs, fn(msg: a mapping from text to text): boolean => contains_text(msg_content_text(msg), "Tool result for " ++ tool_name) and contains_text(msg_content_text(msg), "\"path\":\"" ++ path ++ "\"")))
end

function seen_manual_tool_request(msgs: a list of a mapping from text to text, name: text, arguments: text): boolean
  intent: return true when prior local messages already contain the same tool name and exact arguments
  let marker: text = "Tool result for " ++ to_text(name) ++ " " ++ to_text(arguments) ++ ":"
  is_some(find(msgs, fn(msg: a mapping from text to text): boolean => contains_text(msg_content_text(msg), marker)))
end

function json_escape_text(content: text): text
  intent: let slashed be replace content backslash then replace slashed double quote for JSON text
  let slashed: text = replace(content, "\\", "\\\\")
  replace(slashed, "\"", "\\\"")
end

function trim_manual_tool_blob(blob: text): text
  intent: trim tool blob text before any angle bracket marker or pipe marker
  let lt: integer = unwrap_or(index_of(blob, "<"), -1)
  let pipe: integer = unwrap_or(index_of(blob, "|"), -1)
  if lt >= 0 and pipe >= 0 then
    trim(substring(blob, 0, min(lt, pipe)))
  else if lt >= 0 then
    trim(substring(blob, 0, lt))
  else if pipe >= 0 then
    trim(substring(blob, 0, pipe))
  else
    trim(blob)
  end
end

function recover_single_quoted_argument(raw_args: text, key: text): text
  intent: find key colon single-quoted text and return one JSON object for that key
  let marker: text = key ++ ":"
  let start: integer = unwrap_or(index_of(raw_args, marker), -1)
  if start >= 0 then
    let after: text = trim(substring(raw_args, start + text_length(marker), text_length(raw_args) - start - text_length(marker)))
    let first_quote: integer = unwrap_or(index_of(after, "'"), -1)
    if first_quote >= 0 then
      let tail: text = substring(after, first_quote + 1, text_length(after) - first_quote - 1)
      let second_quote: integer = unwrap_or(index_of(tail, "'"), -1)
      if second_quote >= 0 then
        "\{\"" ++ key ++ "\":\"" ++ json_escape_text(substring(tail, 0, second_quote)) ++ "\"\}"
      else
        raw_args
      end
    else
      raw_args
    end
  else
    raw_args
  end
end

function normalize_manual_arguments(name: text, raw_args: text): text
  intent: normalize malformed local tool arguments into JSON when possible
  let cleaned: text = trim_manual_tool_blob(trim(raw_args))
  if json_valid(cleaned) and starts_with(cleaned, "\{") then
    cleaned
  else if name == "shell_exec" then
    recover_single_quoted_argument(cleaned, "arguments")
    |> fn(result: text): text => if json_valid(result) then result else recover_single_quoted_argument(cleaned, "command") end
  else if name == "read_file" or name == "list_dir" or name == "read_dir_recursive" then
    recover_single_quoted_argument(cleaned, "path")
  else
    cleaned
  end
end

function normalize_read_file_lines_arguments(arguments: text): text
  intent: normalize read_file_lines to a 1-based start line and a fixed 40-line window
  let args: a mapping from text to text = json_parse(arguments)
  let path: text = unwrap_or(get(args, "path"), "")
  let start_line: integer = max(to_integer(unwrap_or(get(args, "start_line"), "1")), 1)
  json_encode({
    "path": path,
    "start_line": to_text(start_line),
    "line_count": "40"
  })
end

function parse_manual_tool_request(content: text): ManualToolRequest
  intent: parse local-model TOOL and FINAL responses from plain text content
  let trimmed: text = trim(content)
  let lines: a list of text = split(trimmed, "\n")
  let tool_line: an optional text = find(lines, fn(line: text): boolean => starts_with(trim(line), "TOOL "))
  let final_line: an optional text = find(lines, fn(line: text): boolean => starts_with(trim(line), "FINAL:"))
  if is_some(tool_line) then
    let line: text = trim(unwrap(tool_line))
    let rest: text = trim_manual_tool_blob(trim(substring(line, 5, text_length(line) - 5)))
    let brace: integer = unwrap_or(index_of(rest, "\{"), -1)
    let space: integer = unwrap_or(index_of(rest, " "), -1)
    if brace > 0 then
      let name: text = trim(substring(rest, 0, brace))
      let normalized: text = normalize_manual_arguments(clean_tool_name(name), substring(rest, brace, text_length(rest) - brace))
      let arguments: text = if clean_tool_name(name) == "read_file_lines" and json_valid(normalized) then normalize_read_file_lines_arguments(normalized) else normalized end
      let valid: boolean = is_local_known_tool(name) and json_valid(arguments) and starts_with(arguments, "\{")
      ManualToolRequest {valid: valid, final: false, name: clean_tool_name(name), arguments: arguments, final_text: ""}
    else if space > 0 then
      let name: text = trim(substring(rest, 0, space))
      let normalized: text = normalize_manual_arguments(clean_tool_name(name), substring(rest, space + 1, text_length(rest) - space - 1))
      let arguments: text = if clean_tool_name(name) == "read_file_lines" and json_valid(normalized) then normalize_read_file_lines_arguments(normalized) else normalized end
      let valid: boolean = is_local_known_tool(name) and json_valid(arguments) and starts_with(arguments, "\{")
      ManualToolRequest {valid: valid, final: false, name: clean_tool_name(name), arguments: arguments, final_text: ""}
    else
      ManualToolRequest {valid: false, final: false, name: "", arguments: "", final_text: trimmed}
    end
  else if is_some(final_line) then
    let line: text = trim(unwrap(final_line))
    ManualToolRequest {valid: false, final: true, name: "", arguments: "", final_text: trim(substring(line, 6, text_length(line) - 6))}
  else
    ManualToolRequest {valid: false, final: false, name: "", arguments: "", final_text: trimmed}
  end
end

function local_manual_retry(msgs: a list of a mapping from text to text, content: text, total_tools: integer, last_batch: text, explore_count: integer, acted: boolean): LoopStep
  intent: append assistant content and a strict-format reminder when the local model ignores the protocol
  print("  [warn] local model returned a malformed TOOL/FINAL response; retrying with format reminder]")
  if length(msgs) > 5 then print("  [context] pruning local retry history]") end
  let disallow_full_read: text = if contains_text(content, "TOOL read_file ") then "\nDo not use read_file in local mode. Use read_file_lines with path, start_line, and line_count." else "" end
  if local_needs_action(explore_count, acted) then
    local_action_retry_step(msgs, total_tools, last_batch, explore_count, acted)
  else
    LoopStep {
      messages: prune_local_messages(append(msgs, {"role": "user", "content": "Your last reply did not follow the required format. Reply in exactly one of these formats only:\nTOOL tool_name JSON_arguments\nFINAL: your answer\nValid local tools: read_file_lines, write_file, list_dir, read_dir_recursive, grep, shell_exec." ++ disallow_full_read})),
      count: total_tools,
      last_batch: last_batch,
      waiting: true,
      must_force_text: false,
      explore_count: explore_count,
      acted: acted
    }
  end
end

function local_manual_final(msgs: a list of a mapping from text to text, final_text: text, total_tools: integer, last_batch: text, explore_count: integer, acted: boolean): LoopStep
  intent: finish the local manual-tool loop by printing the final text answer
  if local_needs_action(explore_count, acted) then
    print("  [warn] local model stopped before acting; requiring write_file, shell_exec, or blocker]")
    local_action_retry_step(msgs, total_tools, last_batch, explore_count, acted)
  else
    let final_msg: a mapping from text to text = {"content": final_text}
    LoopStep {
      messages: handle_text_response(final_msg, msgs),
      count: total_tools,
      last_batch: last_batch,
      waiting: false,
      must_force_text: false,
      explore_count: explore_count,
      acted: acted
    }
  end
end

function local_repeat_hint(req: ManualToolRequest, has_partial_read: boolean): text
  intent: build the retry hint text for repeated read_file_lines grep or other tool requests
  if req.name == "read_file" then
    if has_partial_read then
      "You already read that file and also fetched line ranges from it. Do not repeat read_file. Continue with FINAL: your answer, or request a new non-overlapping read_file_lines range."
    else
      "You already read that whole file. Do not repeat read_file. If you need more detail, use read_file_lines with path, start_line, and line_count instead, for example TOOL read_file_lines " ++ to_text(req.arguments) ++ " plus a start_line and line_count."
    end
  else if req.name == "read_file_lines" then
    "You already requested that exact file range and received it. Do not repeat the same range. Either request a different non-overlapping read_file_lines range or reply with FINAL: your answer."
  else if req.name == "grep" then
    "You already ran that exact grep and received its result. Do not repeat it. Read a relevant file slice or reply with FINAL: your answer."
  else
    "You already requested that tool and received its result. Do not repeat it. Reply with FINAL: and your answer."
  end
end

function bootstrap_listing_hint(): text
  intent: tell the local model to use the bootstrap project tree instead of list_dir on dot
  "The LOCAL MODEL BOOTSTRAP already includes the current project tree. Do not call list_dir on '.'. Use the bootstrap, inspect a relevant file directly, or use list_dir/read_dir_recursive on a more specific path."
end

function is_bootstrap_listing(req: ManualToolRequest): boolean
  intent: return true when req is list_dir on the current working directory
  req.name == "list_dir" and unwrap_or(get(json_parse(req.arguments), "path"), "") == "."
end

function skip_bootstrap_listing_step(msgs: a list of a mapping from text to text, total_tools: integer, fingerprint: text, explore_count: integer, acted: boolean): LoopStep
  intent: skip redundant list_dir on dot because the bootstrap already includes the project tree
  print("  [warn] bootstrap already covers '.', skipping list_dir]")
  LoopStep {
    messages: append(msgs, {"role": "user", "content": bootstrap_listing_hint()}),
    count: total_tools,
    last_batch: fingerprint,
    waiting: true,
    must_force_text: false,
    explore_count: explore_count,
    acted: acted
  }
end

function advance_read_file_lines_request(req: ManualToolRequest): ManualToolRequest
  intent: increment read_file_lines start_line by 40 and keep the same path
  let args: a mapping from text to text = json_parse(req.arguments)
  let next_start: integer = max(to_integer(unwrap_or(get(args, "start_line"), "1")), 1) + 40
  let next_args: text = json_encode({
    "path": unwrap_or(get(args, "path"), ""),
    "start_line": to_text(next_start),
    "line_count": "40"
  })
  ManualToolRequest {
    valid: true,
    final: false,
    name: req.name,
    arguments: next_args,
    final_text: req.final_text
  }
end

function is_exploration_tool(name: text): boolean
  intent: return true for read_file_lines list_dir read_dir_recursive or grep
  name == "read_file_lines" or name == "list_dir" or name == "read_dir_recursive" or name == "grep"
end

function is_action_tool(name: text): boolean
  intent: return true for write_file or shell_exec
  name == "write_file" or name == "shell_exec"
end

function shell_command_text(req: ManualToolRequest): text
  intent: return the lowercase trimmed shell_exec command text or empty text for other tools
  if req.name == "shell_exec" then
    lowercase(trim(unwrap_or(get(json_parse(req.arguments), "command"), "")))
  else
    ""
  end
end

function is_exploration_shell_command(command: text): boolean
  intent: return true for shell commands starting with cat ls find grep rg sed head tail tree wc awk or fd
  starts_with(command, "cat ") or starts_with(command, "ls") or starts_with(command, "find ") or starts_with(command, "grep ") or starts_with(command, "rg ") or starts_with(command, "sed ") or starts_with(command, "head ") or starts_with(command, "tail ") or starts_with(command, "tree") or starts_with(command, "wc ") or starts_with(command, "awk ") or starts_with(command, "fd ")
end

function is_exploration_request(req: ManualToolRequest): boolean
  intent: return true for exploration tools and shell_exec commands that inspect files or text
  is_exploration_tool(req.name) or (req.name == "shell_exec" and is_exploration_shell_command(shell_command_text(req)))
end

function is_action_request(req: ManualToolRequest): boolean
  intent: return true for write_file and for shell_exec commands that run check build run or test work
  req.name == "write_file" or (req.name == "shell_exec" and not is_exploration_shell_command(shell_command_text(req)))
end

function resolve_local_explore_budget(): integer
  intent: read LEGIBLE_CODER_MAX_EXPLORE or use default 8 for the local exploration budget
  let raw: text = unwrap_or(env_get("LEGIBLE_CODER_MAX_EXPLORE"), "8")
  max(to_integer(raw), 1)
end

function local_needs_action(explore_count: integer, acted: boolean): boolean
  intent: return true when explore_count reached resolve_local_explore_budget and acted is false
  not acted and explore_count >= resolve_local_explore_budget()
end

function local_action_prompt(): text
  intent: return the exact write_file shell_exec or FINAL blocked prompt for local action mode
  "Exploration budget reached. Do not continue with read_file_lines, list_dir, read_dir_recursive, or grep.\n" ++
  "Assume the current context is enough for a first implementation attempt.\n" ++
  "Your next reply is invalid unless it is exactly one of these formats:\n" ++
  "TOOL write_file JSON_arguments\n" ++
  "TOOL shell_exec JSON_arguments  -- only for checking, building, running, or testing code\n" ++
  "FINAL: blocked because you need one specific missing file path or 40-line range\n" ++
  "Do not use shell_exec to read files or list directories.\n" ++
  "Commands like cat, ls, find, grep, rg, sed, head, or tail are invalid here.\n" ++
  "Do not answer with prose, plans, or more exploratory tools."
end

function local_action_retry_step(msgs: a list of a mapping from text to text, total_tools: integer, last_batch: text, explore_count: integer, acted: boolean): LoopStep
  intent: continue the local loop while requiring an action or blocker after too much exploration
  print("  [warn] local exploration budget reached; requiring write_file, shell_exec, or blocker]")
  LoopStep {
    messages: prune_local_messages(append(msgs, {"role": "user", "content": local_action_prompt()})),
    count: total_tools,
    last_batch: last_batch,
    waiting: true,
    must_force_text: false,
    explore_count: explore_count,
    acted: acted
  }
end

function execute_local_manual_tool(msgs: a list of a mapping from text to text, req: ManualToolRequest, advanced_range: boolean, total_tools: integer, max_tools: integer, fingerprint: text, explore_count: integer, acted: boolean): LoopStep
  intent: execute one local tool request and update exploration and action state
  let next_count: integer = total_tools + 1
  let next_explore_count: integer = if is_exploration_request(req) then explore_count + 1 else explore_count end
  let next_acted: boolean = acted or is_action_request(req)
  if advanced_range then print("  [warn] advancing repeated read_file_lines request to the next 40-line window]") end
  print("  [" ++ to_text(next_count) ++ "] " ++ describe_tool_call(req.name, req.arguments))
  let raw: text = execute_tool(req.name, req.arguments)
  let result: text = truncate_tool_output(to_text(raw), 2000)
  if length(msgs) > 5 then print("  [context] pruning local tool history]") end
  let next_msgs: a list of a mapping from text to text = prune_local_messages(append(msgs, {"role": "user", "content": "Tool result for " ++ to_text(req.name) ++ " " ++ to_text(req.arguments) ++ ":\n" ++ to_text(result) ++ "\n\nReply with one TOOL line if you need one more tool, or FINAL: followed by your answer."}))
  if next_count >= max_tools then print("  [warn] reached " ++ to_text(max_tools) ++ " local tool calls this turn, stopping]") end
  LoopStep {
    messages: next_msgs,
    count: next_count,
    last_batch: fingerprint,
    waiting: next_count < max_tools,
    must_force_text: false,
    explore_count: next_explore_count,
    acted: next_acted
  }
end

function local_manual_tool_step(msgs: a list of a mapping from text to text, content: text, req: ManualToolRequest, total_tools: integer, max_tools: integer, last_batch: text, explore_count: integer, acted: boolean): LoopStep
  intent: execute one manual tool request or reject an immediate repeat
  let adjusted_req: ManualToolRequest = if req.name == "read_file_lines" and seen_manual_tool_request(msgs, req.name, req.arguments) then advance_read_file_lines_request(req) else req end
  let fingerprint: text = manual_tool_fingerprint(adjusted_req.name, adjusted_req.arguments)
  let req_path: text = if adjusted_req.name == "read_file" or adjusted_req.name == "read_file_lines" then unwrap_or(get(json_parse(adjusted_req.arguments), "path"), "") else "" end
  let repeated_full_read: boolean = adjusted_req.name == "read_file" and text_length(req_path) > 0 and seen_tool_for_path(msgs, "read_file", req_path)
  let has_partial_read: boolean = adjusted_req.name == "read_file" and text_length(req_path) > 0 and seen_tool_for_path(msgs, "read_file_lines", req_path)
  let repeated_request: boolean = adjusted_req.name != "read_file_lines" and seen_manual_tool_request(msgs, adjusted_req.name, adjusted_req.arguments)
  if is_bootstrap_listing(adjusted_req) then
    skip_bootstrap_listing_step(msgs, total_tools, fingerprint, explore_count, acted)
  else if is_exploration_request(adjusted_req) and local_needs_action(explore_count, acted) then
    local_action_retry_step(msgs, total_tools, last_batch, explore_count, acted)
  else if fingerprint == last_batch or repeated_full_read or repeated_request then
    print("  [warn] model repeated the same manual tool request; forcing final answer]")
    let repeat_hint: text = local_repeat_hint(adjusted_req, has_partial_read)
    LoopStep {
      messages: append(msgs, {"role": "user", "content": repeat_hint}),
      count: total_tools,
      last_batch: last_batch,
      waiting: true,
      must_force_text: false,
      explore_count: explore_count,
      acted: acted
    }
  else
    execute_local_manual_tool(msgs, adjusted_req, adjusted_req.arguments != req.arguments, total_tools, max_tools, fingerprint, explore_count, acted)
  end
end

function handle_local_text_round(msg: a mapping from text to text, msgs: a list of a mapping from text to text, total_tools: integer, max_tools: integer, last_batch: text, explore_count: integer, acted: boolean): LoopStep
  intent: process one local-model text response and optionally execute one manual tool request
  let content: text = unwrap_or(get(msg, "content"), "")
  let req: ManualToolRequest = parse_manual_tool_request(content)
  if req.valid then
    local_manual_tool_step(msgs, content, req, total_tools, max_tools, last_batch, explore_count, acted)
  else if req.final then
    local_manual_final(msgs, req.final_text, total_tools, last_batch, explore_count, acted)
  else
    local_manual_retry(msgs, content, total_tools, last_batch, explore_count, acted)
  end
end

function prompt_loop_step(msgs: a list of a mapping from text to text, total_tools: integer, last_batch: text, prompt: text, must_force_text: boolean, explore_count: integer, acted: boolean): LoopStep
  intent: append a user follow-up prompt and continue the loop with updated forcing state
  LoopStep {
    messages: append(msgs, {"role": "user", "content": prompt}),
    count: total_tools,
    last_batch: last_batch,
    waiting: true,
    must_force_text: must_force_text,
    explore_count: explore_count,
    acted: acted
  }
end

function handle_tool_round(msg: a mapping from text to text, msgs: a list of a mapping from text to text, total_tools: integer, max_tools: integer, last_batch: text, round: integer, force_text: boolean, explore_count: integer, acted: boolean, include_vision: boolean): LoopStep
  intent: process one tool-calling response and decide whether the loop should continue
  if force_text then
    print("  [round " ++ to_text(round) ++ " - forcing text response]")
    prompt_loop_step(msgs, total_tools, last_batch, "STOP calling tools. Provide your answer as plain text NOW.", false, explore_count, acted)
  else
    let valid_calls: a list of a mapping from text to text = dedupe_tool_calls(filter_valid_calls(unwrap_or(get(msg, "tool_calls"), [])))
    let current_batch: text = batch_fingerprint(valid_calls)
    if length(valid_calls) > 0 and current_batch != last_batch then
      let batch: BatchResult = run_tool_batch(msgs, valid_calls, total_tools, max_tools, include_vision)
      LoopStep {
        messages: batch.messages,
        count: batch.count,
        last_batch: current_batch,
        waiting: not batch.stop,
        must_force_text: false,
        explore_count: explore_count,
        acted: acted
      }
    else if length(valid_calls) > 0 then
      print("  [warn] model repeated the same tool batch; forcing text response]")
      prompt_loop_step(msgs, total_tools, last_batch, "You already called those tools and have their results. Do not call them again. Answer using the existing tool outputs.", true, explore_count, acted)
    else
      print("  [warn] model returned invalid tool calls; forcing text response]")
      prompt_loop_step(msgs, total_tools, last_batch, "Your previous tool call was invalid. Do not call tools again. Answer in plain text or fix the tool call format.", true, explore_count, acted)
    end
  end
end

function handle_length_finish(msg: a mapping from text to text, msgs: a list of a mapping from text to text, total_tools: integer, last_batch: text, explore_count: integer, acted: boolean): LoopStep
  intent: handle a length-truncated response by preserving partial content and requesting continuation
  let content: text = unwrap_or(get(msg, "content"), "")
  print("  [warn] response truncated by token limit (finish_reason=length)]")
  if text_length(content) > 0 then
    let with_partial: a list of a mapping from text to text = append(msgs, {"role": "assistant", "content": content})
    LoopStep {
      messages: append(with_partial, {"role": "user", "content": "Your response was cut off. Please continue from exactly where you stopped."}),
      count: total_tools,
      last_batch: last_batch,
      waiting: true,
      must_force_text: false,
      explore_count: explore_count,
      acted: acted
    }
  else
    LoopStep {
      messages: append(msgs, {"role": "user", "content": "Context is full. Please answer concisely in plain text without calling any tools."}),
      count: total_tools,
      last_batch: last_batch,
      waiting: true,
      must_force_text: true,
      explore_count: explore_count,
      acted: acted
    }
  end
end

function handle_text_response(msg: a mapping from text to text, msgs: a list of a mapping from text to text): a list of a mapping from text to text
  intent: print content between separators and append it to msgs as an assistant message
  let content: text = unwrap_or(get(msg, "content"), "")
  if text_length(content) > 0 then
    print("")
    print_separator()
    print(content)
    print_separator()
    print("")
    append(msgs, {"role": "assistant", "content": content})
  else
    msgs
  end
end

function handle_success_response(resp_body: text, include_tools: boolean, msgs: a list of a mapping from text to text, total_tools: integer, max_tools: integer, last_batch: text, round: integer, force_text: boolean, explore_count: integer, acted: boolean, include_vision: boolean): LoopStep
  intent: process a successful API response and return the next loop state
  let no_choices_step: LoopStep = LoopStep {
    messages: msgs,
    count: total_tools,
    last_batch: last_batch,
    waiting: false,
    must_force_text: false,
    explore_count: explore_count,
    acted: acted
  }
  if not json_valid(resp_body) or not starts_with(trim(resp_body), "\{") then
    print("  API error: non-JSON response body")
    no_choices_step
  else
    let parsed: a mapping from text to text = json_parse(resp_body)
    if not has_key(parsed, "choices") or length(get(parsed, "choices")) == 0 then
      print("  API error: no choices in response: " ++ extract_error_message(resp_body))
      no_choices_step
    else
      let choice: a mapping from text to text = get(get(parsed, "choices"), 0)
      let msg: a mapping from text to text = get(choice, "message")
      let finish: text = unwrap_or(get(choice, "finish_reason"), "stop")
      if not include_tools then
        handle_local_text_round(msg, msgs, total_tools, max_tools, last_batch, explore_count, acted)
      else if finish == "length" then
        handle_length_finish(msg, msgs, total_tools, last_batch, explore_count, acted)
      else if finish == "tool_calls" or length(unwrap_or(get(msg, "tool_calls"), [])) > 0 then
        handle_tool_round(msg, msgs, total_tools, max_tools, last_batch, round, force_text, explore_count, acted, include_vision)
      else
        LoopStep {
          messages: handle_text_response(msg, msgs),
          count: total_tools,
          last_batch: last_batch,
          waiting: false,
          must_force_text: false,
          explore_count: explore_count,
          acted: acted
        }
      end
    end
  end
end

function compact_loop_messages(msgs: a list of a mapping from text to text, context_budget: integer, preserve_recent_messages: integer): a list of a mapping from text to text
  intent: mask old tool results, strip old vision images, then compact when tokens exceed the context budget
  let tokens_before: integer = estimate_messages_tokens(msgs)
  let stripped: a list of a mapping from text to text = strip_old_vision_images(msgs, 2)
  let masked: a list of a mapping from text to text = mask_old_tool_results(stripped, preserve_recent_messages * 2)
  let compacted: a list of a mapping from text to text = compact_context_if_needed(masked, context_budget, preserve_recent_messages)
  let tokens_after: integer = estimate_messages_tokens(compacted)
  if tokens_after < tokens_before then
    print("  [context] compacted transcript " ++ to_text(tokens_before) ++ " -> " ++ to_text(tokens_after) ++ " estimated tokens")
  end
  compacted
end

function run_inner_loop(init_messages: a list of a mapping from text to text, messages_start: integer, key: text, base_url: text, model: text, max_tools: integer, include_tools: boolean, include_dir_tools: boolean, max_output_tokens: integer, context_budget: integer, preserve_recent_messages: integer, include_vision: boolean): a list of a mapping from text to text
  intent: call the API in a loop executing tool calls until text response or round limit
  mutable msgs: a list of a mapping from text to text = init_messages
  mutable waiting: boolean = true
  mutable round: integer = 0
  mutable total_tools: integer = 0
  mutable last_batch: text = ""
  mutable must_force_text: boolean = false
  mutable explore_count: integer = 0
  mutable acted: boolean = false
  let round_cap: integer = if include_tools then max_tools else 999999 end
  while waiting do
    set round = round + 1
    let force_text: boolean = if include_tools then must_force_text or round > max_tools / 2 else false end
    set must_force_text = false
    set msgs = compact_loop_messages(msgs, context_budget, preserve_recent_messages)
    let resp: a mapping from text to text = call_api(key, base_url, build_request(model, msgs, force_text, include_tools, include_dir_tools, max_output_tokens, include_vision))
    let status: text = get(resp, "status")
    print("  [" ++ to_text(round) ++ "] status=" ++ status)
    if status != "200" then
      print("  API error: " ++ extract_error_message(get(resp, "body")))
      set msgs = take(msgs, messages_start)
      set waiting = false
    else
      let step: LoopStep = handle_success_response(get(resp, "body"), include_tools, msgs, total_tools, max_tools, last_batch, round, force_text, explore_count, acted, include_vision)
      set msgs = step.messages
      set total_tools = step.count
      set last_batch = step.last_batch
      set waiting = step.waiting
      set must_force_text = step.must_force_text
      set explore_count = step.explore_count
      set acted = step.acted
    end
    if round >= round_cap then
      print("  [warn] reached " ++ to_text(round_cap) ++ " response rounds this turn, stopping]")
      set waiting = false
    end
  end
  msgs
end

-- ─── Model selection ─────────────────────────────────────────────────────────

function is_expert_task(input: text): boolean
  intent: return true when input is very long or contains architecture and design keywords
  let very_long: boolean = text_length(input) > 800
  let arch_keywords: boolean = contains_text(lowercase(input), "architect") or contains_text(lowercase(input), "refactor") or contains_text(lowercase(input), "redesign") or contains_text(lowercase(input), "design")
  very_long or arch_keywords
end

function is_complex_task(input: text): boolean
  intent: return true when input is long, contains error codes, or is an action request requiring tool use
  let long_input: boolean = text_length(input) > 200
  let has_error: boolean = contains_text(input, "E_") or contains_text(lowercase(input), "error")
  let lower: text = lowercase(input)
  let is_action: boolean = contains_text(lower, "commit") or contains_text(lower, "push") or contains_text(lower, "run ") or contains_text(lower, "install") or contains_text(lower, "git ") or contains_text(lower, "check ") or contains_text(lower, "test ") or contains_text(lower, "build") or contains_text(lower, "execute") or contains_text(lower, "deploy")
  long_input or has_error or is_action
end

function pick_model(input: text, full_model: text, fast_model: text, expert_model: text): text
  intent: dispatch to expert_model, full_model, or fast_model based on is_expert_task and is_complex_task
  if text_length(expert_model) > 0 and is_expert_task(input) then
    expert_model
  else if text_length(fast_model) == 0 or is_complex_task(input) then
    full_model
  else
    fast_model
  end
end

-- ─── Main loop ────────────────────────────────────────────────────────────────

function resolve_api_key(base_url: text): text
  intent: return LEGIBLE_CODER_API_KEY if set, then the provider-specific key, or lm-studio for local
  let explicit_key: an optional text = env_get("LEGIBLE_CODER_API_KEY")
  if is_some(explicit_key) then
    unwrap(explicit_key)
  else if is_gemini_url(base_url) then
    let gemini_key: an optional text = env_get("GEMINI_API_KEY")
    if is_none(gemini_key) then
      print("Error: GEMINI_API_KEY is not set. Set it or use LEGIBLE_CODER_API_KEY.")
      exit_process(1)
    end
    unwrap(gemini_key)
  else if is_openrouter_url(base_url) then
    let openrouter_key: an optional text = env_get("OPENROUTER_API_KEY")
    if is_none(openrouter_key) then
      print("Error: OPENROUTER_API_KEY is not set. Set it or use LEGIBLE_CODER_API_KEY.")
      exit_process(1)
    end
    unwrap(openrouter_key)
  else if is_nims_url(base_url) then
    let nims_key: an optional text = env_get("NVIDIA_API_KEY")
    if is_none(nims_key) then
      print("Error: NVIDIA_API_KEY is not set. Set it or use LEGIBLE_CODER_API_KEY.")
      exit_process(1)
    end
    unwrap(nims_key)
  else if is_groq_url(base_url) then
    let groq_key: an optional text = env_get("GROQ_API_KEY")
    if is_none(groq_key) then
      print("Error: GROQ_API_KEY is not set. Set it or use LEGIBLE_CODER_API_KEY.")
      exit_process(1)
    end
    unwrap(groq_key)
  else
    "lm-studio"
  end
end

function resolve_max_tools(tier: text): integer
  intent: read LEGIBLE_CODER_MAX_TOOLS or use default 60 for local and 30 for cloud providers
  let default_text: text = if tier == "local" then "60" else "30" end
  let raw: text = unwrap_or(env_get("LEGIBLE_CODER_MAX_TOOLS"), default_text)
  max(to_integer(raw), 1)
end

function resolve_context_budget(tier: text): integer
  intent: read LEGIBLE_CODER_CONTEXT_TOKENS or use a provider-appropriate token budget before compaction
  -- gemini-2.5-flash has a 1M token context, glm-5.1 has 131K, groq models vary but 90K is safe, local is very limited
  let default_text: text = if tier == "local" then "6000" else if tier == "gemini" then "700000" else if tier == "nims" then "120000" else "90000" end
  let raw: text = unwrap_or(env_get("LEGIBLE_CODER_CONTEXT_TOKENS"), default_text)
  max(to_integer(raw), 1000)
end

function resolve_context_keep_messages(tier: text): integer
  intent: read LEGIBLE_CODER_CONTEXT_KEEP_MESSAGES or use a provider-appropriate recent-message default
  let default_text: text = if tier == "local" then "8" else if tier == "gemini" then "24" else "12" end
  let raw: text = unwrap_or(env_get("LEGIBLE_CODER_CONTEXT_KEEP_MESSAGES"), default_text)
  max(to_integer(raw), 2)
end

function resolve_max_output_tokens(tier: text, include_tools: boolean): integer
  intent: read LEGIBLE_CODER_MAX_OUTPUT_TOKENS or pick a default suited to the backend
  -- gemini-2.5-flash supports up to 65K output, glm-5.1 supports up to 131K, groq up to ~16K, local is small
  let default_text: text = if tier == "local" and include_tools then "4096" else if tier == "local" then "750" else if tier == "gemini" then "32768" else if tier == "nims" then "32768" else "16384" end
  let raw: text = unwrap_or(env_get("LEGIBLE_CODER_MAX_OUTPUT_TOKENS"), default_text)
  max(to_integer(raw), 128)
end

function env_truthy(name: text): boolean
  intent: env_get lowercase trim raw compare
  let raw: text = lowercase(trim(unwrap_or(env_get(name), "")))
  raw == "1" or raw == "true" or raw == "yes" or raw == "on"
end

function env_falsey(name: text): boolean
  intent: env_get lowercase trim raw compare
  let raw: text = lowercase(trim(unwrap_or(env_get(name), "")))
  raw == "0" or raw == "false" or raw == "no" or raw == "off"
end

function is_gemma4_model(model: text): boolean
  intent: return true when the configured model name looks like a Gemma 4 model
  let lower: text = lowercase(model)
  contains_text(lower, "gemma-4") or contains_text(lower, "gemma4")
end

function resolve_include_vision(model: text): boolean
  intent: return true when vision is enabled via env or the model is known to support multimodal input
  if env_falsey("LEGIBLE_CODER_VISION") then
    false
  else if env_truthy("LEGIBLE_CODER_VISION") then
    true
  else
    let lower: text = lowercase(model)
    contains_text(lower, "gemini") or
    contains_text(lower, "gemma-4") or contains_text(lower, "gemma4") or
    contains_text(lower, "llama-4") or contains_text(lower, "vision") or
    contains_text(lower, "llava") or contains_text(lower, "claude-3") or
    contains_text(lower, "claude-4") or contains_text(lower, "gpt-4")
  end
end

function resolve_local_native_tools(model: text): boolean
  intent: enable native local tool calling when forced or when the model is Gemma 4 unless explicitly disabled
  if env_falsey("LEGIBLE_CODER_LOCAL_TOOLS") then
    false
  else if env_truthy("LEGIBLE_CODER_LOCAL_TOOLS") then
    true
  else
    is_gemma4_model(model)
  end
end

function print_local_tool_mode(is_local: boolean, include_tools: boolean): nothing
  intent: print local tool mode when base_url is local
  if is_local and include_tools then
    print("  local tool mode: native OpenAI tool schemas")
  else if is_local then
    print("  local tool mode: manual TOOL protocol")
  end
end

function build_custom_provider(url: text, model_override: an optional text): a mapping from text to text
  intent: build a provider mapping for an explicitly configured base URL
  let key: text = resolve_api_key(url)
  let default_model: text = if is_gemini_url(url) then "gemini-2.5-flash" else if is_nims_url(url) then "z-ai/glm-5.1" else if is_openrouter_url(url) then "openrouter/free" else if is_groq_url(url) then "openai/gpt-oss-120b" else "google/gemma-4-26b-a4b" end
  let model: text = unwrap_or(model_override, default_model)
  let url_is_local: boolean = contains_text(url, "localhost") or contains_text(url, "127.0.0.1")
  let fast_model: text = if url_is_local then "" else unwrap_or(env_get("LEGIBLE_CODER_FAST_MODEL"), model) end
  let expert_model: text = if url_is_local then "" else unwrap_or(env_get("LEGIBLE_CODER_EXPERT_MODEL"), "") end
  {"name": "Custom", "key": key, "url": url, "full": model, "fast": fast_model, "expert": expert_model}
end

function build_gemini_provider(key: text, model_override: an optional text): a mapping from text to text
  intent: build a provider mapping for the Gemini API using the free-tier default
  let model: text = unwrap_or(model_override, "gemini-2.5-flash")
  let fast_model: text = unwrap_or(env_get("LEGIBLE_CODER_FAST_MODEL"), "gemini-2.5-flash-lite")
  let expert_model: text = unwrap_or(env_get("LEGIBLE_CODER_EXPERT_MODEL"), "")
  {"name": "Gemini", "key": key, "url": gemini_base_url(), "full": model, "fast": fast_model, "expert": expert_model}
end

function build_openrouter_provider(key: text, model_override: an optional text): a mapping from text to text
  intent: build a provider mapping for OpenRouter using its free models router
  let model: text = unwrap_or(model_override, "openrouter/free")
  let fast_model: text = unwrap_or(env_get("LEGIBLE_CODER_FAST_MODEL"), "openrouter/free")
  let expert_model: text = unwrap_or(env_get("LEGIBLE_CODER_EXPERT_MODEL"), "")
  {"name": "OpenRouter", "key": key, "url": openrouter_base_url(), "full": model, "fast": fast_model, "expert": expert_model}
end

function build_groq_provider(key: text, model_override: an optional text): a mapping from text to text
  intent: build a provider mapping for the Groq cloud API with its default models
  let model: text = unwrap_or(model_override, "openai/gpt-oss-120b")
  let fast_model: text = unwrap_or(env_get("LEGIBLE_CODER_FAST_MODEL"), "openai/gpt-oss-20b")
  let expert_model: text = unwrap_or(env_get("LEGIBLE_CODER_EXPERT_MODEL"), "")
  {"name": "Groq", "key": key, "url": "https://api.groq.com/openai/v1", "full": model, "fast": fast_model, "expert": expert_model}
end

function build_nims_provider(key: text, model_override: an optional text): a mapping from text to text
  intent: build a provider mapping for the NVIDIA NIM API using the GLM-5.1 model
  let model: text = unwrap_or(model_override, "z-ai/glm-5.1")
  let fast_model: text = unwrap_or(env_get("LEGIBLE_CODER_FAST_MODEL"), "z-ai/glm-5.1")
  let expert_model: text = unwrap_or(env_get("LEGIBLE_CODER_EXPERT_MODEL"), "")
  {"name": "NIM", "key": key, "url": nims_base_url(), "full": model, "fast": fast_model, "expert": expert_model}
end

function build_local_provider(model_override: an optional text): a mapping from text to text
  intent: build a provider mapping for the local LM Studio endpoint as the final fallback
  let model: text = unwrap_or(model_override, "google/gemma-4-26b-a4b")
  {"name": "LM Studio", "key": "lm-studio", "url": "http://localhost:1234/v1", "full": model, "fast": "", "expert": ""}
end

function build_default_provider_list(model_override: an optional text, gemini_key_opt: an optional text, nims_key_opt: an optional text, openrouter_key_opt: an optional text, groq_key_opt: an optional text): a list of a mapping from text to text
  intent: build the ordered fallback provider list based on which API keys are available
  let with_nims: a list of a mapping from text to text = if is_some(nims_key_opt) then [build_nims_provider(unwrap(nims_key_opt), model_override)] else [] end
  let with_gemini: a list of a mapping from text to text = if is_some(gemini_key_opt) then append(with_nims, build_gemini_provider(unwrap(gemini_key_opt), model_override)) else with_nims end
  let with_openrouter: a list of a mapping from text to text = if is_some(openrouter_key_opt) then append(with_gemini, build_openrouter_provider(unwrap(openrouter_key_opt), model_override)) else with_gemini end
  let with_groq: a list of a mapping from text to text = if is_some(groq_key_opt) then append(with_openrouter, build_groq_provider(unwrap(groq_key_opt), model_override)) else with_openrouter end
  append(with_groq, build_local_provider(model_override))
end

function build_provider_list(): a list of a mapping from text to text
  intent: pick single-provider mode if LEGIBLE_CODER_BASE_URL is set, otherwise build the auto-detected fallback list
  let custom_url_opt: an optional text = env_get("LEGIBLE_CODER_BASE_URL")
  let model_override: an optional text = env_get("LEGIBLE_CODER_MODEL")
  if is_some(custom_url_opt) then
    [build_custom_provider(unwrap(custom_url_opt), model_override)]
  else
    build_default_provider_list(model_override, env_get("GEMINI_API_KEY"), env_get("NVIDIA_API_KEY"), env_get("OPENROUTER_API_KEY"), env_get("GROQ_API_KEY"))
  end
end

function print_turn_model_banner(try_idx: integer, prov: a mapping from text to text, turn_model: text, p_full: text, p_fast: text, p_expert: text): nothing
  intent: print the fallback notice or the expert/fast model banner before a turn runs
  if try_idx > 0 then
    print("  [fallback] trying " ++ get(prov, "name") ++ " with model " ++ turn_model)
  end
  if try_idx == 0 and turn_model == p_expert and text_length(p_expert) > 0 then
    print("  [expert model: " ++ p_expert ++ "]")
  end
  if try_idx == 0 and turn_model == p_fast and text_length(p_fast) > 0 and p_fast != p_full then
    print("  [fast model: " ++ p_fast ++ "]")
  end
end

function run_turn_with_fallback(messages: a list of a mapping from text to text, user_input: text, start: integer, providers: a list of a mapping from text to text, max_tools: integer, include_tools: boolean, include_dir_tools: boolean, max_output_tokens: integer, context_budget: integer, preserve_recent_messages: integer, include_vision: boolean): a list of a mapping from text to text
  intent: try each provider in order for one turn, returning updated messages when one succeeds or after all have failed
  mutable msgs: a list of a mapping from text to text = messages
  mutable try_idx: integer = 0
  mutable turn_done: boolean = false
  while not turn_done do
    let prov: a mapping from text to text = get(providers, try_idx)
    let p_full: text = get(prov, "full")
    let p_fast: text = get(prov, "fast")
    let p_expert: text = get(prov, "expert")
    let turn_model: text = pick_model(user_input, p_full, p_fast, p_expert)
    print_turn_model_banner(try_idx, prov, turn_model, p_full, p_fast, p_expert)
    set msgs = run_inner_loop(msgs, start, get(prov, "key"), get(prov, "url"), turn_model, max_tools, include_tools, include_dir_tools, max_output_tokens, context_budget, preserve_recent_messages, include_vision)
    if length(msgs) > start then
      set turn_done = true
    else
      set try_idx = try_idx + 1
      if try_idx >= length(providers) then
        set turn_done = true
      end
    end
  end
  msgs
end

function run_repl(init_messages: a list of a mapping from text to text, providers: a list of a mapping from text to text, max_tools: integer, include_tools: boolean, include_dir_tools: boolean, max_output_tokens: integer, context_budget: integer, preserve_recent_messages: integer, include_vision: boolean): nothing
  intent: run the interactive read-eval-print loop, dispatching each user turn through the provider fallback chain
  mutable messages: a list of a mapping from text to text = init_messages
  mutable running: boolean = true
  while running do
    print("  > ")
    let user_input: text = trim(read_line())
    if user_input == "quit" or user_input == "exit" then
      print("  Goodbye!")
      set running = false
    else if text_length(user_input) == 0 then
      print("")
    else
      set messages = append(messages, {"role": "user", "content": user_input})
      let start: integer = length(messages)
      set messages = run_turn_with_fallback(messages, user_input, start, providers, max_tools, include_tools, include_dir_tools, max_output_tokens, context_budget, preserve_recent_messages, include_vision)
    end
  end
end

function provider_name_list(providers: a list of a mapping from text to text): a list of text
  intent: extract the name field from each provider mapping into a list of text
  map(providers, fn(p: a mapping from text to text): text => get(p, "name"))
end

function initial_messages(is_local: boolean, sys_prompt: text): a list of a mapping from text to text
  intent: build the starting message list with the system prompt and optional local bootstrap
  let sys_msg: a mapping from text to text = {"role": "system", "content": sys_prompt}
  if is_local then
    [sys_msg, {"role": "system", "content": local_model_context()}]
  else
    [sys_msg]
  end
end

function main(): nothing
  intent: build the provider list, compute tier-based settings, print the banner, and start the REPL
  let providers: a list of a mapping from text to text = build_provider_list()
  let primary: a mapping from text to text = get(providers, 0)
  let primary_url: text = get(primary, "url")
  let primary_model: text = get(primary, "full")
  let tier: text = provider_tier(primary_url)
  let is_local: boolean = tier == "local"
  let include_tools: boolean = not is_local or resolve_local_native_tools(primary_model)
  let include_dir_tools: boolean = include_tools
  let max_tools: integer = resolve_max_tools(tier)
  let max_output_tokens: integer = resolve_max_output_tokens(tier, include_tools)
  let context_budget: integer = resolve_context_budget(tier)
  let preserve_recent_messages: integer = resolve_context_keep_messages(tier)
  let include_vision: boolean = include_tools and resolve_include_vision(primary_model)
  print_banner(primary_model, primary_url)
  if length(providers) > 1 then
    print("  Fallbacks: " ++ join(drop(provider_name_list(providers), 1), " -> "))
  end
  print_local_tool_mode(is_local, include_tools)
  let sys_prompt: text = if is_local and not include_tools then local_system_prompt() else system_prompt(include_tools, include_dir_tools, include_vision) end
  let messages: a list of a mapping from text to text = initial_messages(is_local, sys_prompt)
  run_repl(messages, providers, max_tools, include_tools, include_dir_tools, max_output_tokens, context_budget, preserve_recent_messages, include_vision)
end
