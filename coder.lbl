-- legible-coder: an interactive CLI coding assistant for the Legible language
-- Default backend: Qwen (OPENAI_API_KEY, DASHSCOPE_API_KEY, or ALIBABA_TOKEN_PLAN_API_KEY), falls back to Gemini (GEMINI_API_KEY), OrcaRouter (ORCAROUTER_API_KEY), NIM (NVIDIA_API_KEY), OpenRouter (OPENROUTER_API_KEY), Groq (GROQ_API_KEY), then LM Studio
-- Override with LEGIBLE_CODER_MODEL and LEGIBLE_CODER_BASE_URL env vars
-- Default model: qwen3.8-max via Qwen


use kv_cache

-- ─── Tool schema helpers ──────────────────────────────────────────────────────

function make_param(pname: text, pdesc: text): a mapping from text to text
  intent: wrap pname and pdesc into a type and description mapping
  {"type": "string", "description": pdesc}
end

function make_tool(name: text, description: text, param_names: a list of text, param_descs: a list of text, required_params: a list of text): a mapping from text to text
  intent: put name, description, properties, and required into a function schema mapping
  mutable properties: a mapping from text to text = {}
  mutable i: integer = 0
  for pname in param_names do
    let pdesc: text = get(param_descs, i)
    set properties = put(properties, pname, make_param(pname, pdesc))
    set i = i + 1
  end
  {
    "type": "function",
    "function": {
      "name": name,
      "description": description,
      "parameters": {
        "type": "object",
        "properties": properties,
        "required": required_params
      }
    }
  }
end

function file_tools(include_dir_tools: boolean): a list of a mapping from text to text
  intent: build file read write schemas and optionally add directory listing tools
  let read_tool: a mapping from text to text = make_tool("read_file", "Read the contents of a file at the given path.", ["path"], ["The file path to read"], ["path"])
  let lines_tool: a mapping from text to text = make_tool("read_file_lines", "Read only part of a file using 1-based start_line and line_count.", ["path", "start_line", "line_count"], ["The file path to read", "The first 1-based line number to include", "The number of lines to include"], ["path", "start_line", "line_count"])
  let write_tool: a mapping from text to text = make_tool("write_file", "Write content to a file at the given path. Creates or overwrites.", ["path", "content"], ["The file path to write", "The content to write"], ["path", "content"])
  if include_dir_tools then
    let list_tool: a mapping from text to text = make_tool("list_dir", "List files and directories at a given path (one level only).", ["path"], ["The directory path to list"], ["path"])
    let recursive_tool: a mapping from text to text = make_tool("read_dir_recursive", "Recursively list all files under a directory. Use this instead of repeated list_dir calls to understand the project structure.", ["path"], ["The root directory to list recursively"], ["path"])
    [read_tool, lines_tool, write_tool, list_tool, recursive_tool]
  else
    [read_tool, lines_tool, write_tool]
  end
end

function search_tools(): a list of a mapping from text to text
  intent: build shell_exec and grep tool schemas
  let shell_tool: a mapping from text to text = make_tool("shell_exec", "Run a shell command and return stdout, stderr, and exit code.", ["command"], ["The shell command to execute"], ["command"])
  let grep_tool: a mapping from text to text = make_tool("grep", "Search for a pattern in files. Returns matching lines.", ["pattern", "path", "glob"], ["The regex pattern to search for", "Directory or file to search in", "Glob to filter files, e.g. *.lbl"], ["pattern"])
  [shell_tool, grep_tool]
end

function screenshot_tool(): a mapping from text to text
  intent: build the take_screenshot tool schema for visual evaluation of GUI output
  make_tool("take_screenshot", "Launch a GUI program and capture a screenshot for visual evaluation. Pass the program command in 'command' — it will be started in the background, the screen captured after 'delay' seconds, then the process killed. If the app exits before the delay elapses, the tool returns the captured stdout/stderr so you can diagnose the crash. Do NOT use shell_exec to launch GUI apps separately; use this tool instead so the capture happens while the window is open. Increase 'delay' (e.g. 5) if the window is slow to render.", ["command", "delay"], ["The shell command to launch the GUI app (will be run in background)", "Seconds to wait for the window to appear before capturing (default: 3)"], [])
end

function web_search_tool(): a mapping from text to text
  intent: build the web_search tool schema for live web queries
  make_tool("web_search", "Search the web for current information. Use for docs, library versions, release notes, error messages, or anything outside your training data. Returns a numbered list of results with title, URL, and snippet.", ["query", "max_results"], ["The search query", "Maximum number of results to return (default: 5, capped at 10)"], ["query"])
end

function tool_definitions(include_dir_tools: boolean, include_vision: boolean): a list of a mapping from text to text
  intent: combine file, search, and optionally vision tools into one list
  let ft: a list of a mapping from text to text = file_tools(include_dir_tools)
  let st: a list of a mapping from text to text = search_tools()
  let combined: a list of a mapping from text to text = reduce(st, ft, fn(acc: a list of a mapping from text to text, t: a mapping from text to text): a list of a mapping from text to text => append(acc, t))
  let with_search: a list of a mapping from text to text = append(combined, web_search_tool())
  if include_vision then append(with_search, screenshot_tool()) else with_search end
end

-- ─── Tool validation ──────────────────────────────────────────────────────────

-- Strip model special-token suffixes like "<|channel|>commentary" from a tool name
function clean_tool_name(name: text): text
  intent: strip everything from the first angle bracket onward in name
  let bracket: integer = unwrap_or(index_of(name, "<"), -1)
  if bracket > 0 then
    trim(substring(name, 0, bracket))
  else
    name
  end
end

function is_known_tool(name: text): boolean
  intent: compare the cleaned name to the supported tool names
  let n: text = clean_tool_name(name)
  n == "read_file" or n == "read_file_lines" or n == "write_file" or n == "shell_exec" or
  n == "list_dir" or n == "read_dir_recursive" or n == "grep" or n == "take_screenshot" or n == "web_search"
end

function is_local_known_tool(name: text): boolean
  intent: compare the cleaned name to the local manual-tool names that exclude full-file reads
  let n: text = clean_tool_name(name)
  n == "read_file_lines" or n == "write_file" or n == "shell_exec" or
  n == "list_dir" or n == "read_dir_recursive" or n == "grep" or n == "take_screenshot" or n == "web_search"
end

function strip_path_quotes(path: text): text
  intent: use starts_with and ends_with to detect surrounding quotes in path and return the inner substring
  let n: integer = text_length(path)
  if n >= 2 and starts_with(path, "\"") and ends_with(path, "\"") then
    substring(path, 1, n - 2)
  else if n >= 2 and starts_with(path, "'") and ends_with(path, "'") then
    substring(path, 1, n - 2)
  else
    path
  end
end

function strip_trailing_slash(path: text): text
  intent: use ends_with to check path for a trailing slash and return the substring without it
  let n: integer = text_length(path)
  if n > 1 and ends_with(path, "/") then
    substring(path, 0, n - 1)
  else
    path
  end
end

function normalize_cd_path(path: text): text
  intent: strip surrounding quotes and a trailing slash from path so it can be compared to get_cwd
  strip_trailing_slash(strip_path_quotes(path))
end

function strip_redundant_cd(command: text): text
  intent: when command starts with "cd <cwd> && rest" drop the redundant cd so only rest is executed
  let trimmed: text = trim(command)
  if not starts_with(trimmed, "cd ") then
    trimmed
  else
    let amp_idx: integer = unwrap_or(index_of(trimmed, " && "), -1)
    if amp_idx < 3 then
      trimmed
    else
      let path_raw: text = trim(substring(trimmed, 3, amp_idx - 3))
      let path_canon: text = normalize_cd_path(path_raw)
      let cwd_canon: text = normalize_cd_path(get_cwd())
      if text_length(path_canon) > 0 and path_canon == cwd_canon then
        trim(substring(trimmed, amp_idx + 4, text_length(trimmed) - amp_idx - 4))
      else
        trimmed
      end
    end
  end
end

function normalize_tool_call_arguments(arguments: text): text
  intent: json_parse arguments into a mapping, use keys and get and to_text and is_none to coerce every value to text, then put each into a normalized mapping and json_encode it
  if not json_valid(arguments) then
    arguments
  else
    let args: a mapping from text to text = json_parse(arguments)
    let ks: a list of text = keys(args)
    mutable normalized: a mapping from text to text = {}
    for k in ks do
      let raw: text = get(args, k)
      let coerced: text = if is_none(raw) then raw else to_text(raw) end
      set normalized = put(normalized, k, coerced)
    end
    json_encode(normalized)
  end
end

function describe_tool_call(name: text, arguments: text): text
  intent: format name with its path, command, or pattern argument as a short label
  let args: a mapping from text to text = json_parse(arguments)
  if name == "read_file" or name == "list_dir" or name == "read_dir_recursive" then
    name ++ "  " ++ unwrap_or(get(args, "path"), "")
  else if name == "read_file_lines" then
    name ++ "  " ++ unwrap_or(get(args, "path"), "") ++ ":" ++ unwrap_or(get(args, "start_line"), "") ++ "+" ++ unwrap_or(get(args, "line_count"), "")
  else if name == "write_file" then
    name ++ "  " ++ unwrap_or(get(args, "path"), "")
  else if name == "shell_exec" then
    let cmd: text = strip_redundant_cd(unwrap_or(get(args, "command"), ""))
    let preview: text = if text_length(cmd) > 60 then substring(cmd, 0, 60) ++ "…" else cmd end
    name ++ "  $ " ++ preview
  else if name == "grep" then
    let pat: text = unwrap_or(get(args, "pattern"), "")
    let path: text = unwrap_or(get(args, "path"), ".")
    name ++ "  /" ++ pat ++ "/  " ++ path
  else if name == "take_screenshot" then
    name
  else if name == "web_search" then
    let q: text = unwrap_or(get(args, "query"), "")
    let preview: text = if text_length(q) > 60 then substring(q, 0, 60) ++ "..." else q end
    name ++ "  /" ++ preview ++ "/"
  else
    name
  end
end

-- ─── Tool execution ───────────────────────────────────────────────────────────

function strip_code_fences(content: text): text
  intent: trim content and when it starts_with a markdown fence split the lines, drop the fence lines, and join the inner lines back
  let trimmed: text = trim(content)
  if not starts_with(trimmed, "```") then
    content
  else
    let lines: a list of text = split(trimmed, "\n")
    let n: integer = length(lines)
    if n >= 2 and trim(unwrap_or(get(lines, n - 1), "")) == "```" then
      mutable inner: a list of text = []
      mutable i: integer = 1
      while i <= n - 2 do
        set inner = append(inner, unwrap_or(get(lines, i), ""))
        set i = i + 1
      end
      join(inner, "\n") ++ "\n"
    else
      content
    end
  end
end

function legible_check_report(path: text): text
  intent: run legible check on a written .lbl file and return its error output or empty text
  if not ends_with(path, ".lbl") then
    ""
  else
    let cmd: text = "if command -v legible >/dev/null 2>&1; then legible check \"" ++ path ++ "\" 2>&1 | head -40; fi"
    let output: text = trim(get(shell_exec(cmd), "stdout"))
    if text_length(output) == 0 or contains_text(output, "No errors found") then "" else output end
  end
end

function exec_write_file(args: a mapping from text to text): text
  intent: write content to path, print a diff if the file existed, and run legible_check_report on .lbl files
  let path: text = get(args, "path")
  let content: text = strip_code_fences(get(args, "content"))
  -- ensure the parent directory exists so writes to new subdirs don't fail
  let ignored: a mapping from text to text = shell_exec("mkdir -p \"$(dirname \"" ++ path ++ "\")\"")
  if file_exists(path) then
    let old_content: text = read_file(path)
    write_file("/tmp/legible_coder_old", old_content)
    write_file(path, content)
    let diff_output: text = get(shell_exec("diff -u /tmp/legible_coder_old " ++ path ++ " 2>&1 | head -120"), "stdout")
    if text_length(diff_output) > 0 then
      print("")
      print(diff_output)
    end
  else
    write_file(path, content)
  end
  let check_report: text = legible_check_report(path)
  if text_length(check_report) == 0 then
    "File written successfully: " ++ path
  else
    "File written: " ++ path ++ "\nWARNING: legible check found errors in the file you just wrote:\n" ++ check_report ++ "\nFix these errors and call write_file again with corrected code."
  end
end

function exec_shell(args: a mapping from text to text): text
  intent: run the command and return exit_code, stdout, and stderr as text
  let result: a mapping from text to text = shell_exec(strip_redundant_cd(get(args, "command")))
  let base: text = "exit_code: " ++ to_text(get(result, "exit_code"))
  let with_out: text = if text_length(get(result, "stdout")) > 0 then base ++ "\nstdout:\n" ++ get(result, "stdout") else base end
  if text_length(get(result, "stderr")) > 0 then with_out ++ "\nstderr:\n" ++ get(result, "stderr") else with_out end
end

function exec_grep(args: a mapping from text to text): text
  intent: run grep with pattern, path, and optional glob and return matching lines
  let pattern: text = get(args, "pattern")
  let path: text = unwrap_or(get(args, "path"), ".")
  let glob_pattern: text = unwrap_or(get(args, "glob"), "")
  let cmd: text = if text_length(glob_pattern) > 0 then
    "grep -rn --include='" ++ glob_pattern ++ "' '" ++ pattern ++ "' " ++ path ++ " 2>&1 | head -50"
  else
    "grep -rn '" ++ pattern ++ "' " ++ path ++ " 2>&1 | head -50"
  end
  let stdout: text = get(shell_exec(cmd), "stdout")
  if text_length(stdout) > 0 then stdout else "No matches found." end
end

function web_search_encode(query: text): text
  intent: build step1 through step7 with replace over query so the returned query text is url encoded
  let step1: text = replace(query, "%", "%25")
  let step2: text = replace(step1, "&", "%26")
  let step3: text = replace(step2, "#", "%23")
  let step4: text = replace(step3, "?", "%3F")
  let step5: text = replace(step4, "=", "%3D")
  let step6: text = replace(step5, "\"", "%22")
  let step7: text = replace(step6, "'", "%27")
  replace(step7, " ", "+")
end

function xml_entity_decode(s: text): text
  intent: replace amp entity lt gt quot and apos entities in s with their plain characters and trim the result
  let s1: text = replace(s, "&amp;", "&")
  let s2: text = replace(s1, "&lt;", "<")
  let s3: text = replace(s2, "&gt;", ">")
  let s4: text = replace(s3, "&quot;", "\"")
  let s5: text = replace(s4, "&#39;", "'")
  let s6: text = replace(s5, "&apos;", "'")
  trim(s6)
end

function bing_rss_field(item: text, tag: text): text
  intent: split item on the opening tag then on the closing tag and decode the text between them or return empty text
  let open_tag: text = "<" ++ tag ++ ">"
  let close_tag: text = "</" ++ tag ++ ">"
  let after_open: a list of text = split(item, open_tag)
  if length(after_open) < 2 then
    ""
  else
    let content: text = unwrap_or(get(after_open, 1), "")
    let before_close: a list of text = split(content, close_tag)
    xml_entity_decode(unwrap_or(get(before_close, 0), ""))
  end
end

function bing_rss_results(body: text, max_results: integer): text
  intent: extract up to max_results items from a Bing RSS body and format them as numbered lines
  let items: a list of text = split(body, "<item>")
  mutable out: a list of text = []
  mutable i: integer = 1
  while i < length(items) and length(out) < max_results do
    let item: text = unwrap_or(get(items, i), "")
    let title: text = bing_rss_field(item, "title")
    let url: text = bing_rss_field(item, "link")
    let snippet: text = bing_rss_field(item, "description")
    if text_length(title) > 0 and text_length(url) > 0 then
      set out = append(out, to_text(length(out) + 1) ++ ". " ++ title ++ "\n   URL: " ++ url ++ "\n   " ++ snippet)
    else
      skip()
    end
    set i = i + 1
  end
  if length(out) == 0 then "" else join(out, "\n\n") end
end

function exec_web_search(args: a mapping from text to text): text
  intent: query Bing RSS over http_client_get with the encoded query and return numbered results
  let query: text = trim(unwrap_or(get(args, "query"), ""))
  if text_length(query) == 0 then
    "Error: web_search needs a non-empty query."
  else
    let max_results: integer = min(max(to_integer(unwrap_or(get(args, "max_results"), "5")), 1), 10)
    let url: text = "https://www.bing.com/search?q=" ++ web_search_encode(query) ++ "&format=rss"
    let headers: a mapping from text to text = {"User-Agent": "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0 Safari/537.36"}
    let response: a mapping from text to text = http_client_get(url, headers)
    let status: text = unwrap_or(get(response, "status"), "")
    if not starts_with(status, "2") then
      "Error: web search request failed with status " ++ status
    else
      let results: text = bing_rss_results(unwrap_or(get(response, "body"), ""), max_results)
      if text_length(results) > 0 then results else "No results found." end
    end
  end
end

function exec_read_file_lines(args: a mapping from text to text): text
  intent: read one file slice using a 1-based start line and line count
  let path: text = get(args, "path")
  if not file_exists(path) then
    "Error: file not found: " ++ path
  else
    let start_line: integer = max(to_integer(unwrap_or(get(args, "start_line"), "1")), 1)
    let line_count: integer = 40
    let lines: a list of text = split(read_file(path), "\n")
    let finish: integer = min(length(lines), start_line + line_count - 1)
    mutable out: a list of text = []
    mutable i: integer = start_line
    while i <= finish do
      set out = append(out, to_text(i) ++ ": " ++ unwrap_or(get(lines, i - 1), ""))
      set i = i + 1
    end
    if length(out) == 0 then "(no lines in requested range)" else join(out, "\n") end
  end
end

function screenshot_capture_cmd(path: text): text
  intent: build a shell command string with grim, scrot, import, and gnome-screenshot to capture to path
  "(grim " ++ path ++ " 2>/dev/null || scrot -o " ++ path ++ " 2>/dev/null || import -window root " ++ path ++ " 2>/dev/null || gnome-screenshot -f " ++ path ++ " 2>/dev/null)"
end

function screenshot_launch_script(command: text, path: text, log_path: text, delay: text): text
  intent: launch GUI in background, verify it survived the delay, capture screen, then kill it
  "rm -f " ++ path ++ " " ++ log_path ++ "; " ++
  "(" ++ command ++ ") > " ++ log_path ++ " 2>&1 & APP_PID=$!; " ++
  "sleep " ++ delay ++ "; " ++
  "if kill -0 $APP_PID 2>/dev/null; then " ++ screenshot_capture_cmd(path) ++ "; " ++
  "kill $APP_PID 2>/dev/null; wait $APP_PID 2>/dev/null; " ++
  "else echo APP_EXITED_EARLY >&2; fi"
end

function screenshot_result(path: text, log_path: text, result: a mapping from text to text): text
  intent: classify screenshot outcome and return path or an error message including captured app log
  let stderr: text = unwrap_or(get(result, "stderr"), "")
  if contains_text(stderr, "APP_EXITED_EARLY") then
    let log: text = if file_exists(log_path) then read_file(log_path) else "(no log)" end
    "Error: GUI app exited before screenshot could be taken. App output:\n" ++ log
  else if file_exists(path) then
    path
  else
    "Error: screenshot failed (exit " ++ to_text(get(result, "exit_code")) ++ "). Install grim, scrot, imagemagick, or gnome-screenshot."
  end
end

function exec_take_screenshot(args: a mapping from text to text): text
  intent: launch optional GUI command in background then capture a screenshot and return the path
  let path: text = "/tmp/legible_coder_screenshot.png"
  let log_path: text = "/tmp/legible_coder_app.log"
  let delay: text = unwrap_or(get(args, "delay"), "3")
  let command: text = unwrap_or(get(args, "command"), "")
  let cmd: text = if text_length(command) > 0 then
    screenshot_launch_script(command, path, log_path, delay)
  else
    "rm -f " ++ path ++ "; sleep " ++ delay ++ " && " ++ screenshot_capture_cmd(path)
  end
  screenshot_result(path, log_path, shell_exec(cmd))
end

function build_vision_eval_message(screenshot_path: text): a mapping from text to text
  intent: read the screenshot as base64 and build a multimodal user message for visual evaluation
  let b64: text = trim(get(shell_exec("base64 -w 0 < " ++ screenshot_path), "stdout"))
  let data_url: text = "data:image/png;base64," ++ b64
  {
    "role": "user",
    "content": [
      {"type": "text", "text": "I ran the GUI code and took this screenshot. Evaluate: does it look correct visually? Note any layout issues, missing elements, or improvements needed."},
      {"type": "image_url", "image_url": {"url": data_url}}
    ]
  }
end

function execute_tool(name: text, arguments: text): text
  intent: parse arguments and dispatch to the supported tool implementations
  let args: a mapping from text to text = json_parse(arguments)
  if name == "read_file" then
    let path: text = get(args, "path")
    if file_exists(path) then read_file(path) else "Error: file not found: " ++ path end
  else if name == "read_file_lines" then
    exec_read_file_lines(args)
  else if name == "write_file" then
    exec_write_file(args)
  else if name == "shell_exec" then
    exec_shell(args)
  else if name == "list_dir" then
    let path: text = get(args, "path")
    if is_dir(path) then join(list_dir(path), "\n") else "Error: not a directory: " ++ path end
  else if name == "read_dir_recursive" then
    get(shell_exec("find " ++ get(args, "path") ++ " -type f | sort 2>&1 | head -200"), "stdout")
  else if name == "grep" then
    exec_grep(args)
  else if name == "take_screenshot" then
    exec_take_screenshot(args)
  else if name == "web_search" then
    exec_web_search(args)
  else
    "Error: unknown tool: " ++ name
  end
end

-- ─── System prompt ────────────────────────────────────────────────────────────

function prompt_syntax_ref(): text
  intent: return the Legible syntax reference section covering bindings, types, functions, records, unions, control flow, and operators
  "════ LEGIBLE LANGUAGE REFERENCE ════\n\n" ++
  "BINDINGS:\n" ++
  "  let name: type = value          -- immutable\n" ++
  "  mutable name: type = value      -- mutable\n" ++
  "  set name = new_value            -- update a mutable binding\n\n" ++
  "TYPES:\n" ++
  "  integer  decimal  text  boolean  nothing\n" ++
  "  a list of T\n" ++
  "  a mapping from K to V\n" ++
  "  an optional T\n\n" ++
  "FUNCTIONS:\n" ++
  "  function name(param: type, param2: type): return_type\n" ++
  "    intent: what this function does\n" ++
  "    body\n" ++
  "  end\n\n" ++
  "RECORDS:\n" ++
  "  record Name\n" ++
  "    field: type\n" ++
  "  end\n" ++
  "  let x: Name = Name \{ field: value \}\n" ++
  "  let updated: Name = x with \{ field: new_value \}\n\n" ++
  "UNIONS:\n" ++
  "  union Shape\n" ++
  "    Circle \{ radius: decimal \}\n" ++
  "    Point\n" ++
  "  end\n" ++
  "  match s when Circle \{ radius \} then radius * 3.14 when Point then 0.0 end\n\n" ++
  "CONTROL FLOW:\n" ++
  "  if cond then ... else if cond then ... else ... end\n" ++
  "  for item in list do ... end\n" ++
  "  while cond do ... end\n\n" ++
  "OPERATORS:\n" ++
  "  ++ (text concat)   |> (pipeline)   and or not\n\n" ++
  "LAMBDAS:\n" ++
  "  fn(x: integer): boolean => x > 0\n\n" ++
  "MODULES:\n" ++
  "  use module_name           -- loads module_name.lbl\n" ++
  "  public function foo ...   -- export from a module\n" ++
  "  module_name.foo()         -- call an exported function\n\n"
end

function prompt_builtins(): text
  intent: return the built-ins list section
  "BUILT-INS:\n" ++
  "  print(v)  read_line()  to_text(v)  to_integer(v)  to_decimal(v)\n" ++
  "  length(list)  append(list, item)  filter(list, fn)  map(list, fn)  reduce(list, init, fn)\n" ++
  "  sort_by(list, fn)  find(list, fn)  take(list, n)  drop(list, n)  range(a, b)\n" ++
  "  split(text, delim)  join(list, sep)  trim(s)  replace(s, from, to)\n" ++
  "  substring(s, start, len)  text_length(s)  contains_text(s, sub)  index_of(s, sub)\n" ++
  "  uppercase(s)  lowercase(s)  starts_with(s, p)  ends_with(s, p)\n" ++
  "  keys(map)  values(map)  get(map, key)  put(map, key, val)  has_key(map, key)\n" ++
  "  unwrap(opt)  unwrap_or(opt, default)  is_some(opt)  is_none(opt)\n" ++
  "  abs(n)  max(a,b)  min(a,b)  floor(n)  ceil(n)  round(n)\n" ++
  "  random_int(max)  random_decimal()  skip()\n" ++
  "  read_file(path)  write_file(path, content)  file_exists(path)\n" ++
  "  shell_exec(cmd)  env_get(name)  get_cwd()  list_dir(path)  is_dir(path)\n" ++
  "  json_parse(text)  json_encode(value)  json_valid(text)\n" ++
  "  http_client_get(url, headers)  http_client_post(url, headers, body)\n" ++
  "  sdl_init(title,w,h)  sdl_clear(r,g,b)  sdl_fill_rect(x,y,w,h,r,g,b)  sdl_present()\n" ++
  "  sdl_draw_text(text,x,y,r,g,b)  sdl_load_font(path,size)  sdl_poll_events()\n" ++
  "  sdl_is_key_pressed(key)  sdl_delay(ms)  sdl_get_ticks()  sdl_quit()\n" ++
  "  sdl_screenshot(path)  -- saves canvas as PNG; call before sdl_quit for visual evaluation\n\n"
end

function prompt_example(): text
  intent: return a complete working Legible example program
  "COMPLETE EXAMPLE:\n" ++
  "  record Creature\n" ++
  "    name: text\n" ++
  "    hp: integer\n" ++
  "    level: integer\n" ++
  "  end\n\n" ++
  "  function describe(c: Creature): text\n" ++
  "    intent: format creature name, level, and hp as a status line\n" ++
  "    c.name ++ \" lv\" ++ to_text(c.level) ++ \" HP:\" ++ to_text(c.hp)\n" ++
  "  end\n\n" ++
  "  function level_up(c: Creature): Creature\n" ++
  "    intent: return c with level incremented and hp raised by ten\n" ++
  "    c with \{ level: c.level + 1, hp: c.hp + 10 \}\n" ++
  "  end\n\n" ++
  "  function main(): nothing\n" ++
  "    intent: create a creature, level it up, and print both states\n" ++
  "    let p: Creature = Creature \{ name: \"Flareon\", hp: 40, level: 1 \}\n" ++
  "    print(describe(p))\n" ++
  "    let p2: Creature = level_up(p)\n" ++
  "    print(describe(p2))\n" ++
  "  end\n\n" ++
  "Run programs with: legible run file.lbl\n\n"
end

function prompt_rules(): text
  intent: return the rules section listing common Legible mistakes to avoid
  "RULES:\n" ++
  "- Every function parameter needs a colon: fn(x: text) not fn(x text)\n" ++
  "- Every let/mutable binding needs a colon: let x: text = ... not let x text = ...\n" ++
  "- No semicolons, no curly braces for blocks — use end\n" ++
  "- Strings must be on one line; use ++ to concatenate across lines\n" ++
  "- In Legible source code, ALL arguments are positional — shell_exec(cmd) not shell_exec(command = cmd)\n" ++
  "- 'any' is NOT a valid type; use 'text' for unknown value types\n" ++
  "- shell_exec returns 'a mapping from text to text'; all values including exit_code are text\n" ++
  "- Use random_int(max) for random integers; do NOT use python or shell for RNG\n" ++
  "- No 'return' keyword; the last expression in a function body is returned\n" ++
  "- intent: values are unquoted plain text: intent: do something — NOT intent: \"do something\"\n" ++
  "- Dot access only works on records (record.field); for mappings use get(map, \"key\")\n" ++
  "- Types require the article: 'a list of T' and 'a mapping from K to V' — never 'list of T' or 'mapping from K to V'\n" ++
  "- No 'elseif' keyword — use 'else if' (two words)\n" ++
  "- No 'break' keyword — use a mutable boolean flag to exit loops\n" ++
  "- No array/list indexing with [] — use get(list, index) instead\n" ++
  "- Semicolons are not allowed anywhere, including inside intent descriptions\n" ++
  "- Comments use -- not #: write -- this is a comment, never # this is a comment\n" ++
  "- if-branches cannot be empty; use skip() as a no-op: if cond then skip() end\n" ++
  "- Avoid Unicode characters in code: use ASCII dash - not em-dash, straight quotes not curly quotes\n" ++
  "- Write code to files with write_file, then run with shell_exec\n" ++
  "- Invoke assistant tools through the registered native tool schemas. Never print write_file(...), shell_exec(...), or another tool invocation as prose or inside a code fence; printed calls are not executed\n" ++
  "- write_file content must be the raw file text; never wrap it in markdown code fences\n" ++
  "- If a write_file result reports legible check errors, fix them and rewrite the file before doing anything else\n" ++
  "- Keep responses concise; use tools to act rather than describing what you would do\n" ++
  "- Do NOT repeat the same tool call in one turn; if you already read a file or listed a directory, use what you have and answer\n" ++
  "- You have a limited tool budget per turn; gather what you need efficiently and then provide your answer"
end

function tool_names_text(include_tools: boolean, include_dir_tools: boolean, include_vision: boolean): text
  intent: return none or the available tool names based on include flags
  if not include_tools then
    "none"
  else if include_dir_tools and include_vision then
    "read_file, read_file_lines, write_file, shell_exec, list_dir, read_dir_recursive, grep, web_search, take_screenshot"
  else if include_dir_tools then
    "read_file, read_file_lines, write_file, shell_exec, list_dir, read_dir_recursive, grep, web_search"
  else if include_vision then
    "read_file, read_file_lines, write_file, shell_exec, grep, web_search, take_screenshot"
  else
    "read_file, read_file_lines, write_file, shell_exec, grep, web_search"
  end
end

function local_startup_instructions(): text
  intent: return the local startup workflow that uses the bootstrap as the starting project view
  "Startup workflow for every task:\n" ++
  "1. First read the LOCAL MODEL BOOTSTRAP already in context.\n" ++
  "2. Treat the bootstrap project tree as your starting view of the current working folder.\n" ++
  "3. Do not call list_dir on '.' unless the bootstrap is clearly insufficient.\n" ++
  "4. Then inspect only the files relevant to the current task.\n" ++
  "5. Always read files in 40-line intervals with read_file_lines to protect context.\n\n"
end

function local_examples(): text
  intent: return generic local tool examples without findings-file workflow
  "Examples:\n" ++
  "TOOL read_file_lines \{\"path\":\"main.lbl\",\"start_line\":\"1\",\"line_count\":\"40\"\}\n" ++
  "TOOL list_dir \{\"path\":\"../legible\"\}\n" ++
  "TOOL write_file \{\"path\":\"main.lbl\",\"content\":\"...updated content...\"\}\n" ++
  "TOOL shell_exec \{\"command\":\"legible check main.lbl\"\}\n" ++
  "TOOL grep \{\"pattern\":\"TODO\",\"path\":\".\",\"glob\":\"*.lbl\"\}\n" ++
  "TOOL web_search \{\"query\":\"legible interpreter releases\"\}\n\n"
end

function local_system_prompt(): text
  intent: return a compact local-model prompt with a manual TOOL protocol
  "You are legible-coder, a concise coding assistant for the Legible language.\n\n" ++
  "For this local-model session, native OpenAI tool calling is unavailable.\n" ++
  "If you need to use a tool, reply with exactly one line in this format:\n" ++
  "TOOL tool_name JSON_arguments\n" ++
  "Valid tools: read_file_lines, write_file, list_dir, read_dir_recursive, grep, shell_exec, web_search.\n" ++
  "After tool results are returned, either request one more tool the same way or reply with:\n" ++
  "FINAL: your answer\n\n" ++
  "Do not emit multiple TOOL lines in one response. Do not explain the tool choice before or after the TOOL line.\n" ++
  "Do not emit <tool_call>, <tool_response>, arguments:, or any XML-style wrappers.\n" ++
  local_startup_instructions() ++
  "The bootstrap already gives you the current project tree, so prefer using it instead of restarting with list_dir on '.'.\n" ++
  "Prefer list_dir or read_dir_recursive for directory exploration before using shell_exec.\n" ++
  "Do not use read_file in local mode. Always use read_file_lines with path, start_line, and line_count set to 40 unless you have a strong reason not to.\n" ++
  "If the user asks you to change code or files, do not stop at a description. Keep using tools until you write the file with write_file or you can clearly explain a blocker.\n" ++
  "If the user says 'continue', 'do that', or asks for a follow-up change, continue from the prior conversation state instead of restarting exploration unless you truly need new information.\n" ++
  local_examples() ++
  "Understand the task by reading the relevant files first. Do not guess file contents.\n" ++
  "Keep answers direct and avoid long chain-of-thought.\n\n" ++
  "Legible rules:\n" ++
  "- function params need colons: fn(x: text)\n" ++
  "- let/mutable bindings need colons\n" ++
  "- blocks end with end\n" ++
  "- no return keyword; last expression returns\n" ++
  "- mapping access uses get(map, \"key\")\n" ++
  "- list access uses get(list, index)\n" ++
  "- use else if, not elseif\n" ++
  "- comments use --\n" ++
  "- use ASCII in code\n"
end

function system_prompt(include_tools: boolean, include_dir_tools: boolean, include_vision: boolean): text
  intent: compose the header, syntax reference, builtins, example, and rules into the full system prompt
  let cwd: text = get_cwd()
  "You are legible-coder, an interactive CLI coding assistant. " ++
  "You write code in the Legible programming language and perform tasks by running Legible scripts.\n\n" ++
  "Current working directory: " ++ cwd ++ "\n\n" ++
  "TOOLS: " ++ tool_names_text(include_tools, include_dir_tools, include_vision) ++ ".\n" ++
  if not include_tools then "No runtime tools are available in this session. Rely on the preloaded workspace snapshot and answer in plain text.\n\n" else if include_dir_tools then "Use read_dir_recursive to understand project structure in ONE call instead of many list_dir calls.\nIMPORTANT: When the user asks you to take any action (run commands, check git status, read/write files, commit code, run tests), you MUST call a tool immediately. Do NOT describe what you would do, ask clarifying questions, or claim you cannot do something that a tool can accomplish. Use shell_exec for git and shell commands.\n\n" else "For local models, rely on the preloaded workspace snapshot before making tool calls.\n\n" end ++
  if include_vision then "VISUAL EVALUATION: For GUI tasks, use take_screenshot with the 'command' parameter set to the launch command (e.g. 'legible run gui.lbl'). The tool starts the app in the background, waits for 'delay' seconds (default 2), captures the screen, then kills the app. Do NOT run GUI programs via shell_exec — they block until closed, making a screenshot impossible.\n\n" else "" end ++
  prompt_syntax_ref() ++
  prompt_builtins() ++
  prompt_example() ++
  prompt_rules()
end

-- ─── API ──────────────────────────────────────────────────────────────────────

function extract_error_message(body: text): text
  intent: extract an API error message from a JSON body or fall back to the raw body text
  let trimmed: text = trim(body)
  if json_valid(body) and starts_with(trimmed, "\{") then
    let parsed: a mapping from text to text = json_parse(body)
    if has_key(parsed, "error") then
      to_text(get(parsed, "error"))
    else
      body
    end
  else
    body
  end
end

function local_model_context(): text
  intent: provide minimal local workspace orientation and the bootstrap project tree
  let project_tree: text = get(shell_exec("find . -maxdepth 2 -not -path './.git' -not -path './.git/*' | sort | head -80"), "stdout")
  "LOCAL MODEL BOOTSTRAP:\n" ++
  "Project tree:\n" ++ trim(project_tree) ++ "\n\n" ++
  "A neighboring repository named ../legible contains the interpreter implementation.\n" ++
  "Use this bootstrap as your initial view of the current working directory.\n" ++
  "Do not start with list_dir on '.' unless this bootstrap is missing something important.\n" ++
  "Read specific files with tools before proposing changes."
end

function build_request(model: text, messages: a list of a mapping from text to text, force_text: boolean, include_tools: boolean, include_dir_tools: boolean, max_output_tokens: integer, include_vision: boolean): a mapping from text to text
  intent: put model, messages, tools, tool_choice, and token limits into the chat completions request mapping
  let tc: text = if force_text or not include_tools then "none" else "auto" end
  let tools: a list of a mapping from text to text = if include_tools then tool_definitions(include_dir_tools, include_vision) else [] end
  {
    "model": model,
    "messages": messages,
    "tools": tools,
    "tool_choice": tc,
    "max_tokens": max_output_tokens,
    "stream": false
  }
end

function call_api(api_key: text, base_url: text, request_body: a mapping from text to text): a mapping from text to text
  intent: encode request_body as json and post it to base_url chat completions with auth headers
  let headers: a mapping from text to text = {
    "Authorization": "Bearer " ++ api_key,
    "Content-Type": "application/json"
  }
  http_client_post(base_url ++ "/chat/completions", headers, json_encode(request_body))
end

function shell_quote(value: text): text
  intent: concatenate quoted text around value after replace escapes its single quotes
  "'" ++ replace(value, "'", "'\"'\"'") ++ "'"
end

function provider_is_reachable(base_url: text): boolean
  intent: use curl through shell_exec to check whether the provider endpoint is reachable before calling its model
  let url: text = shell_quote(base_url ++ "/models")
  let cmd: text = "if ! command -v curl >/dev/null 2>&1; then exit 0; fi; curl --silent --output /dev/null --connect-timeout 5 --max-time 15 " ++ url
  to_text(get(shell_exec(cmd), "exit_code")) == "0"
end

-- ─── Provider helpers ─────────────────────────────────────────────────────────

function gemini_base_url(): text
  intent: return the Google AI OpenAI-compatible base URL
  "https://generativelanguage.googleapis.com/v1beta/openai"
end

function qwen_base_url(): text
  intent: return the DashScope international OpenAI-compatible base URL
  "https://token-plan.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1"
end

function openrouter_base_url(): text
  intent: return the openrouter.ai api URL string
  "https://openrouter.ai/api/v1"
end

function orcarouter_base_url(): text
  intent: return the api.orcarouter.ai URL string
  "https://api.orcarouter.ai/v1"
end

function nims_base_url(): text
  intent: return the integrate.api.nvidia.com URL string for NIM
  "https://integrate.api.nvidia.com/v1"
end

function is_qwen_url(url: text): boolean
  intent: use contains_text to check if url contains aliyuncs.com
  contains_text(url, "aliyuncs.com")
end

function is_gemini_url(url: text): boolean
  intent: return true when url points to the Google AI Gemini endpoint
  contains_text(url, "generativelanguage.googleapis.com")
end

function is_openrouter_url(url: text): boolean
  intent: return true when url points to the OpenRouter endpoint
  contains_text(url, "openrouter.ai")
end

function is_orcarouter_url(url: text): boolean
  intent: return true when url points to the OrcaRouter endpoint
  contains_text(url, "orcarouter.ai")
end

function is_groq_url(url: text): boolean
  intent: use contains_text to check if url contains groq.com
  contains_text(url, "groq.com")
end

function is_nims_url(url: text): boolean
  intent: return true when url points to the NVIDIA NIM endpoint
  contains_text(url, "integrate.api.nvidia.com")
end

function backend_name(base_url: text): text
  intent: call is_qwen_url, is_gemini_url, is_orcarouter_url, is_nims_url, is_openrouter_url, and is_groq_url to return a label for base_url
  if is_qwen_url(base_url) then "Qwen"
  else if is_gemini_url(base_url) then "Gemini"
  else if is_orcarouter_url(base_url) then "OrcaRouter"
  else if is_nims_url(base_url) then "NIM"
  else if is_openrouter_url(base_url) then "OpenRouter"
  else if is_groq_url(base_url) then "Groq"
  else "LM Studio (" ++ base_url ++ ")"
  end
end

function provider_tier(base_url: text): text
  intent: return qwen gemini orcarouter nims openrouter groq or local based on the base URL for context-window tuning
  if is_qwen_url(base_url) then "qwen"
  else if is_gemini_url(base_url) then "gemini"
  else if is_orcarouter_url(base_url) then "orcarouter"
  else if is_nims_url(base_url) then "nims"
  else if is_openrouter_url(base_url) then "openrouter"
  else if is_groq_url(base_url) then "groq"
  else "local"
  end
end

-- ─── UI helpers ───────────────────────────────────────────────────────────────

function print_banner(model: text, base_url: text): nothing
  intent: print the legible-coder name, model, base_url, and cwd as the startup header
  let backend: text = backend_name(base_url)
  print("")
  print("  legible-coder")
  print("  Interactive Legible coding assistant")
  print("  Model: " ++ model ++ " via " ++ backend)
  print("  ────────────────────────────────────────────")
  let cwd: text = get_cwd()
  print("  cwd: " ++ cwd)
  print("  Type your request, or 'quit' to exit.")
  print("")
end

function print_separator(): nothing
  intent: emit a divider
  print("  ────────────────────────────────────────────")
end

-- ─── Tool call batch execution ────────────────────────────────────────────────

record BatchResult
  messages: a list of a mapping from text to text
  count: integer
  stop: boolean
end

record LoopStep
  messages: a list of a mapping from text to text
  count: integer
  last_batch: text
  waiting: boolean
  must_force_text: boolean
  explore_count: integer
  acted: boolean
end

record InnerLoopResult
  messages: a list of a mapping from text to text
  used_model: boolean
  context_budget: integer
  prompt_tokens: integer
  completion_tokens: integer
end

record TurnResult
  messages: a list of a mapping from text to text
  inner: InnerLoopResult
end

record ProviderLimits
  max_output_tokens: integer
  context_budget: integer
  keep_messages: integer
  compact_after: integer
end

record ManualToolRequest
  valid: boolean
  final: boolean
  name: text
  arguments: text
  final_text: text
end

-- --- Live tool event log (shared by the CLI print path and the web worker) ---

function web_events_path(ws_id: text, conv_id: text): text
  intent: return web_base_dir events ws_id conv_id joined as the jsonl path
  web_base_dir() ++ "/events/" ++ ws_id ++ "--" ++ conv_id ++ ".jsonl"
end

function web_event_sink(): text
  intent: trim the env_get LEGIBLE_CODER_EVENTS_PATH unwrap_or empty text
  trim(unwrap_or(env_get("LEGIBLE_CODER_EVENTS_PATH"), ""))
end

function web_event_emit(event: a mapping from text to text): nothing
  intent: append one json encoded event line to the configured event sink using an atomic shell append
  let path: text = web_event_sink()
  if text_length(path) == 0 then
    skip()
  else
    let line: text = json_encode(event)
    shell_exec("printf '%s\\n' " ++ shell_quote(line) ++ " >> " ++ shell_quote(path))
  end
end

function web_events_reset(ws_id: text, conv_id: text): nothing
  intent: create the events dir then truncate the event log so a new turn starts with an empty cursor
  create_dir(web_base_dir() ++ "/events")
  write_file(web_events_path(ws_id, conv_id), "")
end

function web_events_since(path: text, since: integer): text
  intent: return json holding the events parsed from the lines after since plus the next cursor
  let raw: text = if file_exists(path) then read_file(path) else "" end
  let lines: a list of text = filter(split(raw, "\n"), fn(l: text): boolean => text_length(trim(l)) > 0)
  let kept: a list of text = drop(lines, min(max(since, 0), length(lines)))
  let events: a list of a mapping from text to text = map(filter(kept, fn(l: text): boolean => json_valid(l)), fn(l: text): a mapping from text to text => json_parse(l))
  json_encode({"events": events, "next": length(lines)})
end

function web_query_value(query: text, key: text): text
  intent: split query find the pair with starts_with key then url_decode the substring and trim
  let pairs: a list of text = split(query, "&")
  let hit: an optional text = find(pairs, fn(p: text): boolean => starts_with(p, key ++ "="))
  if is_none(hit) then
    ""
  else
    trim(url_decode(substring(unwrap(hit), text_length(key) + 1, text_length(unwrap(hit)))))
  end
end

function web_turn_lock_path(ws_id: text, conv_id: text): text
  intent: return web_base_dir locks ws_id conv_id joined as the lock path
  web_base_dir() ++ "/locks/" ++ ws_id ++ "--" ++ conv_id ++ ".lock"
end

function web_turn_lock_content(ws_id: text, conv_id: text): text
  intent: return the trimmed turn lock file contents or empty text when no lock file exists
  let path: text = web_turn_lock_path(ws_id, conv_id)
  if file_exists(path) then trim(read_file(path)) else "" end
end

function web_turn_pending_age_ms(content: text): integer
  intent: return the age in ms of a pending lock stamp or minus one when content is not a pending stamp
  if starts_with(content, "pending:") then
    current_time_ms() - unwrap_or(to_integer(substring(content, 8, text_length(content))), 0)
  else
    -1
  end
end

function web_turn_pid_is_live(content: text): boolean
  intent: report whether the pid parsed from content still has a /proc dir
  let pid: integer = unwrap_or(to_integer(content), 0)
  if pid <= 0 then
    false
  else
    is_dir("/proc/" ++ to_text(pid))
  end
end

function web_turn_is_locked(ws_id: text, conv_id: text): boolean
  intent: return false when web_turn_lock_content is empty else use web_turn_pending_age_ms or web_turn_pid_is_live
  let content: text = web_turn_lock_content(ws_id, conv_id)
  if text_length(content) == 0 then
    false
  else
    let pending_age: integer = web_turn_pending_age_ms(content)
    if pending_age >= 0 then
      pending_age < 60000
    else
      web_turn_pid_is_live(content)
    end
  end
end

function web_write_json_atomic(path: text, body: text): nothing
  intent: write_file body to a tmp sibling of path then mv it over path so a reader never sees a torn file
  let tmp: text = path ++ ".tmp"
  write_file(tmp, body)
  shell_exec("mv -f " ++ shell_quote(tmp) ++ " " ++ shell_quote(path))
end

function web_worker_log_path(ws_id: text, conv_id: text): text
  intent: return the per conversation worker log path under web_base_dir
  web_base_dir() ++ "/worker-" ++ ws_id ++ "--" ++ conv_id ++ ".log"
end

function web_turn_lock_acquire(ws_id: text, conv_id: text): nothing
  intent: create the locks dir then write a pending stamp that the spawn command replaces with the worker pid
  create_dir(web_base_dir() ++ "/locks")
  write_file(web_turn_lock_path(ws_id, conv_id), "pending:" ++ to_text(current_time_ms()))
end

function web_worker_lock_release(): nothing
  intent: release the turn lock named by the worker environment so a failing background turn does not stay locked
  let ws_id: text = trim(unwrap_or(env_get("LEGIBLE_CODER_WS_ID"), ""))
  let conv_id: text = trim(unwrap_or(env_get("LEGIBLE_CODER_CONV_ID"), ""))
  if text_length(ws_id) == 0 or text_length(conv_id) == 0 then
    skip()
  else
    web_turn_lock_release(ws_id, conv_id)
  end
end

function web_worker_stamp_own_pid(): nothing
  intent: write the parent pid of this worker into the web_turn_lock_path named by env_get
  let ws_id: text = trim(unwrap_or(env_get("LEGIBLE_CODER_WS_ID"), ""))
  let conv_id: text = trim(unwrap_or(env_get("LEGIBLE_CODER_CONV_ID"), ""))
  if text_length(ws_id) == 0 or text_length(conv_id) == 0 then
    skip()
  else
    shell_exec("printf '%s' $PPID > " ++ shell_quote(web_turn_lock_path(ws_id, conv_id)))
  end
end

function web_turn_lock_release(ws_id: text, conv_id: text): nothing
  intent: remove the turn lock file for this conversation through a shell rm
  shell_exec("rm -f " ++ shell_quote(web_turn_lock_path(ws_id, conv_id)))
end

function web_event_tool_start(n: integer, name: text, arguments: text): nothing
  intent: emit a tool_start event with the call index the tool label and the raw arguments
  web_event_emit({"type": "tool_start", "n": to_text(n), "name": name, "label": describe_tool_call(name, arguments), "arguments": arguments})
end

function web_event_tool_end(n: integer, name: text, raw: text): nothing
  intent: emit a tool_end event with a truncated preview of the tool result
  web_event_emit({"type": "tool_end", "n": to_text(n), "name": name, "result": truncate_tool_output(raw, 3000)})
end

function run_tool_batch(messages: a list of a mapping from text to text, valid_calls: a list of a mapping from text to text, tool_count: integer, max_tools: integer, include_vision: boolean): BatchResult
  intent: execute tool calls, inject vision evaluation message if screenshot was taken, return updated messages
  print("  batch: " ++ to_text(length(valid_calls)) ++ " calls")
  let asst_msg: a mapping from text to text = {"role": "assistant", "content": none, "tool_calls": valid_calls}
  mutable msgs: a list of a mapping from text to text = append(messages, asst_msg)
  mutable n: integer = tool_count
  mutable screenshot_path: text = ""
  for tc in valid_calls do
    let fn_info: a mapping from text to text = get(tc, "function")
    let tc_id: text = unwrap_or(get(tc, "id"), "")
    let fn_name: text = clean_tool_name(get(fn_info, "name"))
    let fn_args: text = normalize_tool_call_arguments(get(fn_info, "arguments"))
    set n = n + 1
    print("  [" ++ to_text(n) ++ "] " ++ describe_tool_call(fn_name, fn_args))
    web_event_tool_start(n, fn_name, fn_args)
    let raw: text = execute_tool(fn_name, fn_args)
    web_event_tool_end(n, fn_name, raw)
    if fn_name == "take_screenshot" and include_vision and file_exists(trim(raw)) then
      set screenshot_path = trim(raw)
    end
    let result: text = if text_length(raw) > 8000 then substring(raw, 0, 8000) ++ "\n... (truncated)" else raw end
    set msgs = append(msgs, {"role": "tool", "tool_call_id": tc_id, "content": result})
  end
  if include_vision and text_length(screenshot_path) > 0 then
    print("  [vision] attaching screenshot for model evaluation]")
    set msgs = append(msgs, build_vision_eval_message(screenshot_path))
  end
  let hit_cap: boolean = n >= max_tools
  if hit_cap then print("  [warn] reached " ++ to_text(max_tools) ++ " tool calls this turn, stopping") end
  BatchResult {messages: msgs, count: n, stop: hit_cap}
end

-- ─── Inner API loop ───────────────────────────────────────────────────────────

function tool_call_arguments_valid(tc: a mapping from text to text): boolean
  intent: get function arguments and use json_valid and starts_with to check for a JSON object
  let arguments: text = get(get(tc, "function"), "arguments")
  json_valid(arguments) and starts_with(trim(arguments), "\{")
end

function filter_valid_calls(all_calls: a list of a mapping from text to text): a list of a mapping from text to text
  intent: keep only tool calls with known names and valid JSON object arguments
  filter(all_calls, fn(tc: a mapping from text to text): boolean => is_known_tool(get(get(tc, "function"), "name")) and tool_call_arguments_valid(tc))
end

function call_fingerprint(tc: a mapping from text to text): text
  intent: normalize a tool call into a stable text key using cleaned function name and raw arguments
  let fn_info: a mapping from text to text = get(tc, "function")
  clean_tool_name(get(fn_info, "name")) ++ "::" ++ trim(get(fn_info, "arguments"))
end

function dedupe_tool_calls(valid_calls: a list of a mapping from text to text): a list of a mapping from text to text
  intent: preserve only the first occurrence of each tool call fingerprint in a response
  mutable seen: a list of text = []
  mutable deduped: a list of a mapping from text to text = []
  for tc in valid_calls do
    let fingerprint: text = call_fingerprint(tc)
    if is_none(find(seen, fn(item: text): boolean => item == fingerprint)) then
      set seen = append(seen, fingerprint)
      set deduped = append(deduped, tc)
    end
  end
  deduped
end

function batch_fingerprint(valid_calls: a list of a mapping from text to text): text
  intent: join all call fingerprints into one batch fingerprint for repeat detection
  join(map(valid_calls, fn(tc: a mapping from text to text): text => call_fingerprint(tc)), "\n")
end

function manual_tool_fingerprint(name: text, arguments: text): text
  intent: join tool name and arguments into one fingerprint text
  name ++ "::" ++ trim(arguments)
end

function truncate_tool_output(raw: text, max_chars: integer): text
  intent: return raw tool output clipped to max_chars with a truncated marker
  if text_length(raw) > max_chars then
    substring(raw, 0, max_chars) ++ "\n... (truncated)"
  else
    raw
  end
end

function mask_old_tool_results(msgs: a list of a mapping from text to text, keep_recent: integer): a list of a mapping from text to text
  intent: iterate msgs and use put to replace content in tool role messages older than keep_recent with a marker string
  let total: integer = length(msgs)
  let mask_before: integer = max(total - keep_recent, 0)
  mutable result: a list of a mapping from text to text = []
  mutable i: integer = 0
  while i < total do
    let msg: a mapping from text to text = get(msgs, i)
    if i < mask_before and get(msg, "role") == "tool" then
      set result = append(result, put(msg, "content", "[tool result removed]"))
    else
      set result = append(result, msg)
    end
    set i = i + 1
  end
  result
end

function strip_old_vision_images(msgs: a list of a mapping from text to text, keep_recent: integer): a list of a mapping from text to text
  intent: replace base64 image data in old vision messages with a compact text marker to free context tokens
  let total: integer = length(msgs)
  let mask_before: integer = max(total - keep_recent, 0)
  mutable result: a list of a mapping from text to text = []
  mutable i: integer = 0
  while i < total do
    let msg: a mapping from text to text = get(msgs, i)
    let is_vision: boolean = get(msg, "role") == "user" and contains_text(kv_cache.msg_content_text(msg), "image_url")
    if i < mask_before and is_vision then
      set result = append(result, put(msg, "content", "[screenshot evaluated — image removed from context]"))
    else
      set result = append(result, msg)
    end
    set i = i + 1
  end
  result
end

function prune_local_messages(msgs: a list of a mapping from text to text): a list of a mapping from text to text
  intent: strip old vision images, mask old tool results, then compact context for local mode
  let keep: integer = resolve_context_keep_messages("local")
  let stripped: a list of a mapping from text to text = strip_old_vision_images(msgs, 2)
  let masked: a list of a mapping from text to text = mask_old_tool_results(stripped, keep * 2)
  kv_cache.enhanced_compact_context(masked, resolve_context_budget("local"), keep)
end

function seen_tool_for_path(msgs: a list of a mapping from text to text, tool_name: text, path: text): boolean
  intent: return true when prior local messages already contain a tool result line for tool_name and path
  is_some(find(msgs, fn(msg: a mapping from text to text): boolean => contains_text(kv_cache.msg_content_text(msg), "Tool result for " ++ tool_name) and contains_text(kv_cache.msg_content_text(msg), "\"path\":\"" ++ path ++ "\"")))
end

function seen_manual_tool_request(msgs: a list of a mapping from text to text, name: text, arguments: text): boolean
  intent: return true when prior local messages already contain the same tool name and exact arguments
  let marker: text = "Tool result for " ++ to_text(name) ++ " " ++ to_text(arguments) ++ ":"
  is_some(find(msgs, fn(msg: a mapping from text to text): boolean => contains_text(kv_cache.msg_content_text(msg), marker)))
end

function json_escape_text(content: text): text
  intent: let slashed be replace content backslash then replace slashed double quote for JSON text
  let slashed: text = replace(content, "\\", "\\\\")
  replace(slashed, "\"", "\\\"")
end

function trim_manual_tool_blob(blob: text): text
  intent: trim tool blob text before any angle bracket marker or pipe marker
  let lt: integer = unwrap_or(index_of(blob, "<"), -1)
  let pipe: integer = unwrap_or(index_of(blob, "|"), -1)
  if lt >= 0 and pipe >= 0 then
    trim(substring(blob, 0, min(lt, pipe)))
  else if lt >= 0 then
    trim(substring(blob, 0, lt))
  else if pipe >= 0 then
    trim(substring(blob, 0, pipe))
  else
    trim(blob)
  end
end

function recover_single_quoted_argument(raw_args: text, key: text): text
  intent: find key colon single-quoted text and return one JSON object for that key
  let marker: text = key ++ ":"
  let start: integer = unwrap_or(index_of(raw_args, marker), -1)
  if start >= 0 then
    let after: text = trim(substring(raw_args, start + text_length(marker), text_length(raw_args) - start - text_length(marker)))
    let first_quote: integer = unwrap_or(index_of(after, "'"), -1)
    if first_quote >= 0 then
      let tail: text = substring(after, first_quote + 1, text_length(after) - first_quote - 1)
      let second_quote: integer = unwrap_or(index_of(tail, "'"), -1)
      if second_quote >= 0 then
        "\{\"" ++ key ++ "\":\"" ++ json_escape_text(substring(tail, 0, second_quote)) ++ "\"\}"
      else
        raw_args
      end
    else
      raw_args
    end
  else
    raw_args
  end
end

function normalize_manual_arguments(name: text, raw_args: text): text
  intent: normalize malformed local tool arguments into JSON when possible
  let cleaned: text = trim_manual_tool_blob(trim(raw_args))
  if json_valid(cleaned) and starts_with(cleaned, "\{") then
    cleaned
  else if name == "shell_exec" then
    recover_single_quoted_argument(cleaned, "arguments")
    |> fn(result: text): text => if json_valid(result) then result else recover_single_quoted_argument(cleaned, "command") end
  else if name == "read_file" or name == "list_dir" or name == "read_dir_recursive" then
    recover_single_quoted_argument(cleaned, "path")
  else
    cleaned
  end
end

function normalize_read_file_lines_arguments(arguments: text): text
  intent: normalize read_file_lines to a 1-based start line and a fixed 40-line window
  let args: a mapping from text to text = json_parse(arguments)
  let path: text = unwrap_or(get(args, "path"), "")
  let start_line: integer = max(to_integer(unwrap_or(get(args, "start_line"), "1")), 1)
  json_encode({
    "path": path,
    "start_line": to_text(start_line),
    "line_count": "40"
  })
end

function parse_manual_tool_request(content: text): ManualToolRequest
  intent: parse local-model TOOL and FINAL responses from plain text content
  let trimmed: text = trim(content)
  let lines: a list of text = split(trimmed, "\n")
  let tool_line: an optional text = find(lines, fn(line: text): boolean => starts_with(trim(line), "TOOL "))
  let final_line: an optional text = find(lines, fn(line: text): boolean => starts_with(trim(line), "FINAL:"))
  if is_some(tool_line) then
    let line: text = trim(unwrap(tool_line))
    let rest: text = trim_manual_tool_blob(trim(substring(line, 5, text_length(line) - 5)))
    let brace: integer = unwrap_or(index_of(rest, "\{"), -1)
    let space: integer = unwrap_or(index_of(rest, " "), -1)
    if brace > 0 then
      let name: text = trim(substring(rest, 0, brace))
      let normalized: text = normalize_manual_arguments(clean_tool_name(name), substring(rest, brace, text_length(rest) - brace))
      let arguments: text = if clean_tool_name(name) == "read_file_lines" and json_valid(normalized) then normalize_read_file_lines_arguments(normalized) else normalized end
      let valid: boolean = is_local_known_tool(name) and json_valid(arguments) and starts_with(arguments, "\{")
      ManualToolRequest {valid: valid, final: false, name: clean_tool_name(name), arguments: arguments, final_text: ""}
    else if space > 0 then
      let name: text = trim(substring(rest, 0, space))
      let normalized: text = normalize_manual_arguments(clean_tool_name(name), substring(rest, space + 1, text_length(rest) - space - 1))
      let arguments: text = if clean_tool_name(name) == "read_file_lines" and json_valid(normalized) then normalize_read_file_lines_arguments(normalized) else normalized end
      let valid: boolean = is_local_known_tool(name) and json_valid(arguments) and starts_with(arguments, "\{")
      ManualToolRequest {valid: valid, final: false, name: clean_tool_name(name), arguments: arguments, final_text: ""}
    else
      ManualToolRequest {valid: false, final: false, name: "", arguments: "", final_text: trimmed}
    end
  else if is_some(final_line) then
    let line: text = trim(unwrap(final_line))
    ManualToolRequest {valid: false, final: true, name: "", arguments: "", final_text: trim(substring(line, 6, text_length(line) - 6))}
  else
    ManualToolRequest {valid: false, final: false, name: "", arguments: "", final_text: trimmed}
  end
end

function local_manual_retry(msgs: a list of a mapping from text to text, content: text, total_tools: integer, last_batch: text, explore_count: integer, acted: boolean): LoopStep
  intent: append assistant content and a strict-format reminder when the local model ignores the protocol
  print("  [warn] local model returned a malformed TOOL/FINAL response; retrying with format reminder]")
  if length(msgs) > 5 then print("  [context] pruning local retry history]") end
  let disallow_full_read: text = if contains_text(content, "TOOL read_file ") then "\nDo not use read_file in local mode. Use read_file_lines with path, start_line, and line_count." else "" end
  if local_needs_action(explore_count, acted) then
    local_action_retry_step(msgs, total_tools, last_batch, explore_count, acted)
  else
    LoopStep {
      messages: prune_local_messages(append(msgs, {"role": "user", "content": "Your last reply did not follow the required format. Reply in exactly one of these formats only:\nTOOL tool_name JSON_arguments\nFINAL: your answer\nValid local tools: read_file_lines, write_file, list_dir, read_dir_recursive, grep, shell_exec, web_search." ++ disallow_full_read})),
      count: total_tools,
      last_batch: last_batch,
      waiting: true,
      must_force_text: false,
      explore_count: explore_count,
      acted: acted
    }
  end
end

function local_manual_final(msgs: a list of a mapping from text to text, final_text: text, total_tools: integer, last_batch: text, explore_count: integer, acted: boolean): LoopStep
  intent: finish the local manual-tool loop by printing the final text answer
  if local_needs_action(explore_count, acted) then
    print("  [warn] local model stopped before acting; requiring write_file, shell_exec, or blocker]")
    local_action_retry_step(msgs, total_tools, last_batch, explore_count, acted)
  else
    let final_msg: a mapping from text to text = {"content": final_text}
    LoopStep {
      messages: handle_text_response(final_msg, msgs),
      count: total_tools,
      last_batch: last_batch,
      waiting: false,
      must_force_text: false,
      explore_count: explore_count,
      acted: acted
    }
  end
end

function local_repeat_hint(req: ManualToolRequest, has_partial_read: boolean): text
  intent: build the retry hint text for repeated read_file_lines grep or other tool requests
  if req.name == "read_file" then
    if has_partial_read then
      "You already read that file and also fetched line ranges from it. Do not repeat read_file. Continue with FINAL: your answer, or request a new non-overlapping read_file_lines range."
    else
      "You already read that whole file. Do not repeat read_file. If you need more detail, use read_file_lines with path, start_line, and line_count instead, for example TOOL read_file_lines " ++ to_text(req.arguments) ++ " plus a start_line and line_count."
    end
  else if req.name == "read_file_lines" then
    "You already requested that exact file range and received it. Do not repeat the same range. Either request a different non-overlapping read_file_lines range or reply with FINAL: your answer."
  else if req.name == "grep" then
    "You already ran that exact grep and received its result. Do not repeat it. Read a relevant file slice or reply with FINAL: your answer."
  else
    "You already requested that tool and received its result. Do not repeat it. Reply with FINAL: and your answer."
  end
end

function bootstrap_listing_hint(): text
  intent: tell the local model to use the bootstrap project tree instead of list_dir on dot
  "The LOCAL MODEL BOOTSTRAP already includes the current project tree. Do not call list_dir on '.'. Use the bootstrap, inspect a relevant file directly, or use list_dir/read_dir_recursive on a more specific path."
end

function is_bootstrap_listing(req: ManualToolRequest): boolean
  intent: return true when req is list_dir on the current working directory
  req.name == "list_dir" and unwrap_or(get(json_parse(req.arguments), "path"), "") == "."
end

function skip_bootstrap_listing_step(msgs: a list of a mapping from text to text, total_tools: integer, fingerprint: text, explore_count: integer, acted: boolean): LoopStep
  intent: skip redundant list_dir on dot because the bootstrap already includes the project tree
  print("  [warn] bootstrap already covers '.', skipping list_dir]")
  LoopStep {
    messages: append(msgs, {"role": "user", "content": bootstrap_listing_hint()}),
    count: total_tools,
    last_batch: fingerprint,
    waiting: true,
    must_force_text: false,
    explore_count: explore_count,
    acted: acted
  }
end

function advance_read_file_lines_request(req: ManualToolRequest): ManualToolRequest
  intent: increment read_file_lines start_line by 40 and keep the same path
  let args: a mapping from text to text = json_parse(req.arguments)
  let next_start: integer = max(to_integer(unwrap_or(get(args, "start_line"), "1")), 1) + 40
  let next_args: text = json_encode({
    "path": unwrap_or(get(args, "path"), ""),
    "start_line": to_text(next_start),
    "line_count": "40"
  })
  ManualToolRequest {
    valid: true,
    final: false,
    name: req.name,
    arguments: next_args,
    final_text: req.final_text
  }
end

function is_exploration_tool(name: text): boolean
  intent: return true for read_file_lines list_dir read_dir_recursive or grep
  name == "read_file_lines" or name == "list_dir" or name == "read_dir_recursive" or name == "grep"
end

function is_action_tool(name: text): boolean
  intent: return true for write_file or shell_exec
  name == "write_file" or name == "shell_exec"
end

function shell_command_text(req: ManualToolRequest): text
  intent: return the lowercase trimmed shell_exec command text or empty text for other tools
  if req.name == "shell_exec" then
    lowercase(trim(unwrap_or(get(json_parse(req.arguments), "command"), "")))
  else
    ""
  end
end

function is_exploration_shell_command(command: text): boolean
  intent: return true for shell commands starting with cat ls find grep rg sed head tail tree wc awk or fd
  starts_with(command, "cat ") or starts_with(command, "ls") or starts_with(command, "find ") or starts_with(command, "grep ") or starts_with(command, "rg ") or starts_with(command, "sed ") or starts_with(command, "head ") or starts_with(command, "tail ") or starts_with(command, "tree") or starts_with(command, "wc ") or starts_with(command, "awk ") or starts_with(command, "fd ")
end

function is_exploration_request(req: ManualToolRequest): boolean
  intent: return true for exploration tools and shell_exec commands that inspect files or text
  is_exploration_tool(req.name) or (req.name == "shell_exec" and is_exploration_shell_command(shell_command_text(req)))
end

function is_action_request(req: ManualToolRequest): boolean
  intent: return true for write_file and for shell_exec commands that run check build run or test work
  req.name == "write_file" or (req.name == "shell_exec" and not is_exploration_shell_command(shell_command_text(req)))
end

function resolve_local_explore_budget(): integer
  intent: read LEGIBLE_CODER_MAX_EXPLORE or use default 8 for the local exploration budget
  let raw: text = unwrap_or(env_get("LEGIBLE_CODER_MAX_EXPLORE"), "8")
  max(to_integer(raw), 1)
end

function local_needs_action(explore_count: integer, acted: boolean): boolean
  intent: return true when explore_count reached resolve_local_explore_budget and acted is false
  not acted and explore_count >= resolve_local_explore_budget()
end

function local_action_prompt(): text
  intent: return the exact write_file shell_exec or FINAL blocked prompt for local action mode
  "Exploration budget reached. Do not continue with read_file_lines, list_dir, read_dir_recursive, or grep.\n" ++
  "Assume the current context is enough for a first implementation attempt.\n" ++
  "Your next reply is invalid unless it is exactly one of these formats:\n" ++
  "TOOL write_file JSON_arguments\n" ++
  "TOOL shell_exec JSON_arguments  -- only for checking, building, running, or testing code\n" ++
  "FINAL: blocked because you need one specific missing file path or 40-line range\n" ++
  "Do not use shell_exec to read files or list directories.\n" ++
  "Commands like cat, ls, find, grep, rg, sed, head, or tail are invalid here.\n" ++
  "Do not answer with prose, plans, or more exploratory tools."
end

function local_action_retry_step(msgs: a list of a mapping from text to text, total_tools: integer, last_batch: text, explore_count: integer, acted: boolean): LoopStep
  intent: continue the local loop while requiring an action or blocker after too much exploration
  print("  [warn] local exploration budget reached; requiring write_file, shell_exec, or blocker]")
  LoopStep {
    messages: prune_local_messages(append(msgs, {"role": "user", "content": local_action_prompt()})),
    count: total_tools,
    last_batch: last_batch,
    waiting: true,
    must_force_text: false,
    explore_count: explore_count,
    acted: acted
  }
end

function execute_local_manual_tool(msgs: a list of a mapping from text to text, req: ManualToolRequest, advanced_range: boolean, total_tools: integer, max_tools: integer, fingerprint: text, explore_count: integer, acted: boolean): LoopStep
  intent: execute one local tool request and update exploration and action state
  let next_count: integer = total_tools + 1
  let next_explore_count: integer = if is_exploration_request(req) then explore_count + 1 else explore_count end
  let next_acted: boolean = acted or is_action_request(req)
  if advanced_range then print("  [warn] advancing repeated read_file_lines request to the next 40-line window]") end
  print("  [" ++ to_text(next_count) ++ "] " ++ describe_tool_call(req.name, req.arguments))
  web_event_tool_start(next_count, req.name, req.arguments)
  let raw: text = execute_tool(req.name, req.arguments)
  web_event_tool_end(next_count, req.name, raw)
  let result: text = truncate_tool_output(to_text(raw), 2000)
  if length(msgs) > 5 then print("  [context] pruning local tool history]") end
  let next_msgs: a list of a mapping from text to text = prune_local_messages(append(msgs, {"role": "user", "content": "Tool result for " ++ to_text(req.name) ++ " " ++ to_text(req.arguments) ++ ":\n" ++ to_text(result) ++ "\n\nReply with one TOOL line if you need one more tool, or FINAL: followed by your answer."}))
  if next_count >= max_tools then print("  [warn] reached " ++ to_text(max_tools) ++ " local tool calls this turn, stopping]") end
  LoopStep {
    messages: next_msgs,
    count: next_count,
    last_batch: fingerprint,
    waiting: next_count < max_tools,
    must_force_text: false,
    explore_count: next_explore_count,
    acted: next_acted
  }
end

function local_manual_tool_step(msgs: a list of a mapping from text to text, content: text, req: ManualToolRequest, total_tools: integer, max_tools: integer, last_batch: text, explore_count: integer, acted: boolean): LoopStep
  intent: execute one manual tool request or reject an immediate repeat
  let adjusted_req: ManualToolRequest = if req.name == "read_file_lines" and seen_manual_tool_request(msgs, req.name, req.arguments) then advance_read_file_lines_request(req) else req end
  let fingerprint: text = manual_tool_fingerprint(adjusted_req.name, adjusted_req.arguments)
  let req_path: text = if adjusted_req.name == "read_file" or adjusted_req.name == "read_file_lines" then unwrap_or(get(json_parse(adjusted_req.arguments), "path"), "") else "" end
  let repeated_full_read: boolean = adjusted_req.name == "read_file" and text_length(req_path) > 0 and seen_tool_for_path(msgs, "read_file", req_path)
  let has_partial_read: boolean = adjusted_req.name == "read_file" and text_length(req_path) > 0 and seen_tool_for_path(msgs, "read_file_lines", req_path)
  let repeated_request: boolean = adjusted_req.name != "read_file_lines" and seen_manual_tool_request(msgs, adjusted_req.name, adjusted_req.arguments)
  if is_bootstrap_listing(adjusted_req) then
    skip_bootstrap_listing_step(msgs, total_tools, fingerprint, explore_count, acted)
  else if is_exploration_request(adjusted_req) and local_needs_action(explore_count, acted) then
    local_action_retry_step(msgs, total_tools, last_batch, explore_count, acted)
  else if fingerprint == last_batch or repeated_full_read or repeated_request then
    print("  [warn] model repeated the same manual tool request; forcing final answer]")
    let repeat_hint: text = local_repeat_hint(adjusted_req, has_partial_read)
    LoopStep {
      messages: append(msgs, {"role": "user", "content": repeat_hint}),
      count: total_tools,
      last_batch: last_batch,
      waiting: true,
      must_force_text: false,
      explore_count: explore_count,
      acted: acted
    }
  else
    execute_local_manual_tool(msgs, adjusted_req, adjusted_req.arguments != req.arguments, total_tools, max_tools, fingerprint, explore_count, acted)
  end
end

function handle_local_text_round(msg: a mapping from text to text, msgs: a list of a mapping from text to text, total_tools: integer, max_tools: integer, last_batch: text, explore_count: integer, acted: boolean): LoopStep
  intent: process one local-model text response and optionally execute one manual tool request
  let content: text = unwrap_or(get(msg, "content"), "")
  let req: ManualToolRequest = parse_manual_tool_request(content)
  if req.valid then
    local_manual_tool_step(msgs, content, req, total_tools, max_tools, last_batch, explore_count, acted)
  else if req.final then
    local_manual_final(msgs, req.final_text, total_tools, last_batch, explore_count, acted)
  else
    local_manual_retry(msgs, content, total_tools, last_batch, explore_count, acted)
  end
end

function prompt_loop_step(msgs: a list of a mapping from text to text, total_tools: integer, last_batch: text, prompt: text, must_force_text: boolean, explore_count: integer, acted: boolean): LoopStep
  intent: append a user follow-up prompt and continue the loop with updated forcing state
  LoopStep {
    messages: append(msgs, {"role": "user", "content": prompt}),
    count: total_tools,
    last_batch: last_batch,
    waiting: true,
    must_force_text: must_force_text,
    explore_count: explore_count,
    acted: acted
  }
end

function handle_tool_round(msg: a mapping from text to text, msgs: a list of a mapping from text to text, total_tools: integer, max_tools: integer, last_batch: text, round: integer, force_text: boolean, explore_count: integer, acted: boolean, include_vision: boolean): LoopStep
  intent: process one tool-calling response and decide whether the loop should continue
  if force_text then
    print("  [round " ++ to_text(round) ++ " - forcing text response]")
    prompt_loop_step(msgs, total_tools, last_batch, "STOP calling tools. Provide your answer as plain text NOW.", false, explore_count, acted)
  else
    let valid_calls: a list of a mapping from text to text = dedupe_tool_calls(filter_valid_calls(unwrap_or(get(msg, "tool_calls"), [])))
    let current_batch: text = batch_fingerprint(valid_calls)
    if length(valid_calls) > 0 and current_batch != last_batch then
      let batch: BatchResult = run_tool_batch(msgs, valid_calls, total_tools, max_tools, include_vision)
      LoopStep {
        messages: batch.messages,
        count: batch.count,
        last_batch: current_batch,
        waiting: not batch.stop,
        must_force_text: false,
        explore_count: explore_count,
        acted: true
      }
    else if length(valid_calls) > 0 then
      print("  [warn] model repeated the same tool batch; forcing text response]")
      prompt_loop_step(msgs, total_tools, last_batch, "You already called those tools and have their results. Do not call them again. Answer using the existing tool outputs.", true, explore_count, acted)
    else
      print("  [warn] model returned invalid tool calls; forcing text response]")
      prompt_loop_step(msgs, total_tools, last_batch, "Your previous tool call was invalid. Do not call tools again. Answer in plain text or fix the tool call format.", true, explore_count, acted)
    end
  end
end

function handle_incomplete_tool_calls(msgs: a list of a mapping from text to text, total_tools: integer, last_batch: text, explore_count: integer, acted: boolean): LoopStep
  intent: reject incomplete tool arguments and ask the model to retry with a smaller operation
  print("  [warn] incomplete tool call was not executed; asking for a smaller edit")
  prompt_loop_step(msgs, total_tools, last_batch, "Your tool call arguments were incomplete and were not executed. Retry the same operation using one smaller tool call. For a large existing file, use shell_exec to apply a focused patch instead of sending the entire file. Split an intrinsically large operation across multiple calls.", false, explore_count, acted)
end

function handle_length_finish(msg: a mapping from text to text, msgs: a list of a mapping from text to text, total_tools: integer, last_batch: text, explore_count: integer, acted: boolean): LoopStep
  intent: preserve partial text and request continuation after a length-truncated response
  let content: text = unwrap_or(get(msg, "content"), "")
  print("  [warn] response truncated by token limit (finish_reason=length)")
  if text_length(content) > 0 then
    let with_partial: a list of a mapping from text to text = append(msgs, {"role": "assistant", "content": content})
    LoopStep {
      messages: append(with_partial, {"role": "user", "content": "Your response was cut off. Please continue from exactly where you stopped."}),
      count: total_tools,
      last_batch: last_batch,
      waiting: true,
      must_force_text: false,
      explore_count: explore_count,
      acted: acted
    }
  else
    LoopStep {
      messages: append(msgs, {"role": "user", "content": "Context is full. Please answer concisely in plain text without calling any tools."}),
      count: total_tools,
      last_batch: last_batch,
      waiting: true,
      must_force_text: true,
      explore_count: explore_count,
      acted: acted
    }
  end
end

function handle_text_response(msg: a mapping from text to text, msgs: a list of a mapping from text to text): a list of a mapping from text to text
  intent: print content between separators, emit it as a final event, and append it to msgs as an assistant message
  let content: text = unwrap_or(get(msg, "content"), "")
  if text_length(content) > 0 then
    print("")
    print_separator()
    print(content)
    print_separator()
    print("")
    web_event_emit({"type": "final", "text": content})
    append(msgs, {"role": "assistant", "content": content})
  else
    msgs
  end
end

function empty_response_detail(resp_body: text): text
  intent: trim resp_body into flat and use substring to keep 500 characters marked truncated when its text_length exceeds 500
  let flat: text = trim(resp_body)
  if text_length(flat) > 500 then
    substring(flat, 0, 500) ++ "... (truncated)"
  else
    flat
  end
end

function handle_empty_text_response(resp_body: text, finish: text, msgs: a list of a mapping from text to text, total_tools: integer, last_batch: text, force_text: boolean, explore_count: integer, acted: boolean): LoopStep
  intent: ask once for a plain-text answer when the model returns empty content, then report an explicit diagnostic instead of stopping silently
  if not force_text then
    print("  [warn] model returned status 200 with empty text (finish_reason=" ++ finish ++ "); asking once for a plain-text answer]")
    LoopStep {
      messages: append(msgs, {"role": "user", "content": "Your last response contained no text at all. Do not call any tools. Write your complete answer as plain text now."}),
      count: total_tools,
      last_batch: last_batch,
      waiting: true,
      must_force_text: true,
      explore_count: explore_count,
      acted: acted
    }
  else
    print("")
    print_separator()
    print("  [error] the model returned status 200 but no assistant text (finish_reason=" ++ finish ++ ").")
    print("  response body: " ++ empty_response_detail(resp_body))
    print_separator()
    print("")
    LoopStep {
      messages: msgs,
      count: total_tools,
      last_batch: last_batch,
      waiting: false,
      must_force_text: false,
      explore_count: explore_count,
      acted: acted
    }
  end
end

function terminal_loop_step(msgs: a list of a mapping from text to text, total_tools: integer, last_batch: text, explore_count: integer, acted: boolean): LoopStep
  intent: return a LoopStep that stops the current response loop
  LoopStep {
    messages: msgs,
    count: total_tools,
    last_batch: last_batch,
    waiting: false,
    must_force_text: false,
    explore_count: explore_count,
    acted: acted
  }
end

function textual_tool_retry_marker(): text
  intent: return the textual tool retry marker
  "__textual_tool_call_retry__"
end

function line_is_textual_tool_call(line: text): boolean
  intent: detect a manual TOOL line or a supported tool name followed by an opening parenthesis
  let value: text = trim(line)
  starts_with(value, "TOOL ") or
  starts_with(value, "read_file(") or starts_with(value, "read_file_lines(") or
  starts_with(value, "write_file(") or starts_with(value, "shell_exec(") or
  starts_with(value, "list_dir(") or starts_with(value, "read_dir_recursive(") or
  starts_with(value, "grep(") or starts_with(value, "take_screenshot(")
end

function looks_like_textual_tool_call(content: text): boolean
  intent: split model content into lines and find a line that looks like a printed tool invocation
  is_some(find(split(content, "\n"), fn(line: text): boolean => line_is_textual_tool_call(line)))
end

function handle_textual_tool_call_response(content: text, msgs: a list of a mapping from text to text, total_tools: integer, last_batch: text, explore_count: integer, acted: boolean): LoopStep
  intent: retry one cloud response that printed a tool call and then force plain text if the retry is also textual
  let with_response: a list of a mapping from text to text = append(msgs, {"role": "assistant", "content": content})
  if last_batch == textual_tool_retry_marker() then
    print("  [warn] model printed a tool invocation again; forcing a plain-text answer]")
    LoopStep {
      messages: append(with_response, {"role": "user", "content": "The printed tool invocation was not executed. Do not print or call tools now. Give a concise plain-text answer explaining that the requested action was not completed."}),
      count: total_tools,
      last_batch: last_batch,
      waiting: true,
      must_force_text: true,
      explore_count: explore_count,
      acted: acted
    }
  else
    print("  [warn] model printed a tool invocation instead of calling it; retrying once]")
    LoopStep {
      messages: append(with_response, {"role": "user", "content": "Your previous response printed a tool invocation as text, so it was not executed. Resend that operation now using the registered native tool schema. Do not include prose or a code fence."}),
      count: total_tools,
      last_batch: textual_tool_retry_marker(),
      waiting: true,
      must_force_text: false,
      explore_count: explore_count,
      acted: acted
    }
  end
end

function handle_success_response(resp_body: text, include_tools: boolean, msgs: a list of a mapping from text to text, total_tools: integer, max_tools: integer, last_batch: text, round: integer, force_text: boolean, explore_count: integer, acted: boolean, include_vision: boolean): LoopStep
  intent: process a successful API response and return the next loop state
  if not json_valid(resp_body) or not starts_with(trim(resp_body), "\{") then
    print("  API error: non-JSON response body")
    terminal_loop_step(msgs, total_tools, last_batch, explore_count, acted)
  else
    let parsed: a mapping from text to text = json_parse(resp_body)
    if not has_key(parsed, "choices") or length(get(parsed, "choices")) == 0 then
      print("  API error: no choices in response: " ++ extract_error_message(resp_body))
      terminal_loop_step(msgs, total_tools, last_batch, explore_count, acted)
    else
      let choice: a mapping from text to text = get(get(parsed, "choices"), 0)
      let msg: a mapping from text to text = get(choice, "message")
      let finish: text = unwrap_or(get(choice, "finish_reason"), "stop")
      let returned_calls: a list of a mapping from text to text = unwrap_or(get(msg, "tool_calls"), [])
      if not include_tools then
        handle_local_text_round(msg, msgs, total_tools, max_tools, last_batch, explore_count, acted)
      else if length(returned_calls) > 0 and length(filter(returned_calls, fn(tc: a mapping from text to text): boolean => tool_call_arguments_valid(tc))) != length(returned_calls) then
        handle_incomplete_tool_calls(msgs, total_tools, last_batch, explore_count, acted)
      else if finish == "tool_calls" or length(filter_valid_calls(returned_calls)) > 0 then
        handle_tool_round(msg, msgs, total_tools, max_tools, last_batch, round, force_text, explore_count, acted, include_vision)
      else if finish == "length" then
        handle_length_finish(msg, msgs, total_tools, last_batch, explore_count, acted)
      else if not force_text and not acted and looks_like_textual_tool_call(unwrap_or(get(msg, "content"), "")) then
        handle_textual_tool_call_response(unwrap_or(get(msg, "content"), ""), msgs, total_tools, last_batch, explore_count, acted)
      else if text_length(unwrap_or(get(msg, "content"), "")) == 0 then
        handle_empty_text_response(resp_body, finish, msgs, total_tools, last_batch, force_text, explore_count, acted)
      else
        LoopStep {
          messages: handle_text_response(msg, msgs),
          count: total_tools,
          last_batch: last_batch,
          waiting: false,
          must_force_text: false,
          explore_count: explore_count,
          acted: acted
        }
      end
    end
  end
end

function compact_loop_messages(msgs: a list of a mapping from text to text, context_budget: integer, preserve_recent_messages: integer, compact_after: integer): a list of a mapping from text to text
  intent: leave the transcript untouched below the compact_after floor, then mask old tool results, strip old vision images, and compact when tokens exceed the context budget
  let tokens_before: integer = kv_cache.estimate_messages_tokens(msgs)
  if tokens_before < compact_after then
    msgs
  else
    let stripped: a list of a mapping from text to text = strip_old_vision_images(msgs, 2)
    let masked: a list of a mapping from text to text = mask_old_tool_results(stripped, preserve_recent_messages * 2)
    let compacted: a list of a mapping from text to text = kv_cache.enhanced_compact_context(masked, context_budget, preserve_recent_messages)
    let tokens_after: integer = kv_cache.estimate_messages_tokens(compacted)
    kv_cache.print_compaction_diagnostics(tokens_before, tokens_after, context_budget)
    compacted
  end
end

function finish_inner_loop(msgs: a list of a mapping from text to text, messages_start: integer, last_is_assistant_text: boolean): a list of a mapping from text to text
  intent: warn and append a placeholder assistant message when a changed turn has no assistant text
  if length(msgs) > messages_start and not last_is_assistant_text then
    print("  [warn] this turn ended without an assistant reply; see the diagnostics above]")
    append(msgs, {"role": "assistant", "content": "(no answer text was produced for this turn)"})
  else
    msgs
  end
end

function last_message_is_assistant_text(msgs: a list of a mapping from text to text): boolean
  intent: get the last_msg from msgs and check its role is assistant and the text_length of its content is greater than 0
  if length(msgs) == 0 then
    false
  else
    let last_msg: a mapping from text to text = get(msgs, length(msgs) - 1)
    unwrap_or(get(last_msg, "role"), "") == "assistant" and text_length(unwrap_or(get(last_msg, "content"), "")) > 0
  end
end

record ApiRoundOutcome
  messages: a list of a mapping from text to text
  used_model: boolean
  total_tools: integer
  last_batch: text
  waiting: boolean
  must_force_text: boolean
  explore_count: integer
  acted: boolean
  prompt_tokens: integer
  completion_tokens: integer
end

function response_usage_counts(body: text, track_usage: boolean): a list of integer
  intent: return prompt and completion token counts parsed from body when track_usage is set else zeros
  if not track_usage or not json_valid(body) then
    [0, 0]
  else
    let parsed: a mapping from text to text = json_parse(body)
    [usage_field_number(parsed, "prompt_tokens"), usage_field_number(parsed, "completion_tokens")]
  end
end

function process_api_round(resp: a mapping from text to text, msgs: a list of a mapping from text to text, messages_start: integer, round: integer, include_tools: boolean, total_tools: integer, max_tools: integer, last_batch: text, force_text: boolean, explore_count: integer, acted: boolean, include_vision: boolean, track_usage: boolean): ApiRoundOutcome
  intent: print the round status then return an ApiRoundOutcome taking messages on error else via response_usage_counts and handle_success_response
  let status: text = get(resp, "status")
  print("  [" ++ to_text(round) ++ "] status=" ++ status)
  if status != "200" then
    print("  API error: " ++ extract_error_message(get(resp, "body")))
    ApiRoundOutcome {messages: take(msgs, messages_start), used_model: false, total_tools: total_tools, last_batch: last_batch, waiting: false, must_force_text: false, explore_count: explore_count, acted: acted, prompt_tokens: 0, completion_tokens: 0}
  else
    let counts: a list of integer = response_usage_counts(get(resp, "body"), track_usage)
    let step: LoopStep = handle_success_response(get(resp, "body"), include_tools, msgs, total_tools, max_tools, last_batch, round, force_text, explore_count, acted, include_vision)
    ApiRoundOutcome {messages: step.messages, used_model: true, total_tools: step.count, last_batch: step.last_batch, waiting: step.waiting, must_force_text: step.must_force_text, explore_count: step.explore_count, acted: step.acted, prompt_tokens: get(counts, 0), completion_tokens: get(counts, 1)}
  end
end

function usage_field_number(parsed: a mapping from text to text, field: text): integer
  intent: read a numeric usage field from the parsed api response defaulting to zero
  let usage: a mapping from text to text = unwrap_or(get(parsed, "usage"), {})
  if has_key(usage, field) then
    unwrap_or(to_integer(trim(to_text(get(usage, field)))), 0)
  else
    0
  end
end

function run_inner_loop(init_messages: a list of a mapping from text to text, messages_start: integer, key: text, base_url: text, model: text, max_tools: integer, include_tools: boolean, include_dir_tools: boolean, max_output_tokens: integer, context_budget: integer, preserve_recent_messages: integer, compact_after: integer, include_vision: boolean, track_usage: boolean): InnerLoopResult
  intent: call the API in a loop executing tool calls and return messages plus whether the model was used successfully and token usage when track_usage is set
  mutable msgs: a list of a mapping from text to text = init_messages
  mutable waiting: boolean = true
  mutable used_model: boolean = false
  mutable round: integer = 0
  mutable total_tools: integer = 0
  mutable last_batch: text = ""
  mutable must_force_text: boolean = false
  mutable explore_count: integer = 0
  mutable acted: boolean = false
  mutable session_prompt: integer = 0
  mutable session_completion: integer = 0
  let round_cap: integer = if include_tools then max_tools else 999999 end
  while waiting do
    set round = round + 1
    let force_text: boolean = if include_tools then must_force_text or round > max_tools / 2 else false end
    set must_force_text = false
    set msgs = compact_loop_messages(msgs, context_budget, preserve_recent_messages, compact_after)
    let resp: a mapping from text to text = call_api(key, base_url, build_request(model, msgs, force_text, include_tools, include_dir_tools, max_output_tokens, include_vision))
    let outcome: ApiRoundOutcome = process_api_round(resp, msgs, messages_start, round, include_tools, total_tools, max_tools, last_batch, force_text, explore_count, acted, include_vision, track_usage)
    set msgs = outcome.messages
    set used_model = outcome.used_model
    set total_tools = outcome.total_tools
    set last_batch = outcome.last_batch
    set waiting = outcome.waiting
    set must_force_text = outcome.must_force_text
    set explore_count = outcome.explore_count
    set acted = outcome.acted
    set session_prompt = session_prompt + outcome.prompt_tokens
    set session_completion = session_completion + outcome.completion_tokens
    if round >= round_cap then
      print("  [warn] reached " ++ to_text(round_cap) ++ " response rounds this turn, stopping]")
      set waiting = false
    end
  end
  InnerLoopResult {messages: finish_inner_loop(msgs, messages_start, last_message_is_assistant_text(msgs)), used_model: used_model, context_budget: context_budget, prompt_tokens: session_prompt, completion_tokens: session_completion}
end

-- ─── Graphical token usage display (CLI) ────────────────────────────────────

function usage_sparkline(values: a list of integer, budget: integer): text
  intent: map each v in values to one of eight unicode block characters using index min v * 8 / max budget 1 7 and concatenate them
  let blocks: a list of text = ["▁", "▂", "▃", "▄", "▅", "▆", "▇", "█"]
  mutable out: text = ""
  for v in values do
    set out = out ++ get(blocks, min(v * 8 / max(budget, 1), 7))
  end
  out
end

function print_cli_token_tracker(msgs: a list of a mapping from text to text, inner: InnerLoopResult): nothing
  intent: print a graphical token usage line with a sparkline, context fill, and turn totals after a CLI turn
  let estimated: integer = kv_cache.estimate_messages_tokens(msgs)
  let history: a list of integer = unwrap_or(get(web_load_usage(), "history"), [])
  let recent: a list of integer = drop(history, max(length(history) - 32, 0))
  print("  [tokens] " ++ usage_sparkline(recent, inner.context_budget) ++ "  ctx " ++ to_text(estimated) ++ "/" ++ to_text(inner.context_budget) ++ "  |  turn in " ++ to_text(inner.prompt_tokens) ++ " out " ++ to_text(inner.completion_tokens))
end

-- ─── Model selection ─────────────────────────────────────────────────────────

function is_expert_task(input: text): boolean
  intent: return true when input is very long or contains architecture and design keywords
  let very_long: boolean = text_length(input) > 800
  let arch_keywords: boolean = contains_text(lowercase(input), "architect") or contains_text(lowercase(input), "refactor") or contains_text(lowercase(input), "redesign") or contains_text(lowercase(input), "design")
  very_long or arch_keywords
end

function is_complex_task(input: text): boolean
  intent: return true when input is long, contains error codes, or is an action request requiring tool use
  let long_input: boolean = text_length(input) > 200
  let has_error: boolean = contains_text(input, "E_") or contains_text(lowercase(input), "error")
  let lower: text = lowercase(input)
  let is_action: boolean = contains_text(lower, "commit") or contains_text(lower, "push") or contains_text(lower, "run ") or contains_text(lower, "install") or contains_text(lower, "git ") or contains_text(lower, "check ") or contains_text(lower, "test ") or contains_text(lower, "build") or contains_text(lower, "execute") or contains_text(lower, "deploy")
  long_input or has_error or is_action
end

function pick_model(input: text, full_model: text, fast_model: text, expert_model: text): text
  intent: dispatch to expert_model, full_model, or fast_model based on is_expert_task and is_complex_task
  if text_length(expert_model) > 0 and is_expert_task(input) then
    expert_model
  else if text_length(fast_model) == 0 or is_complex_task(input) then
    full_model
  else
    fast_model
  end
end

-- ─── Main loop ────────────────────────────────────────────────────────────────

function require_provider_api_key(env_name: text, provider_name: text): text
  intent: read env_name and return its API key or print a provider-specific error and exit
  let key_opt: an optional text = env_get(env_name)
  if is_none(key_opt) then
    print("Error: " ++ env_name ++ " is not set for " ++ provider_name ++ ". Set it or use LEGIBLE_CODER_API_KEY.")
    exit_process(1)
  end
  unwrap(key_opt)
end

function qwen_api_key(): an optional text
  intent: use env_get and is_some to choose DASHSCOPE_API_KEY, ALIBABA_TOKEN_PLAN_API_KEY, or OPENAI_API_KEY for Qwen
  let dashscope_key: an optional text = env_get("DASHSCOPE_API_KEY")
  let token_plan_key: an optional text = env_get("ALIBABA_TOKEN_PLAN_API_KEY")
  if is_some(dashscope_key) then
    dashscope_key
  else if is_some(token_plan_key) then
    token_plan_key
  else
    env_get("OPENAI_API_KEY")
  end
end

function require_qwen_api_key(): text
  intent: return a configured Qwen API key or print the supported environment variable names and exit
  let key_opt: an optional text = qwen_api_key()
  if is_none(key_opt) then
    print("Error: no Qwen API key is set. Set OPENAI_API_KEY, DASHSCOPE_API_KEY, ALIBABA_TOKEN_PLAN_API_KEY, or LEGIBLE_CODER_API_KEY.")
    exit_process(1)
  end
  unwrap(key_opt)
end

function resolve_api_key(base_url: text): text
  intent: return LEGIBLE_CODER_API_KEY if set, then the provider-specific key, or lm-studio for local
  let explicit_key: an optional text = env_get("LEGIBLE_CODER_API_KEY")
  if is_some(explicit_key) then
    unwrap(explicit_key)
  else if is_qwen_url(base_url) then
    require_qwen_api_key()
  else if is_gemini_url(base_url) then
    require_provider_api_key("GEMINI_API_KEY", "Gemini")
  else if is_orcarouter_url(base_url) then
    require_provider_api_key("ORCAROUTER_API_KEY", "OrcaRouter")
  else if is_openrouter_url(base_url) then
    require_provider_api_key("OPENROUTER_API_KEY", "OpenRouter")
  else if is_nims_url(base_url) then
    require_provider_api_key("NVIDIA_API_KEY", "NIM")
  else if is_groq_url(base_url) then
    require_provider_api_key("GROQ_API_KEY", "Groq")
  else
    "lm-studio"
  end
end

function resolve_max_tools(tier: text): integer
  intent: read LEGIBLE_CODER_MAX_TOOLS or use default 60 for local and 30 for cloud providers
  let default_text: text = if tier == "local" then "60" else "30" end
  let raw: text = unwrap_or(env_get("LEGIBLE_CODER_MAX_TOOLS"), default_text)
  max(to_integer(raw), 1)
end

function resolve_context_budget(tier: text): integer
  intent: read LEGIBLE_CODER_CONTEXT_TOKENS or use a provider-appropriate token budget before compaction
  -- gemini-3.7-flash and qwen3.8-max have 1M-token contexts, OrcaRouter Qwen3.8 has 65K, NIM has 131K, local is very limited
  let default_text: text = if tier == "local" then "6000" else if tier == "gemini" then "700000" else if tier == "qwen" then "850000" else if tier == "orcarouter" then "60000" else if tier == "nims" then "120000" else "90000" end
  let raw: text = unwrap_or(env_get("LEGIBLE_CODER_CONTEXT_TOKENS"), default_text)
  max(to_integer(raw), 1000)
end

function resolve_context_compact_after(tier: text): integer
  intent: read LEGIBLE_CODER_CONTEXT_COMPACT_AFTER or default by tier to 100000 for qwen else 0 as the minimum estimated transcript size before compression
  -- qwen3.8-max has a 1M-token window, so the transcript stays untouched until it is around 100K estimated tokens
  let default_text: text = if tier == "qwen" then "100000" else "0" end
  let raw: text = unwrap_or(env_get("LEGIBLE_CODER_CONTEXT_COMPACT_AFTER"), default_text)
  max(to_integer(raw), 0)
end

function resolve_context_keep_messages(tier: text): integer
  intent: read LEGIBLE_CODER_CONTEXT_KEEP_MESSAGES or use a provider-appropriate recent-message default
  let default_text: text = if tier == "local" then "8" else if tier == "gemini" then "24" else "12" end
  let raw: text = unwrap_or(env_get("LEGIBLE_CODER_CONTEXT_KEEP_MESSAGES"), default_text)
  max(to_integer(raw), 2)
end

function resolve_max_output_tokens(tier: text, include_tools: boolean): integer
  intent: read LEGIBLE_CODER_MAX_OUTPUT_TOKENS or pick a default suited to the backend
  -- qwen3.8-max supports up to 131K output, gemini-3.7-flash up to 65K, NIM up to 131K, local is small
  let default_text: text = if tier == "local" and include_tools then "4096" else if tier == "local" then "750" else if tier == "qwen" then "131072" else if tier == "gemini" then "32768" else if tier == "nims" then "32768" else "16384" end
  let raw: text = unwrap_or(env_get("LEGIBLE_CODER_MAX_OUTPUT_TOKENS"), default_text)
  max(to_integer(raw), 128)
end

function resolve_provider_limits(tier: text, include_tools: boolean): ProviderLimits
  intent: combine the output and context limits resolved for one provider tier
  let budget: integer = resolve_context_budget(tier)
  ProviderLimits {
    max_output_tokens: resolve_max_output_tokens(tier, include_tools),
    context_budget: budget,
    keep_messages: resolve_context_keep_messages(tier),
    compact_after: min(resolve_context_compact_after(tier), budget)
  }
end

function env_truthy(name: text): boolean
  intent: env_get lowercase trim raw compare
  let raw: text = lowercase(trim(unwrap_or(env_get(name), "")))
  raw == "1" or raw == "true" or raw == "yes" or raw == "on"
end

function env_falsey(name: text): boolean
  intent: env_get lowercase trim raw compare
  let raw: text = lowercase(trim(unwrap_or(env_get(name), "")))
  raw == "0" or raw == "false" or raw == "no" or raw == "off"
end

function is_gemma4_model(model: text): boolean
  intent: return true when the configured model name looks like a Gemma 4 model
  let lower: text = lowercase(model)
  contains_text(lower, "gemma-4") or contains_text(lower, "gemma4")
end

function resolve_include_vision(model: text): boolean
  intent: return true when vision is enabled via env or the model is known to support multimodal input
  if env_falsey("LEGIBLE_CODER_VISION") then
    false
  else if env_truthy("LEGIBLE_CODER_VISION") then
    true
  else
    let lower: text = lowercase(model)
    contains_text(lower, "gemini") or
    contains_text(lower, "gemma-4") or contains_text(lower, "gemma4") or
    contains_text(lower, "llama-4") or contains_text(lower, "vision") or
    contains_text(lower, "llava") or contains_text(lower, "claude-3") or
    contains_text(lower, "claude-4") or contains_text(lower, "gpt-4")
  end
end

function resolve_local_native_tools(model: text): boolean
  intent: enable native local tool calling when forced or when the model is Gemma 4 unless explicitly disabled
  if env_falsey("LEGIBLE_CODER_LOCAL_TOOLS") then
    false
  else if env_truthy("LEGIBLE_CODER_LOCAL_TOOLS") then
    true
  else
    is_gemma4_model(model)
  end
end

function print_local_tool_mode(is_local: boolean, include_tools: boolean): nothing
  intent: print local tool mode when base_url is local
  if is_local and include_tools then
    print("  local tool mode: native OpenAI tool schemas")
  else if is_local then
    print("  local tool mode: manual TOOL protocol")
  end
end

function build_custom_provider(url: text, model_override: an optional text): a mapping from text to text
  intent: call resolve_api_key and env_get to build a provider mapping for an explicitly configured url with model and fast_model
  let key: text = resolve_api_key(url)
  let default_model: text = if is_qwen_url(url) then "qwen3.8-max" else if is_gemini_url(url) then "gemini-3.7-flash" else if is_orcarouter_url(url) then "qwen/qwen3.8-27b-free" else if is_nims_url(url) then "deepseek-ai/deepseek-v4-flash-0731" else if is_openrouter_url(url) then "openrouter/free" else if is_groq_url(url) then "openai/gpt-oss-120b" else "google/gemma-4-26b-a4b" end
  let model: text = unwrap_or(model_override, default_model)
  let url_is_local: boolean = contains_text(url, "localhost") or contains_text(url, "127.0.0.1")
  let fast_model: text = if url_is_local then "" else unwrap_or(env_get("LEGIBLE_CODER_FAST_MODEL"), model) end
  let expert_model: text = if url_is_local then "" else unwrap_or(env_get("LEGIBLE_CODER_EXPERT_MODEL"), "") end
  {"name": "Custom", "key": key, "url": url, "full": model, "fast": fast_model, "expert": expert_model}
end

function build_qwen_provider(key: text, model_override: an optional text): a mapping from text to text
  intent: build a provider mapping for the Qwen DashScope API using the qwen3.8-max default
  let model: text = unwrap_or(model_override, "qwen3.8-max")
  let fast_model: text = unwrap_or(env_get("LEGIBLE_CODER_FAST_MODEL"), "qwen3.8-max")
  let expert_model: text = unwrap_or(env_get("LEGIBLE_CODER_EXPERT_MODEL"), "")
  {"name": "Qwen", "key": key, "url": qwen_base_url(), "full": model, "fast": fast_model, "expert": expert_model}
end

function build_gemini_provider(key: text, model_override: an optional text): a mapping from text to text
  intent: build a provider mapping for the Gemini API using the free-tier default
  let model: text = unwrap_or(model_override, "gemini-3.7-flash")
  let fast_model: text = unwrap_or(env_get("LEGIBLE_CODER_FAST_MODEL"), model)
  let expert_model: text = unwrap_or(env_get("LEGIBLE_CODER_EXPERT_MODEL"), "")
  {"name": "Gemini", "key": key, "url": gemini_base_url(), "full": model, "fast": fast_model, "expert": expert_model}
end

function build_orcarouter_provider(key: text, model_override: an optional text): a mapping from text to text
  intent: build a provider mapping for OrcaRouter using the free Qwen3.8 27B model
  let model: text = unwrap_or(model_override, "qwen/qwen3.8-27b-free")
  let fast_model: text = unwrap_or(env_get("LEGIBLE_CODER_FAST_MODEL"), "qwen/qwen3.8-27b-free")
  let expert_model: text = unwrap_or(env_get("LEGIBLE_CODER_EXPERT_MODEL"), "")
  {"name": "OrcaRouter", "key": key, "url": orcarouter_base_url(), "full": model, "fast": fast_model, "expert": expert_model}
end

function build_openrouter_provider(key: text, model_override: an optional text): a mapping from text to text
  intent: build a provider mapping for OpenRouter using its free models router
  let model: text = unwrap_or(model_override, "openrouter/free")
  let fast_model: text = unwrap_or(env_get("LEGIBLE_CODER_FAST_MODEL"), "openrouter/free")
  let expert_model: text = unwrap_or(env_get("LEGIBLE_CODER_EXPERT_MODEL"), "")
  {"name": "OpenRouter", "key": key, "url": openrouter_base_url(), "full": model, "fast": fast_model, "expert": expert_model}
end

function build_groq_provider(key: text, model_override: an optional text): a mapping from text to text
  intent: use unwrap_or and env_get to build a provider mapping for Groq with model, fast_model, and expert_model
  let model: text = unwrap_or(model_override, "openai/gpt-oss-120b")
  let fast_model: text = unwrap_or(env_get("LEGIBLE_CODER_FAST_MODEL"), "openai/gpt-oss-20b")
  let expert_model: text = unwrap_or(env_get("LEGIBLE_CODER_EXPERT_MODEL"), "")
  {"name": "Groq", "key": key, "url": "https://api.groq.com/openai/v1", "full": model, "fast": fast_model, "expert": expert_model}
end

function build_nims_provider(key: text, model_override: an optional text): a mapping from text to text
  intent: build a provider mapping for the NVIDIA NIM API using the deepseek-v4-flash-0731 model
  let model: text = unwrap_or(model_override, "deepseek-ai/deepseek-v4-flash-0731")
  let fast_model: text = unwrap_or(env_get("LEGIBLE_CODER_FAST_MODEL"), "deepseek-ai/deepseek-v4-flash-0731")
  let expert_model: text = unwrap_or(env_get("LEGIBLE_CODER_EXPERT_MODEL"), "")
  {"name": "NIM", "key": key, "url": nims_base_url(), "full": model, "fast": fast_model, "expert": expert_model}
end

function build_local_provider(model_override: an optional text): a mapping from text to text
  intent: build a provider mapping for the local LM Studio endpoint as the final fallback
  let model: text = unwrap_or(model_override, "google/gemma-4-26b-a4b")
  {"name": "LM Studio", "key": "lm-studio", "url": "http://localhost:1234/v1", "full": model, "fast": "", "expert": ""}
end

function build_default_provider_list(model_override: an optional text, qwen_key_opt: an optional text, gemini_key_opt: an optional text, orcarouter_key_opt: an optional text, nims_key_opt: an optional text, openrouter_key_opt: an optional text, groq_key_opt: an optional text): a list of a mapping from text to text
  intent: use is_some and append to build the qwen, gemini, orcarouter, nims, openrouter, groq, and local provider fallback list
  let with_qwen: a list of a mapping from text to text = if is_some(qwen_key_opt) then [build_qwen_provider(unwrap(qwen_key_opt), model_override)] else [] end
  let with_gemini: a list of a mapping from text to text = if is_some(gemini_key_opt) then append(with_qwen, build_gemini_provider(unwrap(gemini_key_opt), model_override)) else with_qwen end
  let with_orcarouter: a list of a mapping from text to text = if is_some(orcarouter_key_opt) then append(with_gemini, build_orcarouter_provider(unwrap(orcarouter_key_opt), model_override)) else with_gemini end
  let with_nims: a list of a mapping from text to text = if is_some(nims_key_opt) then append(with_orcarouter, build_nims_provider(unwrap(nims_key_opt), model_override)) else with_orcarouter end
  let with_openrouter: a list of a mapping from text to text = if is_some(openrouter_key_opt) then append(with_nims, build_openrouter_provider(unwrap(openrouter_key_opt), model_override)) else with_nims end
  let with_groq: a list of a mapping from text to text = if is_some(groq_key_opt) then append(with_openrouter, build_groq_provider(unwrap(groq_key_opt), model_override)) else with_openrouter end
  append(with_groq, build_local_provider(model_override))
end

function build_provider_list(): a list of a mapping from text to text
  intent: use env_get to read LEGIBLE_CODER_BASE_URL and is_some to pick build_custom_provider or build_default_provider_list
  let custom_url_opt: an optional text = env_get("LEGIBLE_CODER_BASE_URL")
  let model_override: an optional text = env_get("LEGIBLE_CODER_MODEL")
  if is_some(custom_url_opt) then
    [build_custom_provider(unwrap(custom_url_opt), model_override)]
  else
    build_default_provider_list(model_override, qwen_api_key(), env_get("GEMINI_API_KEY"), env_get("ORCAROUTER_API_KEY"), env_get("NVIDIA_API_KEY"), env_get("OPENROUTER_API_KEY"), env_get("GROQ_API_KEY"))
  end
end

function print_turn_model_banner(provider_idx: integer, switched: boolean, prov: a mapping from text to text, turn_model: text, p_full: text, p_fast: text, p_expert: text): nothing
  intent: print the fallback notice or the expert/fast model banner before a turn runs
  if provider_idx > 0 or switched then
    print("  [fallback] trying " ++ get(prov, "name") ++ " with model " ++ turn_model)
  end
  if provider_idx == 0 and not switched and turn_model == p_expert and text_length(p_expert) > 0 then
    print("  [expert model: " ++ p_expert ++ "]")
  end
  if provider_idx == 0 and not switched and turn_model == p_fast and text_length(p_fast) > 0 and p_fast != p_full then
    print("  [fast model: " ++ p_fast ++ "]")
  end
end

function fail_turn_no_provider(): nothing
  intent: print the no provider available error emit an error event release the worker lock and exit the process
  print("Error: no model is available.")
  web_event_emit({"type": "error", "text": "Error: no model provider is reachable. Check your API keys and network connection, then try again."})
  web_worker_lock_release()
  exit_process(1)
end

function run_turn_with_fallback(messages: a list of a mapping from text to text, user_input: text, start: integer, providers: a list of a mapping from text to text, max_tools: integer, include_tools: boolean, include_dir_tools: boolean, include_vision: boolean, track_usage: boolean): TurnResult
  intent: cycle providers with provider-specific limits until the turn succeeds or every provider fails consecutively and carry the final token usage
  mutable msgs: a list of a mapping from text to text = messages
  mutable provider_idx: integer = 0
  mutable consecutive_failures: integer = 0
  mutable attempts: integer = 0
  mutable turn_done: boolean = false
  mutable last_inner: InnerLoopResult = InnerLoopResult {messages: [], used_model: false, context_budget: 0, prompt_tokens: 0, completion_tokens: 0}
  while not turn_done do
    let prov: a mapping from text to text = get(providers, provider_idx)
    let p_full: text = get(prov, "full")
    let p_fast: text = get(prov, "fast")
    let p_expert: text = get(prov, "expert")
    let turn_model: text = pick_model(user_input, p_full, p_fast, p_expert)
    let limits: ProviderLimits = resolve_provider_limits(provider_tier(get(prov, "url")), include_tools)
    print_turn_model_banner(provider_idx, attempts > 0, prov, turn_model, p_full, p_fast, p_expert)
    if provider_is_reachable(get(prov, "url")) then
      let inner: InnerLoopResult = run_inner_loop(msgs, start, get(prov, "key"), get(prov, "url"), turn_model, max_tools, include_tools, include_dir_tools, limits.max_output_tokens, limits.context_budget, limits.keep_messages, limits.compact_after, include_vision, track_usage)
      set msgs = inner.messages
      set last_inner = inner
      if inner.used_model then
        set consecutive_failures = 0
      end
    else
      print("  [unavailable] cannot reach " ++ get(prov, "name"))
    end
    if length(msgs) > start then
      set turn_done = true
    else
      set consecutive_failures = consecutive_failures + 1
      if consecutive_failures >= length(providers) then
        fail_turn_no_provider()
      end
      set provider_idx = (provider_idx + 1) % length(providers)
      set attempts = attempts + 1
      if provider_idx == 0 then
        print("  [retry] reached the end of the fallback chain; trying the first option")
      end
    end
  end
  TurnResult {messages: msgs, inner: last_inner}
end

function run_repl(init_messages: a list of a mapping from text to text, providers: a list of a mapping from text to text, max_tools: integer, include_tools: boolean, include_dir_tools: boolean, include_vision: boolean): nothing
  intent: run the interactive read-eval-print loop, dispatching each user turn through the provider fallback chain
  mutable messages: a list of a mapping from text to text = init_messages
  mutable running: boolean = true
  while running do
    print("  > ")
    let user_input: text = trim(read_line())
    if user_input == "quit" or user_input == "exit" then
      print("  Goodbye!")
      set running = false
    else if text_length(user_input) == 0 then
      print("")
    else
      set messages = append(messages, {"role": "user", "content": user_input})
      let start: integer = length(messages)
      let turn: TurnResult = run_turn_with_fallback(messages, user_input, start, providers, max_tools, include_tools, include_dir_tools, include_vision, true)
      set messages = turn.messages
      web_add_usage(turn.inner.prompt_tokens, turn.inner.completion_tokens, turn.inner.context_budget)
      print_cli_token_tracker(messages, turn.inner)
    end
  end
end

function provider_name_list(providers: a list of a mapping from text to text): a list of text
  intent: extract the name field from each provider mapping into a list of text
  map(providers, fn(p: a mapping from text to text): text => get(p, "name"))
end

function initial_messages(is_local: boolean, sys_prompt: text): a list of a mapping from text to text
  intent: build the starting message list with the system prompt and optional local bootstrap
  let sys_msg: a mapping from text to text = {"role": "system", "content": sys_prompt}
  if is_local then
    [sys_msg, {"role": "system", "content": local_model_context()}]
  else
    [sys_msg]
  end
end

-- ─── Web GUI (dsh-style chat UI with workspaces) ─────────────────────────────

record Request
  method: text
  path: text
  body: text
  query: text
  headers: a mapping from text to text
end

function web_mode_requested(): boolean
  intent: return true when the user passed the web flag or set the web env toggle and this is not a background turn worker
  let worker: boolean = contains_text(" " ++ join(get_args(), " ") ++ " ", "--turn")
  (not worker) and (contains_text(" " ++ join(get_args(), " ") ++ " ", "--web") or env_truthy("LEGIBLE_CODER_WEB"))
end

function web_port(): integer
  intent: resolve the web server port from the port env override or default to 8723
  let raw: an optional text = env_get("LEGIBLE_CODER_WEB_PORT")
  if is_none(raw) then 8723 else unwrap_or(to_integer(unwrap(raw)), 8723) end
end

function web_base_dir(): text
  intent: return the legible-coder state directory under the user home
  unwrap_or(env_get("HOME"), "/tmp") ++ "/.legible-coder"
end

function web_registry_path(): text
  intent: return the path of the workspace registry JSON file
  web_base_dir() ++ "/web-workspaces.json"
end

function web_session_path(ws_id: text, conv_id: text): text
  intent: return the workspaces dir path plus ws_id and conv_id joined as the conversation json filename
  web_base_dir() ++ "/workspaces/" ++ ws_id ++ "--" ++ conv_id ++ ".json"
end

function web_legacy_session_path(ws_id: text): text
  intent: return the legacy session json path under web_base_dir workspaces for ws_id used before conversations existed
  web_base_dir() ++ "/workspaces/" ++ ws_id ++ ".json"
end

function web_usage_path(): text
  intent: return the path of the persisted web token usage totals json file
  web_base_dir() ++ "/token-usage.json"
end

function web_load_usage(): a mapping from text to text
  intent: read persisted web token usage totals and history defaulting to zero totals
  let path: text = web_usage_path()
  if not file_exists(path) then
    {"prompt": 0, "completion": 0, "history": [], "budget": 0}
  else
    let raw: text = read_file(path)
    if json_valid(raw) then json_parse(raw) else {"prompt": 0, "completion": 0, "history": [], "budget": 0} end
  end
end

function web_usage_int(usage: a mapping from text to text, field: text): integer
  intent: read an integer field from the persisted usage record defaulting to zero
  if has_key(usage, field) then
    unwrap_or(to_integer(trim(to_text(get(usage, field)))), 0)
  else
    0
  end
end

function web_add_usage(prompt: integer, completion: integer, budget: integer): nothing
  intent: create_dir then web_load_usage append prompt and completion into history drop to cap it and write_file json_encode totals at web_usage_path
  create_dir(web_base_dir())
  let cur: a mapping from text to text = web_load_usage()
  let history: a list of integer = append(unwrap_or(get(cur, "history"), []), prompt + completion)
  let capped: a list of integer = if length(history) > 48 then drop(history, length(history) - 48) else history end
  write_file(web_usage_path(), json_encode({
    "prompt": web_usage_int(cur, "prompt") + prompt,
    "completion": web_usage_int(cur, "completion") + completion,
    "history": capped,
    "budget": budget
  }))
end

function web_usage_payload(msgs: a list of a mapping from text to text): a mapping from text to text
  intent: build the usage payload with persisted totals the current context estimate and the budget
  let cur: a mapping from text to text = web_load_usage()
  put(put(cur, "estimated", kv_cache.estimate_messages_tokens(msgs)), "budget", web_usage_int(cur, "budget"))
end

function web_workspace_id(): text
  intent: generate a fresh workspace id from random hex digits
  "ws-" ++ random_hex(10)
end

function web_conversation_id(): text
  intent: generate a fresh conversation id from random hex digits
  "cv-" ++ random_hex(10)
end

function dir_basename(path: text): text
  intent: return the final path segment of a directory path via the basename command
  let out: text = trim(get(shell_exec("basename '" ++ path ++ "'"), "stdout"))
  if text_length(out) == 0 then path else out end
end

function web_load_registry(): a mapping from text to text
  intent: read the registry file via web_registry_path when it is valid json and parse it
  let path: text = web_registry_path()
  if not file_exists(path) then
    {}
  else
    let raw: text = read_file(path)
    if json_valid(raw) then json_parse(raw) else {} end
  end
end

function web_save_registry(reg: a mapping from text to text): nothing
  intent: ensure the state directory exists and write the registry as JSON
  create_dir(web_base_dir())
  web_write_json_atomic(web_registry_path(), json_encode(reg))
end

function web_make_conversation(conv_id: text, title: text): a mapping from text to text
  intent: build a conversation record mapping with id title and created fields
  {"id": conv_id, "title": title, "created": to_text(current_time_ms())}
end

function web_make_workspace(ws_id: text, name: text, root_dir: text): a mapping from text to text
  intent: build a workspace record mapping with id name root_dir created fields and one default conversation
  let default_conv: a mapping from text to text = web_make_conversation(web_conversation_id(), "New conversation")
  {"id": ws_id, "name": name, "root_dir": root_dir, "created": to_text(current_time_ms()), "conversations": [default_conv], "active_conversation": unwrap_or(get(default_conv, "id"), "")}
end

function web_registry_workspaces(reg: a mapping from text to text): a list of a mapping from text to text
  intent: return the workspace list stored in the registry or an empty list
  unwrap_or(get(reg, "workspaces"), [])
end

function web_find_workspace(reg: a mapping from text to text, ws_id: text): an optional a mapping from text to text
  intent: find the workspace record whose id field equals ws_id
  find(web_registry_workspaces(reg), fn(w: a mapping from text to text): boolean => unwrap_or(get(w, "id"), "") == ws_id)
end

function web_replace_workspace(reg: a mapping from text to text, updated: a mapping from text to text): a mapping from text to text
  intent: return the registry with the workspace whose id matches updated replaced by updated
  let updated_id: text = unwrap_or(get(updated, "id"), "")
  let updated_list: a list of a mapping from text to text = map(web_registry_workspaces(reg), fn(w: a mapping from text to text): a mapping from text to text => if unwrap_or(get(w, "id"), "") == updated_id then updated else w end)
  put(reg, "workspaces", updated_list)
end

function web_active_workspace(reg: a mapping from text to text): a mapping from text to text
  intent: return the active workspace record falling back to the first workspace or an empty mapping
  let active_id: text = unwrap_or(get(reg, "active"), "")
  let found: an optional a mapping from text to text = web_find_workspace(reg, active_id)
  if is_some(found) then
    unwrap(found)
  else
    let all: a list of a mapping from text to text = web_registry_workspaces(reg)
    if length(all) > 0 then get(all, 0) else {} end
  end
end

function web_workspace_conversations(ws: a mapping from text to text): a list of a mapping from text to text
  intent: return the conversation list stored on a workspace or an empty list
  unwrap_or(get(ws, "conversations"), [])
end

function web_find_conversation(ws: a mapping from text to text, conv_id: text): an optional a mapping from text to text
  intent: find the conversation record on a workspace whose id field equals conv_id
  find(web_workspace_conversations(ws), fn(c: a mapping from text to text): boolean => unwrap_or(get(c, "id"), "") == conv_id)
end

function web_active_conversation(ws: a mapping from text to text): a mapping from text to text
  intent: return the active conversation of a workspace falling back to the first conversation or an empty mapping
  let active_id: text = unwrap_or(get(ws, "active_conversation"), "")
  let found: an optional a mapping from text to text = web_find_conversation(ws, active_id)
  if is_some(found) then
    unwrap(found)
  else
    let all: a list of a mapping from text to text = web_workspace_conversations(ws)
    if length(all) > 0 then get(all, 0) else {} end
  end
end

function web_migrate_workspace(ws: a mapping from text to text): a mapping from text to text
  intent: ensure a workspace has at least one conversation importing the legacy single-session transcript file when needed
  if length(web_workspace_conversations(ws)) > 0 then
    ws
  else
    let ws_id: text = unwrap_or(get(ws, "id"), "")
    let legacy_path: text = web_legacy_session_path(ws_id)
    let conv: a mapping from text to text = web_make_conversation(web_conversation_id(), "Conversation")
    let conv_id: text = unwrap_or(get(conv, "id"), "")
    if file_exists(legacy_path) then
      shell_exec("mv '" ++ legacy_path ++ "' '" ++ web_session_path(ws_id, conv_id) ++ "'")
    else
      skip()
    end
    put(put(ws, "conversations", [conv]), "active_conversation", conv_id)
  end
end

function web_ensure_registry(): a mapping from text to text
  intent: load the registry creating a default workspace for the current directory when missing and migrating every workspace to conversations
  let loaded: a mapping from text to text = web_load_registry()
  let migrated: a mapping from text to text = put(loaded, "workspaces", map(web_registry_workspaces(loaded), fn(w: a mapping from text to text): a mapping from text to text => web_migrate_workspace(w)))
  if length(web_registry_workspaces(migrated)) > 0 then
    web_save_registry(migrated)
    migrated
  else
    let cwd: text = get_cwd()
    let ws: a mapping from text to text = web_make_workspace(web_workspace_id(), dir_basename(cwd), cwd)
    let fresh: a mapping from text to text = {"workspaces": [ws], "active": unwrap_or(get(ws, "id"), "")}
    web_save_registry(fresh)
    fresh
  end
end

function web_load_session(ws_id: text, conv_id: text, init_messages: a list of a mapping from text to text): a list of a mapping from text to text
  intent: read the conversation session file via web_session_path and parse the json or fall back to init_messages
  let path: text = web_session_path(ws_id, conv_id)
  if not file_exists(path) then
    init_messages
  else
    let raw: text = read_file(path)
    if json_valid(raw) then json_parse(raw) else init_messages end
  end
end

function web_save_session(ws_id: text, conv_id: text, msgs: a list of a mapping from text to text): nothing
  intent: create_dir the workspaces dir then write_file json_encode msgs at web_session_path for ws_id and conv_id
  create_dir(web_base_dir() ++ "/workspaces")
  web_write_json_atomic(web_session_path(ws_id, conv_id), json_encode(msgs))
end

function web_display_messages(msgs: a list of a mapping from text to text): a list of a mapping from text to text
  intent: filter msgs so a role of system is excluded
  filter(msgs, fn(m: a mapping from text to text): boolean => unwrap_or(get(m, "role"), "") != "system")
end

function web_respond_html(body: text): nothing
  intent: respond to the current request with an HTML document
  http_respond_with_headers(200, {"content-type": "text/html; charset=utf-8"}, body)
end

function web_respond_json(status: integer, body: text): nothing
  intent: respond to the current request with a JSON payload
  http_respond_with_headers(status, {"content-type": "application/json; charset=utf-8"}, body)
end

function web_json_error(message: text): text
  intent: encode an error payload as JSON text
  json_encode({"error": message})
end

function web_state_payload(reg: a mapping from text to text, model: text, base_url: text, usage: a mapping from text to text): text
  intent: build the state JSON with workspaces active ids active conversation id model backend cwd and token usage
  let active_ws: a mapping from text to text = web_active_workspace(reg)
  json_encode({
    "workspaces": web_registry_workspaces(reg),
    "active": unwrap_or(get(reg, "active"), ""),
    "active_conversation": unwrap_or(get(active_ws, "active_conversation"), ""),
    "model": model,
    "backend": backend_name(base_url),
    "cwd": get_cwd(),
    "usage": usage
  })
end

function web_handle_state(model: text, base_url: text): nothing
  intent: respond with workspace state plus the persisted token usage tracker payload for the active conversation
  let reg: a mapping from text to text = web_ensure_registry()
  let ws: a mapping from text to text = web_active_workspace(reg)
  let conv_id: text = unwrap_or(get(web_active_conversation(ws), "id"), "")
  let ws_msgs: a list of a mapping from text to text = web_load_session(unwrap_or(get(ws, "id"), ""), conv_id, [])
  web_respond_json(200, web_state_payload(reg, model, base_url, web_usage_payload(ws_msgs)))
end

function web_handle_messages(init_messages: a list of a mapping from text to text): nothing
  intent: respond with the display transcript of the active conversation of the active workspace
  let reg: a mapping from text to text = web_ensure_registry()
  let ws: a mapping from text to text = web_active_workspace(reg)
  let ws_id: text = unwrap_or(get(ws, "id"), "")
  let conv_id: text = unwrap_or(get(web_active_conversation(ws), "id"), "")
  let msgs: a list of a mapping from text to text = web_load_session(ws_id, conv_id, init_messages)
  web_respond_json(200, json_encode({"messages": web_display_messages(msgs)}))
end

function web_handle_files(): nothing
  intent: respond with a file listing of the active workspace root directory
  let cmd: text = "find . -maxdepth 3 -type f 2>/dev/null | grep -v '/.git/' | grep -v '/node_modules/' | grep -v '/target/' | grep -v '/.venv/' | sort | head -400"
  let out: text = get(shell_exec(cmd), "stdout")
  let files: a list of text = filter(split(trim(out), "\n"), fn(line: text): boolean => text_length(line) > 0)
  web_respond_json(200, json_encode({"files": files, "root": get_cwd()}))
end

function web_handle_create(body: text, model: text, base_url: text): nothing
  intent: parse name and root_dir create the workspace directory and registry entry and select it
  if not json_valid(body) then
    web_respond_json(400, web_json_error("invalid JSON body"))
  else
    let data: a mapping from text to text = json_parse(body)
    let name: text = trim(unwrap_or(get(data, "name"), ""))
    let root_dir: text = trim(unwrap_or(get(data, "root_dir"), ""))
    let dir: text = if text_length(root_dir) == 0 then get_cwd() else root_dir end
    if text_length(name) == 0 then
      web_respond_json(400, web_json_error("workspace name is required"))
    else
      create_dir(dir)
      let reg: a mapping from text to text = web_load_registry()
      let ws: a mapping from text to text = web_make_workspace(web_workspace_id(), name, dir)
      let reg2: a mapping from text to text = put(reg, "workspaces", append(web_registry_workspaces(reg), ws))
      let reg3: a mapping from text to text = put(reg2, "active", unwrap_or(get(ws, "id"), ""))
      web_save_registry(reg3)
      chdir(dir)
      web_respond_json(200, web_state_payload(reg3, model, base_url, web_usage_payload([])))
    end
  end
end

function web_handle_select(body: text, model: text, base_url: text): nothing
  intent: switch the active workspace chdir into its root and respond with the new state
  if not json_valid(body) then
    web_respond_json(400, web_json_error("invalid JSON body"))
  else
    let data: a mapping from text to text = json_parse(body)
    let ws_id: text = unwrap_or(get(data, "id"), "")
    let reg: a mapping from text to text = web_ensure_registry()
    let found: an optional a mapping from text to text = web_find_workspace(reg, ws_id)
    if is_none(found) then
      web_respond_json(404, web_json_error("workspace not found: " ++ ws_id))
    else
      let ws: a mapping from text to text = unwrap(found)
      let root_dir: text = unwrap_or(get(ws, "root_dir"), get_cwd())
      if is_dir(root_dir) then
        chdir(root_dir)
      else
        skip()
      end
      let reg2: a mapping from text to text = put(reg, "active", ws_id)
      web_save_registry(reg2)
      web_respond_json(200, web_state_payload(reg2, model, base_url, web_usage_payload([])))
    end
  end
end

function web_handle_create_conversation(body: text, model: text, base_url: text): nothing
  intent: append a new conversation to the active workspace mark it active and respond with the new state
  let reg: a mapping from text to text = web_ensure_registry()
  let ws: a mapping from text to text = web_active_workspace(reg)
  if not has_key(ws, "id") then
    web_respond_json(404, web_json_error("no active workspace"))
  else
    let conv: a mapping from text to text = web_make_conversation(web_conversation_id(), "New conversation")
    let conv_id: text = unwrap_or(get(conv, "id"), "")
    let updated_ws: a mapping from text to text = put(put(ws, "conversations", append(web_workspace_conversations(ws), conv)), "active_conversation", conv_id)
    let reg2: a mapping from text to text = web_replace_workspace(reg, updated_ws)
    web_save_registry(reg2)
    web_respond_json(200, web_state_payload(reg2, model, base_url, web_usage_payload([])))
  end
end

function web_handle_select_conversation(body: text, model: text, base_url: text): nothing
  intent: switch the active conversation of the active workspace and respond with the new state
  if not json_valid(body) then
    web_respond_json(400, web_json_error("invalid JSON body"))
  else
    let data: a mapping from text to text = json_parse(body)
    let conv_id: text = unwrap_or(get(data, "id"), "")
    let reg: a mapping from text to text = web_ensure_registry()
    let ws: a mapping from text to text = web_active_workspace(reg)
    if not has_key(ws, "id") then
      web_respond_json(404, web_json_error("no active workspace"))
    else if is_none(web_find_conversation(ws, conv_id)) then
      web_respond_json(404, web_json_error("conversation not found: " ++ conv_id))
    else
      let updated_ws: a mapping from text to text = put(ws, "active_conversation", conv_id)
      let reg2: a mapping from text to text = web_replace_workspace(reg, updated_ws)
      web_save_registry(reg2)
      web_respond_json(200, web_state_payload(reg2, model, base_url, web_usage_payload([])))
    end
  end
end

function web_conversation_title_from(text_value: text): text
  intent: split text_value on newline get first_line trim it and substring to 40 chars appending ellipsis
  let first_line: text = trim(get(split(text_value, "\n"), 0))
  if text_length(first_line) > 40 then substring(first_line, 0, 40) ++ "..." else first_line end
end

function any_provider_reachable(providers: a list of a mapping from text to text): boolean
  intent: find a provider whose url passes provider_is_reachable and report is_some
  is_some(find(providers, fn(p: a mapping from text to text): boolean => provider_is_reachable(get(p, "url"))))
end

function web_start_turn(ws_id: text, conv_id: text, user_text: text, root_dir: text): a mapping from text to text
  intent: reset the event log take the turn lock and spawn the detached background worker for this conversation
  web_events_reset(ws_id, conv_id)
  web_turn_lock_acquire(ws_id, conv_id)
  let prefix: text = web_worker_launch_prefix()
  if text_length(prefix) == 0 then
    web_turn_lock_release(ws_id, conv_id)
    {"ok": false, "error": "cannot determine the interpreter and script path of the running server"}
  else
    let events_path: text = web_events_path(ws_id, conv_id)
    let spawned: a mapping from text to text = shell_exec(web_worker_spawn_cmd(prefix, ws_id, conv_id, user_text, root_dir, events_path))
    if to_text(get(spawned, "exit_code")) == "0" then
      {"ok": true, "started": true, "events_path": events_path}
    else
      web_turn_lock_release(ws_id, conv_id)
      {"ok": false, "error": "failed to start the turn worker: " ++ to_text(get(spawned, "stderr"))}
    end
  end
end

function web_handle_send(body: text, init_messages: a list of a mapping from text to text, providers: a list of a mapping from text to text, max_tools: integer, include_tools: boolean, include_dir_tools: boolean, include_vision: boolean): nothing
  intent: json_parse the body then web_turn_is_locked web_load_session web_save_session and web_start_turn the worker
  if not json_valid(body) then
    web_respond_json(400, web_json_error("invalid JSON body"))
  else
    let data: a mapping from text to text = json_parse(body)
    let user_text: text = trim(unwrap_or(get(data, "text"), ""))
    if text_length(user_text) == 0 then
      web_respond_json(400, web_json_error("message text is required"))
    else
      let reg: a mapping from text to text = web_ensure_registry()
      let ws: a mapping from text to text = web_active_workspace(reg)
      let ws_id: text = unwrap_or(get(ws, "id"), "")
      let conv: a mapping from text to text = web_active_conversation(ws)
      let conv_id: text = unwrap_or(get(conv, "id"), "")
      let root_dir: text = unwrap_or(get(ws, "root_dir"), get_cwd())
      if is_dir(root_dir) then
        chdir(root_dir)
      else
        skip()
      end
      if web_turn_is_locked(ws_id, conv_id) then
        web_respond_json(409, web_json_error("a turn is already running for this conversation"))
      else
        let msgs: a list of a mapping from text to text = web_load_session(ws_id, conv_id, init_messages)
        let saved: a list of a mapping from text to text = append(msgs, {"role": "user", "content": user_text})
        web_save_session(ws_id, conv_id, saved)
        let started: a mapping from text to text = web_start_turn(ws_id, conv_id, user_text, root_dir)
        if unwrap_or(get(started, "ok"), "false") == "true" then
          web_respond_json(200, json_encode({"ok": true, "started": true, "ws": ws_id, "conv": conv_id, "messages": web_display_messages(saved)}))
        else
          web_respond_json(500, web_json_error(unwrap_or(get(started, "error"), "failed to start turn")))
        end
      end
    end
  end
end

function web_events_target(query: text): a list of text
  intent: return the ws and conv ids from the query string loading the registry only when either is missing
  let qs_ws: text = web_query_value(query, "ws")
  let qs_conv: text = web_query_value(query, "conv")
  if text_length(qs_ws) > 0 and text_length(qs_conv) > 0 then
    [qs_ws, qs_conv]
  else
    let reg: a mapping from text to text = web_load_registry()
    let ws: a mapping from text to text = web_active_workspace(reg)
    [if text_length(qs_ws) > 0 then qs_ws else unwrap_or(get(ws, "id"), "") end, if text_length(qs_conv) > 0 then qs_conv else unwrap_or(get(web_active_conversation(ws), "id"), "") end]
  end
end

function web_handle_events(query: text): nothing
  intent: respond with the events json after the since cursor for the pinned conv plus the running flag
  let target: a list of text = web_events_target(query)
  let ws_id: text = get(target, 0)
  let conv_id: text = get(target, 1)
  let since: integer = unwrap_or(to_integer(web_query_value(query, "since")), 0)
  let payload: a mapping from text to text = json_parse(web_events_since(web_events_path(ws_id, conv_id), since))
  let running: boolean = web_turn_is_locked(ws_id, conv_id)
  web_respond_json(200, json_encode({"events": get(payload, "events"), "next": get(payload, "next"), "running": running}))
end

function web_css(): text
  intent: return the css text with sidebar brand topbar chat input and button styles for the web gui
  ":root @OB@ --bg:#0b0e14; --panel:#11151d; --panel2:#171c26; --border:#232a38; --text:#dbe2ee; --dim:#8b94a7; --accent:#4d7cfe; --user:#2b3a5e; --tool:#1a2332; @CB@\n" ++
  "* @OB@ box-sizing:border-box; margin:0; padding:0; @CB@\n" ++
  "body @OB@ background:var(--bg); color:var(--text); font:14px/1.5 -apple-system,'Segoe UI',Roboto,sans-serif; height:100vh; display:flex; overflow:hidden; @CB@\n" ++
  "#sidebar @OB@ width:250px; background:var(--panel); border-right:1px solid var(--border); display:flex; flex-direction:column; @CB@\n" ++
  ".brand @OB@ padding:16px; font-weight:700; font-size:16px; border-bottom:1px solid var(--border); @CB@\n" ++
  ".brand span @OB@ color:var(--accent); @CB@\n" ++
  "#ws-list @OB@ flex:1; overflow-y:auto; padding:8px; @CB@\n" ++
  ".ws-item @OB@ padding:10px 12px; border-radius:8px; cursor:pointer; margin-bottom:4px; border:1px solid transparent; @CB@\n" ++
  ".ws-item:hover @OB@ background:var(--panel2); @CB@\n" ++
  ".ws-item.active @OB@ background:var(--panel2); border-color:var(--accent); @CB@\n" ++
  ".ws-name @OB@ font-weight:600; @CB@\n" ++
  ".ws-dir @OB@ font-size:11px; color:var(--dim); overflow:hidden; text-overflow:ellipsis; white-space:nowrap; @CB@\n" ++
  ".new-ws @OB@ border-top:1px solid var(--border); padding:12px; @CB@\n" ++
  ".new-ws input @OB@ width:100%; background:var(--panel2); border:1px solid var(--border); color:var(--text); border-radius:6px; padding:7px 9px; margin-bottom:6px; font-size:12px; @CB@\n" ++
  "button @OB@ background:var(--accent); border:none; color:white; padding:8px 12px; border-radius:6px; cursor:pointer; font-size:13px; width:100%; @CB@\n" ++
  "button.secondary @OB@ background:var(--panel2); border:1px solid var(--border); color:var(--text); @CB@\n" ++
  "button:disabled @OB@ opacity:.6; cursor:default; @CB@\n" ++
  "#main @OB@ flex:1; display:flex; flex-direction:column; min-width:0; @CB@\n" ++
  "#topbar @OB@ display:flex; align-items:center; gap:12px; padding:10px 16px; border-bottom:1px solid var(--border); background:var(--panel); @CB@\n" ++
  "#topbar .title @OB@ font-weight:600; @CB@\n" ++
  "#topbar .meta @OB@ color:var(--dim); font-size:12px; flex:1; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; @CB@\n" ++
  "#chat @OB@ flex:1; overflow-y:auto; padding:20px 24px; @CB@\n" ++
  ".msg @OB@ margin-bottom:16px; max-width:880px; @CB@\n" ++
  ".msg.user @OB@ text-align:right; margin-left:auto; @CB@\n" ++
  ".msg.user .bubble @OB@ background:var(--user); border-radius:12px 12px 4px 12px; padding:10px 14px; display:inline-block; white-space:pre-wrap; word-break:break-word; text-align:left; @CB@\n" ++
  ".msg.assistant .bubble @OB@ background:var(--panel2); border:1px solid var(--border); border-radius:12px; padding:10px 14px; white-space:pre-wrap; word-break:break-word; @CB@\n" ++
  "details.toolcall @OB@ background:var(--tool); border:1px solid var(--border); border-radius:8px; padding:8px 12px; margin-bottom:8px; font-size:12.5px; @CB@\n" ++
  "details.toolcall summary @OB@ cursor:pointer; color:var(--accent); font-weight:600; @CB@\n" ++
  "details.toolcall pre @OB@ white-space:pre-wrap; word-break:break-word; margin-top:6px; color:var(--dim); @CB@\n" ++
  "#inputbar @OB@ display:flex; gap:10px; padding:14px 16px; border-top:1px solid var(--border); background:var(--panel); @CB@\n" ++
  "#input @OB@ flex:1; background:var(--panel2); border:1px solid var(--border); color:var(--text); border-radius:8px; padding:10px 12px; font-size:14px; resize:none; height:46px; font-family:inherit; @CB@\n" ++
  "#sendbtn @OB@ width:auto; padding:0 22px; @CB@\n" ++
  "#filepanel @OB@ width:300px; background:var(--panel); border-left:1px solid var(--border); display:none; flex-direction:column; @CB@\n" ++
  "#filepanel.open @OB@ display:flex; @CB@\n" ++
  "#filepanel .head @OB@ padding:12px 14px; border-bottom:1px solid var(--border); font-weight:600; display:flex; justify-content:space-between; @CB@\n" ++
  "#file-list @OB@ flex:1; overflow-y:auto; padding:8px 10px; font-family:ui-monospace,Menlo,monospace; font-size:12px; color:var(--dim); @CB@\n" ++
  "#file-list div @OB@ padding:2px 4px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; @CB@\n" ++
  ".spinner @OB@ display:inline-block; width:14px; height:14px; border:2px solid var(--dim); border-top-color:var(--accent); border-radius:50%; animation:spin .8s linear infinite; vertical-align:-2px; margin-right:8px; @CB@\n" ++
  "@keyframes spin @OB@ to @OB@ transform:rotate(360deg); @CB@ @CB@\n" ++
  ".empty @OB@ color:var(--dim); text-align:center; margin-top:60px; @CB@\n"
end

function web_css_conversations(): text
  intent: return the css text for the sidebar conversation section header list items and new chat button
  "#conv-section @OB@ border-top:1px solid var(--border); display:flex; flex-direction:column; max-height:45%; @CB@\n" ++
  ".conv-header @OB@ display:flex; align-items:center; justify-content:space-between; padding:10px 12px 6px; font-size:11px; text-transform:uppercase; letter-spacing:.5px; color:var(--dim); @CB@\n" ++
  "button.new-conv @OB@ width:auto; padding:2px 9px; font-size:14px; line-height:1.2; @CB@\n" ++
  "#conv-list @OB@ flex:1; overflow-y:auto; padding:0 8px 8px; @CB@\n" ++
  ".conv-item @OB@ padding:7px 12px; border-radius:8px; cursor:pointer; margin-bottom:2px; border:1px solid transparent; font-size:12.5px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; @CB@\n" ++
  ".conv-item:hover @OB@ background:var(--panel2); @CB@\n" ++
  ".conv-item.active @OB@ background:var(--panel2); border-color:var(--accent); @CB@\n"
end

function web_css_tracker(): text
  intent: return the css text for the graphical token usage tracker gauge sparkline and label
  "#tokenbar @OB@ display:flex; align-items:center; gap:10px; margin-left:auto; @CB@\n" ++
  "#tokengauge @OB@ width:150px; height:10px; border-radius:5px; background:var(--panel2); border:1px solid var(--border); overflow:hidden; @CB@\n" ++
  "#tokenfill @OB@ height:100%; width:0%; background:linear-gradient(90deg,#2ecc71,#f1c40f,#e74c3c); transition:width .4s ease; @CB@\n" ++
  "#tokenspark @OB@ display:flex; align-items:flex-end; gap:1px; height:16px; @CB@\n" ++
  "#tokenspark div @OB@ width:3px; min-height:1px; background:var(--accent); border-radius:1px 1px 0 0; opacity:.85; @CB@\n" ++
  "#tokentext @OB@ font-size:11px; color:var(--dim); white-space:nowrap; @CB@\n"
end

function web_css_live(): text
  intent: return the css text for the live tool call chips rendered while a background turn runs
  "#livetools @OB@ margin-bottom:16px; max-width:880px; @CB@\n" ++
  "#livestatus @OB@ color:var(--dim); font-size:12px; margin-bottom:6px; @CB@\n" ++
  "details.toolcall.live @OB@ opacity:.96; @CB@\n" ++
  "details.toolcall.live.running summary @OB@ color:var(--accent); @CB@\n" ++
  ".tc-ok @OB@ display:inline-block; width:14px; color:#2ecc71; font-weight:700; @CB@\n" ++
  ".tc-label @OB@ margin-left:2px; @CB@\n"
end

function web_js_chunk_0(): text
  intent: return part 0 of the frontend script text rendering the graphical token usage tracker widget
  "let busy = false;\n" ++
  "function renderTokenUsage(u) @OB@\n" ++
  "  const fill = document.getElementById('tokenfill');\n" ++
  "  if (!u || !fill) return;\n" ++
  "  const budget = u.budget || 1;\n" ++
  "  const est = u.estimated || 0;\n" ++
  "  fill.style.width = Math.min(100, Math.round(est * 100 / budget)) + '%';\n" ++
  "  document.getElementById('tokentext').textContent = est + ' / ' + budget + ' ctx  |  in ' + (u.prompt || 0) + '  out ' + (u.completion || 0);\n" ++
  "  const spark = document.getElementById('tokenspark');\n" ++
  "  spark.innerHTML = '';\n" ++
  "  (u.history || []).slice(-24).forEach(v => @OB@ const d = document.createElement('div'); d.style.height = Math.max(1, Math.min(16, Math.round(v * 16 / budget))) + 'px'; spark.appendChild(d); @CB@);\n" ++
  "@CB@\n" ++
  "function renderConversations(s) @OB@\n" ++
  "  const aw = (s.workspaces || []).find(w => w.id === s.active);\n" ++
  "  const activeConvId = s.active_conversation || (aw && aw.active_conversation) || '';\n" ++
  "  const convList = document.getElementById('conv-list');\n" ++
  "  convList.innerHTML = '';\n" ++
  "  ((aw && aw.conversations) || []).forEach(c => @OB@\n" ++
  "    const d = document.createElement('div');\n" ++
  "    d.className = 'conv-item' + (c.id === activeConvId ? ' active' : '');\n" ++
  "    d.textContent = c.title || 'New conversation';\n" ++
  "    d.title = c.title || 'New conversation';\n" ++
  "    d.onclick = () => selectConversation(c.id);\n" ++
  "    convList.appendChild(d);\n" ++
  "  @CB@);\n" ++
  "  const ac = ((aw && aw.conversations) || []).find(c => c.id === activeConvId);\n" ++
  "  document.getElementById('ws-meta').textContent = (aw ? aw.root_dir + '  |  ' : '') + (ac ? (ac.title || 'New conversation') + '  |  ' : '') + s.model + ' @ ' + s.backend;\n" ++
  "@CB@\n"
end

function web_js_chunk_1(): text
  intent: return part 1 of the frontend script text covering fetch loadState renderMessages state and workspace chat

  "async function api(path, opts) @OB@ const r = await fetch(path, opts); return await r.json(); @CB@\n" ++
  "async function loadState() @OB@\n" ++
  "  const s = await api('/api/state');\n" ++
  "  const list = document.getElementById('ws-list');\n" ++
  "  list.innerHTML = '';\n" ++
  "  (s.workspaces || []).forEach(w => @OB@\n" ++
  "    const d = document.createElement('div');\n" ++
  "    d.className = 'ws-item' + (w.id === s.active ? ' active' : '');\n" ++
  "    const n = document.createElement('div'); n.className = 'ws-name'; n.textContent = w.name;\n" ++
  "    const dir = document.createElement('div'); dir.className = 'ws-dir'; dir.textContent = w.root_dir;\n" ++
  "    d.appendChild(n); d.appendChild(dir);\n" ++
  "    d.onclick = () => selectWorkspace(w.id);\n" ++
  "    list.appendChild(d);\n" ++
  "  @CB@);\n" ++
  "  const aw = (s.workspaces || []).find(w => w.id === s.active);\n" ++
  "  document.getElementById('ws-title').textContent = aw ? aw.name : 'legible-coder';\n" ++
  "  renderConversations(s);\n" ++
  "  renderTokenUsage(s.usage);\n" ++
  "@CB@\n" ++
  "function contentText(c) @OB@\n" ++
  "  if (typeof c === 'string') return c;\n" ++
  "  if (Array.isArray(c)) return c.filter(p => p && p.type === 'text').map(p => p.text).join('\\n');\n" ++
  "  return '';\n" ++
  "@CB@\n" ++
  "function renderMessages(msgs) @OB@\n" ++
  "  const chat = document.getElementById('chat');\n" ++
  "  chat.innerHTML = '';\n" ++
  "  if (msgs.length === 0) @OB@ chat.innerHTML = '<div class=empty>No messages yet. Ask something below.</div>'; return; @CB@\n" ++
  "  const toolById = @OB@@CB@;\n" ++
  "  msgs.forEach(m => @OB@ if (m.role === 'tool') toolById[m.tool_call_id] = m.content; @CB@);\n"
end

function web_js_chunk_2(): text
  intent: return part 2 of the frontend script text rendering msgs bubble tool_calls summary and contentText
  "  msgs.forEach(m => @OB@\n" ++
  "    const wrap = document.createElement('div');\n" ++
  "    if (m.role === 'user') @OB@\n" ++
  "      wrap.className = 'msg user';\n" ++
  "      const b = document.createElement('div'); b.className = 'bubble'; b.textContent = contentText(m.content);\n" ++
  "      wrap.appendChild(b);\n" ++
  "    @CB@ else if (m.role === 'assistant') @OB@\n" ++
  "      wrap.className = 'msg assistant';\n" ++
  "      if (m.tool_calls && m.tool_calls.length) @OB@\n" ++
  "        m.tool_calls.forEach(tc => @OB@\n" ++
  "          const f = tc.function || @OB@@CB@;\n" ++
  "          let argsPretty = f.arguments || '';\n" ++
  "          try @OB@ argsPretty = JSON.stringify(JSON.parse(f.arguments), null, 1); @CB@ catch (e) @OB@@CB@\n" ++
  "          const result = toolById[tc.id];\n" ++
  "          const det = document.createElement('details');\n" ++
  "          det.className = 'toolcall';\n" ++
  "          const sum = document.createElement('summary');\n" ++
  "          sum.textContent = 'tool: ' + (f.name || 'call');\n" ++
  "          det.appendChild(sum);\n" ++
  "          const body = document.createElement('pre');\n" ++
  "          body.textContent = argsPretty + (result !== undefined ? '\\n--- result ---\\n' + String(result).slice(0, 4000) : '');\n" ++
  "          det.appendChild(body);\n" ++
  "          wrap.appendChild(det);\n" ++
  "        @CB@);\n" ++
  "      @CB@\n" ++
  "      const txt = contentText(m.content);\n" ++
  "      if (txt.trim().length > 0) @OB@\n" ++
  "        const b = document.createElement('div');\n" ++
  "        b.className = 'bubble';\n" ++
  "        b.textContent = txt;\n"
end

function web_js_chunk_3(): text
  intent: return part 3 of the embedded frontend script with workspace chat and file panel logic
  "        wrap.appendChild(b);\n" ++
  "      @CB@\n" ++
  "    @CB@\n" ++
  "    if (wrap.children.length) chat.appendChild(wrap);\n" ++
  "  @CB@);\n" ++
  "  chat.scrollTop = chat.scrollHeight;\n" ++
  "@CB@\n" ++
  "async function loadMessages() @OB@\n" ++
  "  const s = await api('/api/messages');\n" ++
  "  renderMessages(s.messages || []);\n" ++
  "@CB@\n" ++
  "async function selectWorkspace(id) @OB@\n" ++
  "  const res = await api('/api/select', @OB@method:'POST', headers:@OB@'content-type':'application/json'@CB@, body: JSON.stringify(@OB@id: id@CB@)@CB@);\n" ++
  "  if (res.error) @OB@ alert(res.error); return; @CB@\n" ++
  "  await loadState(); await loadMessages(); loadFiles();\n" ++
  "@CB@\n" ++
  "async function createWorkspace() @OB@\n" ++
  "  const name = document.getElementById('ws-name').value.trim();\n" ++
  "  const dir = document.getElementById('ws-dir').value.trim();\n" ++
  "  const res = await api('/api/workspaces', @OB@method:'POST', headers:@OB@'content-type':'application/json'@CB@, body: JSON.stringify(@OB@name: name, root_dir: dir@CB@)@CB@);\n" ++
  "  if (res.error) @OB@ alert(res.error); return; @CB@\n" ++
  "  document.getElementById('ws-name').value = '';\n" ++
  "  document.getElementById('ws-dir').value = '';\n" ++
  "  await loadState(); await loadMessages(); loadFiles();\n" ++
  "@CB@\n" ++
  "async function selectConversation(id) @OB@\n" ++
  "  const res = await api('/api/select-conversation', @OB@method:'POST', headers:@OB@'content-type':'application/json'@CB@, body: JSON.stringify(@OB@id: id@CB@)@CB@);\n" ++
  "  if (res.error) @OB@ alert(res.error); return; @CB@\n" ++
  "  await loadState(); await loadMessages();\n" ++
  "@CB@\n" ++
  "async function createConversation() @OB@\n" ++
  "  const res = await api('/api/conversations', @OB@method:'POST', headers:@OB@'content-type':'application/json'@CB@, body: JSON.stringify(@OB@@CB@)@CB@);\n" ++
  "  if (res.error) @OB@ alert(res.error); return; @CB@\n" ++
  "  await loadState(); await loadMessages();\n" ++
  "@CB@\n" ++
  "async function loadFiles() @OB@\n" ++
  "  const s = await api('/api/files');\n" ++
  "  const list = document.getElementById('file-list');\n" ++
  "  list.innerHTML = '';\n" ++
  "  (s.files || []).forEach(f => @OB@ const d = document.createElement('div'); d.textContent = f; d.title = f; list.appendChild(d); @CB@);\n"
end

function web_js_live(): text
  intent: return the frontend script part with the live tool event poller and its chip rendering helpers
  "let evTimer = null;\n" ++
  "let evBusy = false;\n" ++
  "let evDone = false;\n" ++
  "let evErrors = 0;\n" ++
  "let evCursor = 0;\n" ++
  "let liveBox = null;\n" ++
  "let liveStatus = null;\n" ++
  "let liveChips = @OB@@CB@;\n" ++
  "let liveWs = '';\n" ++
  "let liveConv = '';\n" ++
  "function scrollChat() @OB@ const c = document.getElementById('chat'); c.scrollTop = c.scrollHeight; @CB@\n" ++
  "function prettyArgs(a) @OB@ try @OB@ return JSON.stringify(JSON.parse(a), null, 1); @CB@ catch (e) @OB@ return String(a || ''); @CB@ @CB@\n" ++
  "function stopLive() @OB@\n" ++
  "  if (evTimer) @OB@ clearInterval(evTimer); evTimer = null; @CB@\n" ++
  "  evBusy = false; evDone = false; evErrors = 0;\n" ++
  "  if (liveBox && liveBox.parentNode) @OB@ liveBox.parentNode.removeChild(liveBox); @CB@\n" ++
  "  liveBox = null; liveStatus = null; liveChips = @OB@@CB@;\n" ++
  "@CB@\n" ++
  "function startLive() @OB@\n" ++
  "  stopLive();\n" ++
  "  const chat = document.getElementById('chat');\n" ++
  "  liveBox = document.createElement('div');\n" ++
  "  liveBox.id = 'livetools';\n" ++
  "  liveStatus = document.createElement('div');\n" ++
  "  liveStatus.id = 'livestatus';\n" ++
  "  liveStatus.innerHTML = '<span class=spinner></span> working...';\n" ++
  "  liveBox.appendChild(liveStatus);\n" ++
  "  chat.appendChild(liveBox);\n" ++
  "  evCursor = 0;\n" ++
  "  evDone = false; evBusy = false; evErrors = 0;\n" ++
  "  scrollChat();\n" ++
  "@CB@\n"
end

function web_js_live_chip(): text
  intent: return the frontend script part that appends a running tool chip and flips it to done with its result
  "function addChip(ev) @OB@\n" ++
  "  if (!liveBox) return;\n" ++
  "  const det = document.createElement('details');\n" ++
  "  det.className = 'toolcall live running';\n" ++
  "  det.open = true;\n" ++
  "  const sum = document.createElement('summary');\n" ++
  "  sum.innerHTML = '<span class=spinner></span><span class=tc-label></span>';\n" ++
  "  sum.querySelector('.tc-label').textContent = ev.label || ev.name || 'tool';\n" ++
  "  det.appendChild(sum);\n" ++
  "  const pre = document.createElement('pre');\n" ++
  "  pre.textContent = prettyArgs(ev.arguments);\n" ++
  "  det.appendChild(pre);\n" ++
  "  liveBox.appendChild(det);\n" ++
  "  liveChips[ev.n] = det;\n" ++
  "  const count = liveBox.querySelectorAll('details.toolcall').length;\n" ++
  "  liveStatus.innerHTML = '<span class=spinner></span> running tool ' + count + '...';\n" ++
  "@CB@\n" ++
  "function closeChip(ev) @OB@\n" ++
  "  if (!liveBox) return;\n" ++
  "  const det = liveChips[ev.n];\n" ++
  "  if (!det) return;\n" ++
  "  det.classList.remove('running');\n" ++
  "  det.open = false;\n" ++
  "  const sp = det.querySelector('summary .spinner');\n" ++
  "  if (sp) @OB@ sp.outerHTML = '<span class=tc-ok>ok</span>'; @CB@\n" ++
  "  const pre = det.querySelector('pre');\n" ++
  "  if (pre && ev.result) @OB@ pre.textContent = pre.textContent + '\\n--- result ---\\n' + String(ev.result).slice(0, 3000); @CB@\n" ++
  "  liveStatus.innerHTML = '<span class=spinner></span> thinking...';\n" ++
  "@CB@\n"
end

function web_js_live_finish(): text
  intent: return the frontend script part with unlockInput and the evDone guarded finishTurn
  "function unlockInput() @OB@\n" ++
  "  busy = false;\n" ++
  "  const btn = document.getElementById('sendbtn');\n" ++
  "  btn.disabled = false;\n" ++
  "  btn.innerHTML = '';\n" ++
  "  btn.textContent = 'Send';\n" ++
  "  document.getElementById('input').focus();\n" ++
  "@CB@\n" ++
  "async function finishTurn(note) @OB@\n" ++
  "  if (evDone) return;\n" ++
  "  evDone = true;\n" ++
  "  stopLive();\n" ++
  "  try @OB@\n" ++
  "    const m = await api('/api/messages');\n" ++
  "    renderMessages(m.messages || []);\n" ++
  "    await loadState();\n" ++
  "  @CB@ catch (e) @OB@@CB@\n" ++
  "  if (note) @OB@\n" ++
  "    const chat = document.getElementById('chat');\n" ++
  "    const w = document.createElement('div');\n" ++
  "    w.className = 'msg assistant';\n" ++
  "    w.innerHTML = '<div class=bubble></div>';\n" ++
  "    w.querySelector('.bubble').textContent = note;\n" ++
  "    chat.appendChild(w);\n" ++
  "    scrollChat();\n" ++
  "  @CB@\n" ++
  "  unlockInput();\n" ++
  "@CB@\n"
end

function web_js_live_poll(): text
  intent: return the guarded single flight pollEvents script text plus startPolling
  "async function pollEvents() @OB@\n" ++
  "  if (evBusy || evDone) return;\n" ++
  "  evBusy = true;\n" ++
  "  let res;\n" ++
  "  try @OB@\n" ++
  "    res = await api('/api/events?since=' + evCursor + '&ws=' + encodeURIComponent(liveWs) + '&conv=' + encodeURIComponent(liveConv));\n" ++
  "    evErrors = 0;\n" ++
  "  @CB@ catch (e) @OB@\n" ++
  "    evBusy = false;\n" ++
  "    evErrors += 1;\n" ++
  "    if (evErrors > 20) await finishTurn('Lost contact with the server while streaming tool calls.');\n" ++
  "    return;\n" ++
  "  @CB@\n" ++
  "  evBusy = false;\n" ++
  "  if (evDone) return;\n" ++
  "  evCursor = (typeof res.next === 'number') ? res.next : evCursor;\n" ++
  "  let note = '';\n" ++
  "  let ended = false;\n" ++
  "  (res.events || []).forEach(ev => @OB@\n" ++
  "    if (ev.type === 'tool_start') @OB@ addChip(ev); @CB@\n" ++
  "    else if (ev.type === 'tool_end') @OB@ closeChip(ev); @CB@\n" ++
  "    else if (ev.type === 'error') @OB@ note = ev.text || 'turn failed'; @CB@\n" ++
  "    else if (ev.type === 'done') @OB@ ended = true; @CB@\n" ++
  "    else if (ev.type === 'model' && liveStatus) @OB@ liveStatus.innerHTML = '<span class=spinner></span> ' + (ev.model || '') + ' working...'; @CB@\n" ++
  "    else @OB@@CB@\n" ++
  "  @CB@);\n" ++
  "  scrollChat();\n" ++
  "  if (note.length > 0 || ended || res.running === false) @OB@ await finishTurn(note); @CB@\n" ++
  "@CB@\n" ++
  "function startPolling() @OB@ if (!evTimer) @OB@ evTimer = setInterval(pollEvents, 600); @CB@ @CB@\n"
end

function web_js_chunk_4(): text
  intent: return the js text with toggleFiles send startPolling and the input keydown listener
  "@CB@\n" ++
  "function toggleFiles() @OB@\n" ++
  "  const p = document.getElementById('filepanel');\n" ++
  "  p.classList.toggle('open');\n" ++
  "  if (p.classList.contains('open')) loadFiles();\n" ++
  "@CB@\n" ++
  "async function send() @OB@\n" ++
  "  if (busy) return;\n" ++
  "  const input = document.getElementById('input');\n" ++
  "  const text = input.value.trim();\n" ++
  "  if (text.length === 0) return;\n" ++
  "  busy = true;\n" ++
  "  input.value = '';\n" ++
  "  const btn = document.getElementById('sendbtn');\n" ++
  "  btn.disabled = true;\n" ++
  "  btn.innerHTML = '<span class=spinner></span>';\n" ++
  "  try @OB@\n" ++
  "    const res = await api('/api/send', @OB@method:'POST', headers:@OB@'content-type':'application/json'@CB@, body: JSON.stringify(@OB@text: text@CB@)@CB@);\n" ++
  "    if (res.error) @OB@ await finishTurn(res.error); return; @CB@\n" ++
  "    liveWs = res.ws || '';\n" ++
  "    liveConv = res.conv || '';\n" ++
  "    renderMessages(res.messages || []);\n" ++
  "    scrollChat();\n" ++
  "    startLive();\n" ++
  "    startPolling();\n" ++
  "  @CB@ catch (e) @OB@\n" ++
  "    await finishTurn('Request failed: ' + e);\n" ++
  "  @CB@\n" ++
  "@CB@\n" ++
  "document.getElementById('input').addEventListener('keydown', e => @OB@\n" ++
  "  if (e.key === 'Enter' && !e.shiftKey) @OB@ e.preventDefault(); send(); @CB@\n" ++
  "@CB@);\n" ++
  "loadState().then(() => loadMessages());\n"
end

function web_js(): text
  intent: concatenate the web_js chunk parts and the live tool poller into the full frontend script
  web_js_chunk_0() ++
  web_js_chunk_1() ++
  web_js_chunk_2() ++
  web_js_chunk_3() ++
  web_js_live() ++
  web_js_live_chip() ++
  web_js_live_finish() ++
  web_js_live_poll() ++
  web_js_chunk_4()
end
function web_braces(templated: text): text
  intent: replace the ob and cb tokens in templated text with real brace characters
  replace(replace(templated, "@OB@", "\{"), "@CB@", "\}")
end

function web_index_html(): text
  intent: build the index html document from web_css web_js and web_braces parts
  "<!doctype html>\n<html>\n<head>\n<meta charset='utf-8'>\n<title>legible-coder</title>\n<style>\n" ++
  web_braces(web_css() ++ web_css_conversations() ++ web_css_tracker() ++ web_css_live()) ++
  "</style>\n</head>\n<body>\n" ++
  web_braces("<div id='sidebar'>\n" ++
  "<div class='brand'>legible-<span>coder</span></div>\n" ++
  "<div id='ws-list'></div>\n" ++
  "<div id='conv-section'>\n" ++
  "<div class='conv-header'><span>Conversations</span><button class='new-conv' onclick='createConversation()' title='New conversation'>+</button></div>\n" ++
  "<div id='conv-list'></div>\n" ++
  "</div>\n" ++
  "<div class='new-ws'>\n" ++
  "<input id='ws-name' placeholder='workspace name'>\n" ++
  "<input id='ws-dir' placeholder='root directory (optional)'>\n" ++
  "<button onclick='createWorkspace()'>New workspace</button>\n" ++
  "</div>\n</div>\n" ++
  "<div id='main'>\n" ++
  "<div id='topbar'>\n" ++
  "<div class='title' id='ws-title'>legible-coder</div>\n" ++
  "<div class='meta' id='ws-meta'></div>\n" ++
   "<div id='tokenbar'><div id='tokenspark'></div><div id='tokengauge'><div id='tokenfill'></div></div><span id='tokentext'></span></div>\n" ++
  "<button class='secondary' style='width:auto' onclick='toggleFiles()'>Files</button>\n" ++
  "</div>\n" ++
  "<div id='chat'><div class='empty'>Loading...</div></div>\n" ++
  "<div id='inputbar'>\n" ++
  "<textarea id='input' placeholder='Ask legible-coder... (Enter to send, Shift+Enter for newline)'></textarea>\n" ++
  "<button id='sendbtn' onclick='send()'>Send</button>\n" ++
  "</div>\n</div>\n" ++
  "<div id='filepanel'>\n" ++
  "<div class='head'><span>Workspace files</span><span style='cursor:pointer' onclick='toggleFiles()'>x</span></div>\n" ++
  "<div id='file-list'></div>\n" ++
  "</div>\n<script>\n") ++
  web_braces(web_js()) ++
  "</script>\n</body>\n</html>\n"
end

function route_web_request(request: Request, init_messages: a list of a mapping from text to text, providers: a list of a mapping from text to text, max_tools: integer, include_tools: boolean, include_dir_tools: boolean, include_vision: boolean): nothing
  intent: dispatch one HTTP request to the web GUI routes for pages state messages files live events and turns
  let primary: a mapping from text to text = get(providers, 0)
  let model: text = get(primary, "full")
  let base_url: text = get(primary, "url")
  if request.method == "GET" and request.path == "/" then
    web_respond_html(web_index_html())
  else if request.method == "GET" and request.path == "/api/state" then
    web_handle_state(model, base_url)
  else if request.method == "GET" and request.path == "/api/messages" then
    web_handle_messages(init_messages)
  else if request.method == "GET" and request.path == "/api/files" then
    web_handle_files()
  else if request.method == "GET" and request.path == "/api/events" then
    web_handle_events(request.query)
  else if request.method == "POST" and request.path == "/api/workspaces" then
    web_handle_create(request.body, model, base_url)
  else if request.method == "POST" and request.path == "/api/select" then
    web_handle_select(request.body, model, base_url)
  else if request.method == "POST" and request.path == "/api/conversations" then
    web_handle_create_conversation(request.body, model, base_url)
  else if request.method == "POST" and request.path == "/api/select-conversation" then
    web_handle_select_conversation(request.body, model, base_url)
  else if request.method == "POST" and request.path == "/api/send" then
    web_handle_send(request.body, init_messages, providers, max_tools, include_tools, include_dir_tools, include_vision)
  else
    web_respond_json(404, web_json_error("not found: " ++ request.path))
  end
end

function run_web_server(init_messages: a list of a mapping from text to text, providers: a list of a mapping from text to text, max_tools: integer, include_tools: boolean, include_dir_tools: boolean, include_vision: boolean): nothing
  intent: start the HTTP server chdir into the active workspace and serve the web GUI until interrupted
  let reg: a mapping from text to text = web_ensure_registry()
  let ws: a mapping from text to text = web_active_workspace(reg)
  let root_dir: text = unwrap_or(get(ws, "root_dir"), get_cwd())
  if is_dir(root_dir) then
    chdir(root_dir)
  else
    skip()
  end
  let port: integer = web_port()
  http_start(port)
  print("")
  print("  Web GUI ready:  http://localhost:" ++ to_text(port))
  print("  Workspace:      " ++ unwrap_or(get(ws, "name"), "") ++ " (" ++ get_cwd() ++ ")")
  print("  Stop the server with Ctrl-C.")
  while true do
    let request: Request = http_next_request()
    route_web_request(request, init_messages, providers, max_tools, include_tools, include_dir_tools, include_vision)
  end
end

-- --- Background turn worker (lets the serial web server stream tool calls) ---

function web_absolute_script(script: text): text
  intent: return script when starts_with slash else readlink the shell_quote cwd path
  if starts_with(script, "/") then
    script
  else
    let server_cwd: text = trim(get(shell_exec("readlink -f /proc/$PPID/cwd"), "stdout"))
    let resolved: text = trim(get(shell_exec("readlink -f " ++ shell_quote(server_cwd ++ "/" ++ script)), "stdout"))
    if text_length(resolved) > 0 then resolved else server_cwd ++ "/" ++ script end
  end
end

function web_worker_launcher(): a list of text
  intent: return the interpreter and the absolute lbl script path of the running server read from the parent process command line
  let raw: text = trim(get(shell_exec("tr '\\0' ' ' < /proc/$PPID/cmdline"), "stdout"))
  let parts: a list of text = filter(split(raw, " "), fn(p: text): boolean => text_length(p) > 0)
  let scripts: a list of text = filter(parts, fn(p: text): boolean => ends_with(p, ".lbl"))
  if length(parts) >= 1 and length(scripts) > 0 then
    [get(parts, 0), web_absolute_script(get(scripts, 0))]
  else
    []
  end
end

function web_worker_launch_prefix(): text
  intent: return shell_quote of the web_worker_launcher parts joined with run when length allows
  let parts: a list of text = web_worker_launcher()
  if length(parts) < 2 then
    ""
  else
    shell_quote(get(parts, 0)) ++ " run " ++ shell_quote(get(parts, 1))
  end
end

function web_worker_spawn_cmd(prefix: text, ws_id: text, conv_id: text, user_text: text, work_dir: text, events_path: text): text
  intent: build a detached setsid nohup command exporting the turn context with no stdin and its own log file
  "cd " ++ shell_quote(work_dir) ++ " && " ++
  "LEGIBLE_CODER_WS_ID=" ++ shell_quote(ws_id) ++ " " ++
  "LEGIBLE_CODER_CONV_ID=" ++ shell_quote(conv_id) ++ " " ++
  "LEGIBLE_CODER_USER_TEXT=" ++ shell_quote(user_text) ++ " " ++
  "LEGIBLE_CODER_WORKDIR=" ++ shell_quote(work_dir) ++ " " ++
  "LEGIBLE_CODER_EVENTS_PATH=" ++ shell_quote(events_path) ++ " " ++
  "setsid nohup " ++ prefix ++ " --turn </dev/null > " ++ shell_quote(web_worker_log_path(ws_id, conv_id)) ++ " 2>&1 &"
end

function web_title_conversation(ws_id: text, conv_id: text, user_text: text): nothing
  intent: give the matching still untitled conversation of the given workspace a title derived from the user text
  let reg: a mapping from text to text = web_ensure_registry()
  let found_ws: an optional a mapping from text to text = web_find_workspace(reg, ws_id)
  if is_none(found_ws) then
    skip()
  else
    let ws: a mapping from text to text = unwrap(found_ws)
    let found_conv: an optional a mapping from text to text = web_find_conversation(ws, conv_id)
    if is_none(found_conv) then
      skip()
    else
      let conv: a mapping from text to text = unwrap(found_conv)
      if unwrap_or(get(conv, "title"), "") == "New conversation" then
        let titled_conv: a mapping from text to text = put(conv, "title", web_conversation_title_from(user_text))
        web_save_registry(web_replace_workspace(reg, put(ws, "conversations", map(web_workspace_conversations(ws), fn(c: a mapping from text to text): a mapping from text to text => if unwrap_or(get(c, "id"), "") == conv_id then titled_conv else c end))))
      else
        skip()
      end
    end
  end
end

function run_web_turn(ws_id: text, conv_id: text, user_text: text, work_dir: text): nothing
  intent: run one turn on the already saved transcript then persist it with its title usage and done event
  if is_dir(work_dir) then
    chdir(work_dir)
  else
    skip()
  end
  let providers: a list of a mapping from text to text = build_provider_list()
  let primary: a mapping from text to text = get(providers, 0)
  let tier: text = provider_tier(get(primary, "url"))
  let is_local: boolean = tier == "local"
  let include_tools: boolean = not is_local or resolve_local_native_tools(get(primary, "full"))
  let include_dir_tools: boolean = include_tools
  let max_tools: integer = resolve_max_tools(tier)
  let include_vision: boolean = include_tools and resolve_include_vision(get(primary, "full"))
  let sys_prompt: text = if is_local and not include_tools then local_system_prompt() else system_prompt(include_tools, include_dir_tools, include_vision) end
  let init_messages: a list of a mapping from text to text = initial_messages(is_local, sys_prompt)
  mutable msgs: a list of a mapping from text to text = web_load_session(ws_id, conv_id, init_messages)
  let start: integer = length(msgs)
  web_event_emit({"type": "model", "model": get(primary, "full"), "backend": backend_name(get(primary, "url"))})
  if any_provider_reachable(providers) then
    let turn: TurnResult = run_turn_with_fallback(msgs, user_text, start, providers, max_tools, include_tools, include_dir_tools, include_vision, true)
    set msgs = turn.messages
    web_add_usage(turn.inner.prompt_tokens, turn.inner.completion_tokens, turn.inner.context_budget)
    web_event_emit({"type": "usage", "prompt": to_text(turn.inner.prompt_tokens), "completion": to_text(turn.inner.completion_tokens)})
  else
    set msgs = append(msgs, {"role": "assistant", "content": "Error: no model provider is reachable. Check your API keys and network connection, then try again."})
    web_event_emit({"type": "final", "text": "Error: no model provider is reachable. Check your API keys and network connection, then try again."})
  end
  web_save_session(ws_id, conv_id, msgs)
  web_title_conversation(ws_id, conv_id, user_text)
  web_turn_lock_release(ws_id, conv_id)
  web_event_emit({"type": "done"})
end

function run_worker_turn(): nothing
  intent: stamp the lock with this pid then run the env named turn and release the lock when it ends
  web_worker_stamp_own_pid()
  run_web_turn(unwrap_or(env_get("LEGIBLE_CODER_WS_ID"), ""), unwrap_or(env_get("LEGIBLE_CODER_CONV_ID"), ""), unwrap_or(env_get("LEGIBLE_CODER_USER_TEXT"), ""), unwrap_or(env_get("LEGIBLE_CODER_WORKDIR"), get_cwd()))
  web_worker_lock_release()
end

function main(): nothing
  intent: run a background worker turn or build the provider list and start the REPL or web server
  if contains_text(" " ++ join(get_args(), " ") ++ " ", "--turn") then
    run_worker_turn()
    exit_process(0)
  end
  let providers: a list of a mapping from text to text = build_provider_list()
  let primary: a mapping from text to text = get(providers, 0)
  let primary_url: text = get(primary, "url")
  let primary_model: text = get(primary, "full")
  let tier: text = provider_tier(primary_url)
  let is_local: boolean = tier == "local"
  let include_tools: boolean = not is_local or resolve_local_native_tools(primary_model)
  let include_dir_tools: boolean = include_tools
  let max_tools: integer = resolve_max_tools(tier)
  let include_vision: boolean = include_tools and resolve_include_vision(primary_model)
  print_banner(primary_model, primary_url)
  if length(providers) > 1 then
    print("  Fallbacks: " ++ join(drop(provider_name_list(providers), 1), " -> "))
  end
  print_local_tool_mode(is_local, include_tools)
  let sys_prompt: text = if is_local and not include_tools then local_system_prompt() else system_prompt(include_tools, include_dir_tools, include_vision) end
  let messages: a list of a mapping from text to text = initial_messages(is_local, sys_prompt)
  if web_mode_requested() then
    run_web_server(messages, providers, max_tools, include_tools, include_dir_tools, include_vision)
  else
    run_repl(messages, providers, max_tools, include_tools, include_dir_tools, include_vision)
  end
end
