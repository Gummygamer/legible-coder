#!/usr/bin/env bash
set -e

SCRIPT="$(readlink -f "${BASH_SOURCE[0]}")"
DIR="$(dirname "$SCRIPT")"
NANO_REPO="${LEGIBLE_NANO_REPO:-$DIR/../Legible-Nano}"
NANO_PY="$NANO_REPO/.venv/bin/python"

if [ -x "$NANO_PY" ]; then
  exec "$NANO_PY" "$DIR/legible_nano_server.py" "$@"
fi

exec python3 "$DIR/legible_nano_server.py" "$@"
